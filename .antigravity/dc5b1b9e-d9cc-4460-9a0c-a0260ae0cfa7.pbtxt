          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                <strong>Subject:</strong> RFQ: Trade2Turkey - {currentRfq.productName} Co-op <br/>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                <strong>Body:</strong> <br/>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                Dear Ottoman / Anatolian Sourcing Partner,<br/>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                Hope this message finds you well.<br/><br/>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                Trade2Turkey is sourcing high-quality products for an overseas client. We demand direct EXW Turkish Lira or Euro pricing with strict compliance matching <strong>REACH and fire safety certification</strong> rules.<br/><br/>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
