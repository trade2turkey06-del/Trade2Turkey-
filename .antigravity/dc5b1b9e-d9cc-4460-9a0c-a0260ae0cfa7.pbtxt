      target_content: "        {/* =======================================================\n            6. COSTING OF MATERIALS IN RECIPE & WASTAGES (A.B.9)\n           ======================================================= */}\n        {sheetKey === \"costing-materials-recipe\" && (\n          <div className=\"space-y-6\">\n            <div className=\"bg-slate-900 p-6 rounded-xl text-white divide-y divide-slate-800\">\n              <div className=\"pb-4 flex justify-between items-center\">\n                <div>\n                  <h4 className=\"text-base font-bold text-orange-400 font-display\">Granular Sourcing Recipes Costing</h4>\n                  <p className=\"text-xs text-slate-400\">Ingredient breakdown showing waste-adjusted effective EXW cost</p>\n                </div>\n                <div className=\"text-right\">\n                  <div className=\"text-[10px] text-slate-400 font-mono\">CALCULATED RECIPE TOTAL EXW</div>\n                  <div className=\"text-2xl font-black text-white font-mono\">${recipeMetrics.grandTotal.toFixed(2)}</div>\n                </div>\n              </div>\n\n              {/* Dynamic Table displaying raw vs waste costs */}\n              <div className=\"py-4 overflow-x-auto\">\n                <table className=\"w-full text-left text-xs font-mono\">\n                  <thead>\n                    <tr className=\"text-slate-400 border-b border-slate-800 text-[10px] font-bold\">\n                      <th className=\"pb-2\">Ingredient Material</th>\n                      <th className=\"pb-2 text-right\">Base Raw Cost</th>\n                      <th className=\"pb-2 text-right\">Scrap Factor</th>\n                      <th className=\"pb-2 text-right\">Wastage Cost</th>\n                      <th className=\"pb-2 text-right text-orange-400\">Effective Cost (Adjusted)</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-slate-850\">\n                    {currentRecipe?.materials.map(mat => {\n                      const baseRaw = mat.qtyRequired * mat.unitCostUsd;\n                      const waste = baseRaw * (mat.scrapRatePercent / 100);\n                      const adjusted = baseRaw + waste;\n                      return (\n                        <tr key={mat.id} className=\"text-slate-200\">\n                          <td className=\"py-2.5 font-sans font-medium\">{mat.name}</td>\n                          <td className=\"py-2.5 text-right\">${baseRaw.toFixed(2)}</td>\n                          <td className=\"py-2.5 text-right text-red-400\">+{mat.scrapRatePercent}%</td>\n                          <td className=\"py-2.5 text-right text-slate-500\">${waste.toFixed(3)}</td>\n                          <td className=\"py-2.5 text-right text-orange-300 font-bold\">${adjusted.toFixed(2)}</td>\n                        </tr>\n                      );\n                    })}\n                  </tbody>\n                </table>\n              </div>"
