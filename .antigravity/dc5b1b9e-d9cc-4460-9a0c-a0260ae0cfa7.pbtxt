    replacement_infos {
      original_chunk {
        target_content: "  // Drag and Drop simulation\n  const handleDrag = (e: React.DragEvent) => {\n    e.preventDefault();\n    e.stopPropagation();\n    if (e.type === \"dragenter\" || e.type === \"dragover\") {\n      setDragActive(true);\n    } else if (e.type === \"dragleave\") {\n      setDragActive(false);\n    }\n  };\n\n  const handleDrop = (e: React.DragEvent) => {\n    e.preventDefault();\n    e.stopPropagation();\n    setDragActive(false);\n\n    if (e.dataTransfer.files && e.dataTransfer.files[0]) {\n      const droppedFile = e.dataTransfer.files[0];\n      const detectedType: DriveFile[\"fileType\"] = droppedFile.name.endsWith(\".xls\") || droppedFile.name.endsWith(\".xlsx\") \n        ? \"RFQ Sheet\" \n        : droppedFile.name.endsWith(\".png\") || droppedFile.name.endsWith(\".jpg\") || droppedFile.name.endsWith(\".jpeg\")\n          ? \"Photoshoot Proof\"\n          : \"PDF\";\n      handleAddFile(droppedFile.name, detectedType);\n    }\n  };\n\n  const handleDeleteFile = (fileName: string) => {\n    const updated = files.filter(f => !(f.stepId === stepId && f.fileName === fileName));\n    setFiles(updated);\n    localStorage.setItem(\"t2t_clouddrive_files\", JSON.stringify(updated));\n  };\n\n  return (\n    <div className=\"bg-slate-50 rounded-xl border border-slate-200 overflow-hidden shadow-sm mt-3 animate-fadeIn\">\n      {/* Dynamic API Bar */}\n      <div className=\"bg-slate-900 px-4 py-2.5 flex items-center justify-between text-white border-b border-slate-800 text-xs\">\n        <div className=\"flex items-center gap-2\">\n          <div className=\"h-2 w-2 rounded-full bg-emerald-500 animate-pulse\" />\n          <span className=\"font-mono text-[11px] font-semibold text-slate-300\">\n            GOOGLE-DRIVE-API v3 // CONNECTED\n          </span>\n          <span className=\"text-slate-700 hidden sm:inline\">|</span>\n          <span className=\"text-slate-400 text-[10px] hidden sm:inline font-mono\">\n            Location Mapping: {PROJECT_NAMES[currentProjectId] || \"All Accounts\"}\n          </span>\n        </div>\n        \n        <button\n          onClick={handleSyncDrive}\n          id=\"btn-sync-folder\"\n          className=\"flex items-center gap-1.5 px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 hover:text-white transition cursor-pointer text-[10px] font-semibold text-slate-300\"\n          disabled={isSyncing}\n        >\n          <RefreshCw className={`h-3 w-3 ${isSyncing ? \"animate-spin text-teal-400\" : \"\"}`} />\n          {isSyncing ? \"Syncing...\" : \"Sync Cloud\"}\n        </button>\n      </div>\n\n      <div className=\"p-4 sm:p-5\">\n        {/* Storage Title Info */}\n        <div className=\"flex justify-between items-start gap-4 mb-4 pb-3 border-b border-slate-100\">\n          <div className=\"flex items-start gap-2.5\">\n            <div className=\"p-2 bg-blue-50 text-blue-600 rounded-lg shrink-0\">\n              <Folder className=\"h-5 w-5\" />\n            </div>\n            <div>\n              <div className=\"text-[10px] text-slate-400 uppercase font-mono font-bold\">\n                Designated Cloud Storage Path (CSV Designated Column)\n              </div>\n              <h4 className=\"text-sm font-bold text-slate-800 font-display flex items-center gap-1.5 mt-0.5\">\n                {storageLocation || \"SOP Default Documents Storage\"}\n              </h4>\n            </div>\n          </div>\n\n          <div className=\"text-right\">\n            <span className=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-blue-50 border border-blue-100 text-blue-700\">\n              <ShieldCheck className=\"h-3 w-3\" />\n              {clientMode ? \"Client Sandbox Access\" : \"Admin Master Credentials\"}\n            </span>\n          </div>\n        </div>\n\n        {/* Security / Non-compliance Banner */}\n        {clientMode && (\n          <div className=\"mb-4 bg-teal-50/70 border border-teal-100 rounded-xl p-3 text-xs text-teal-800 flex gap-2\">\n            <ShieldCheck className=\"h-4 w-4 text-teal-600 shrink-0 mt-0.5\" />\n            <div>\n              <span className=\"font-bold\">Confined Client View Clearance: </span>\n              In order to protect industrial design secrets and competitor pricing strategies, you are locked into project ID <strong className=\"font-mono\">{currentProjectId}</strong>. This folder isolates client-relevant compliance checks, ATR custom passes, photoshoot proofing documents, and certificated logs under 256-bit encryption. Actionable uploads and deletion parameters are locked.\n            </div>\n          </div>\n        )}\n\n        {/* Search Bar / Filters */}\n        <div className=\"mb-4\">\n          <input\n            type=\"text\"\n            placeholder=\"\360\237\224\215 Search files inside this Drive folder path...\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            className=\"w-full text-xs p-2 rounded-lg border border-slate-200 bg-white placeholder-slate-400 focus:outline-none focus:border-blue-500 font-medium\"\n          />\n        </div>\n\n        {/* Files Grid and Table */}\n        <div className=\"space-y-2\">\n          {displayedFiles.length > 0 ? (\n            <div className=\"bg-white border border-slate-150 rounded-xl divide-y divide-slate-100 overflow-hidden\">\n              {displayedFiles.map(file => (\n                <div \n                  key={file.fileName}\n                  className=\"flex items-center justify-between p-3.5 hover:bg-slate-50/50 transition text-xs\"\n                >\n                  <div className=\"flex items-center gap-3 min-w-0 mr-4\">\n                    <span className={`p-2 rounded-lg ${\n                      file.fileType === \"PDF\" ? \"bg-red-50 text-red-600\" :\n                      file.fileType === \"RFQ Sheet\" ? \"bg-emerald-50 text-emerald-600\" :\n                      file.fileType === \"Photoshoot Proof\" ? \"bg-purple-50 text-purple-600\" :\n                      file.fileType === \"Certificate\" ? \"bg-blue-50 text-blue-600\" :\n                      \"bg-slate-50 text-slate-600\"\n                    }`}>\n                      <FileText className=\"h-4.5 w-4.5 shrink-0\" />\n                    </span>\n                    <div className=\"min-w-0\">\n                      <div className=\"font-semibold text-slate-800 truncate\" title={file.fileName}>\n                        {file.fileName}\n                      </div>\n                      <div className=\"flex flex-wrap gap-2 text-[10px] text-slate-400 font-mono mt-0.5\">\n                        <span>{file.fileType}</span>\n                        <span>\342\200\242</span>\n                        <span>Size: {file.fileSize}</span>\n                        <span>\342\200\242</span>\n                        <span>Project: {file.projectId}</span>\n                        <span>\342\200\242</span>\n                        <span>Added: {file.dateAdded}</span>\n                      </div>\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center gap-2 shrink-0\">\n                    <button\n                      onClick={() => alert(`Downloading Cloud document: ${file.fileName} directly from integrated secure server.`)}\n                      className=\"inline-flex items-center gap-1 py-1.5 px-3 rounded-lg bg-slate-50 border border-slate-200 hover:bg-slate-100 text-slate-700 hover:text-slate-900 transition font-bold text-[11px] cursor-pointer\"\n                    >\n                      <Download className=\"h-3 w-3\" />\n                      Get\n                    </button>\n\n                    {/* Deletion parameters for Admin Sourcing workspace */}\n                    {!clientMode && (\n                      <button\n                        onClick={() => handleDeleteFile(file.fileName)}\n                        className=\"p-1.5 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition shrink-0 cursor-pointer\"\n                        title=\"Delete from remote storage\"\n                      >\n                        <Trash2 className=\"h-4 w-4\" />\n                      </button>\n                    )}\n                  </div>\n                </div>\n              ))}\n            </div>\n          ) : (\n            <div className=\"bg-white border border-slate-150 border-dashed rounded-xl p-8 text-center\">\n              <Database className=\"h-8 w-8 text-slate-300 mx-auto mb-2\" />\n              <div className=\"text-slate-500 text-xs font-semibold\">No files are matching folders.</div>\n              <p className=\"text-slate-400 text-[11px] mt-1 max-w-sm mx-auto\">\n                No Cloud-storage files found. {clientMode ? \"There are no files uploaded for your specific Project ID in this area.\" : \"As an administrative Agent, you can upload documents or mock spreadsheets below to sync the files and clear this step!\"}\n              </p>\n            </div>\n          )}\n        </div>\n\n        {/* Administrative Upload Center for the Sourcing Advisor */}\n        {!clientMode && (\n          <div className=\"mt-4 border-t border-slate-100 pt-4\">\n            <h5 className=\"text-xs font-bold text-slate-700 uppercase tracking-wider font-mono mb-2.5 flex items-center gap-1.5\">\n              <Database className=\"h-3.5 w-3.5 text-blue-500\" />\n              Secure Sourcing Sync Upload Console\n            </h5>\n\n            {/* Simulated Drag & Drop Zone */}\n            <div \n              onDragEnter={handleDrag}\n              onDragOver={handleDrag}\n              onDragLeave={handleDrag}\n              onDrop={handleDrop}\n              className={`border-2 border-dashed rounded-xl p-4 text-center transition cursor-pointer mb-3 ${\n                dragActive ? \"border-blue-505 bg-blue-50/30\" : \"border-slate-250 hover:bg-slate-50 bg-white\"\n              }`}\n            >\n              <Upload className=\"h-6 w-6 text-slate-400 mx-auto mb-1.5\" />\n              <div className=\"text-[11px] text-slate-600\">\n                <span className=\"font-bold text-blue-600\">Drag & Drop file proof</span> or click to upload\n              </div>\n              <p className=\"text-[9px] text-slate-400 mt-0.5\">\n                PDFs, XLS specification spreadsheets, lab certificates, or site audit photoshoot proofs\n              </p>\n            </div>\n\n            {/* Simulating concrete input to add custom file name easily */}\n            <div className=\"bg-white p-3 border border-slate-200 rounded-xl flex flex-col sm:flex-row gap-2 items-center\">\n              <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-2 w-full\">\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. OekoTexLabReceipt_ComfortPro.pdf\"\n                  value={customFileName}\n                  onChange={(e) => setCustomFileName(e.target.value)}\n                  className=\"p-2 border rounded-lg text-xs font-medium placeholder-slate-400 select-none\"\n                />\n\n                <select\n                  value={customFileType}\n                  onChange={(e) => setCustomFileType(e.target.value as any)}\n                  className=\"p-2 border rounded-lg text-xs bg-white text-slate-700 font-semibold cursor-pointer\"\n                >\n                  <option value=\"PDF\">PDF Report / File</option>\n                  <option value=\"RFQ Sheet\">RFQ Costing Spreadsheet</option>\n                  <option value=\"Certificate\">Compliance Certificate</option>\n                  <option value=\"Photoshoot Proof\">Photoshoot Proof JPG</option>\n                </select>\n\n                <button\n                  onClick={() => handleAddFile(customFileName || \"CustomDocumentsSync\", customFileType)}\n                  id=\"btn-upload-file-simulation\"\n                  disabled={isSimulatingUpload}\n                  className=\"bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs p-2 rounded-lg transition flex items-center justify-center gap-1.5 shrink-0 cursor-pointer\"\n                >\n                  {isSimulatingUpload ? (\n                    <>\n                      <RefreshCw className=\"h-3 w-3 animate-spin\" />\n                      Uploading...\n                    </>\n                  ) : (\n                    <>\n                      <Upload className=\"h-3.5 w-3.5\" />\n                      Push to Google Drive Folder\n                    </>\n                  )}\n                </button>\n              </div>\n            </div>\n\n            {/* Real-time automated instruction */}\n            <div className=\"bg-slate-100 border rounded-lg p-2.5 mt-2.5 text-[10px] text-slate-500 font-mono leading-relaxed flex items-start gap-1.5\">\n              <CheckCircle className=\"h-3.5 w-3.5 text-emerald-600 shrink-0 mt-0.5\" />\n              <span>\n                <strong>AUTOMATED ACTION HANDSHAKE:</strong> Any file uploaded through this console automatically maps to column <strong className=\"text-slate-700\">\"{storageLocation}\"</strong> in the SOP database tracker. This sets task state to <strong className=\"text-emerald-700 font-bold uppercase select-none\">\"Completed\"</strong> instantly, triggering synced push updates over both mobile and desktop client dashboards in real-time.\n              </span>\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}"
        replacement_content: "  // Drag and Drop simulation/real upload\n  const handleDrag = (e: React.DragEvent) => {\n    e.preventDefault();\n    e.stopPropagation();\n    if (e.type === \"dragenter\" || e.type === \"dragover\") {\n      setDragActive(true);\n    } else if (e.type === \"dragleave\") {\n      setDragActive(false);\n    }\n  };\n\n  const handleDrop = (e: React.DragEvent) => {\n    e.preventDefault();\n    e.stopPropagation();\n    setDragActive(false);\n\n    if (e.dataTransfer.files && e.dataTransfer.files[0]) {\n      const droppedFile = e.dataTransfer.files[0];\n      if (authState.accessToken) {\n        handlePhysicalFileUpload(droppedFile);\n      } else {\n        const detectedType: DriveFile[\"fileType\"] = droppedFile.name.endsWith(\".xls\") || droppedFile.name.endsWith(\".xlsx\") \n          ? \"RFQ Sheet\" \n          : droppedFile.name.endsWith(\".png\") || droppedFile.name.endsWith(\".jpg\") || droppedFile.name.endsWith(\".jpeg\")\n            ? \"Photoshoot Proof\"\n            : \"PDF\";\n        handleAddFile(droppedFile.name, detectedType);\n      }\n    }\n  };\n\n  const handleDeleteFile = (fileName: string) => {\n    const updated = files.filter(f => !(f.stepId === stepId && f.fileName === fileName));\n    setFiles(updated);\n    localStorage.setItem(\"t2t_clouddrive_files\", JSON.stringify(updated));\n  };\n\n  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    if (e.target.files && e.target.files[0]) {\n      handlePhysicalFileUpload(e.target.files[0]);\n    }\n  };\n\n  return (\n    <div className=\"bg-slate-50 rounded-xl border border-slate-200 overflow-hidden shadow-sm mt-3 animate-fadeIn\">\n      {/* Hidden native input for physical folder mapping uploads */}\n      <input \n        type=\"file\" \n        ref={fileInputRef} \n        onChange={handleFileChange} \n        className=\"hidden\" \n      />\n\n      {/* Dynamic API Bar */}\n      <div className=\"bg-slate-900 px-4 py-3 flex flex-col sm:flex-row items-stretch sm:items-center justify-between text-white border-b border-slate-800 text-xs gap-3\">\n        <div className=\"flex items-center gap-2\">\n          <div className={`h-2 w-2 rounded-full ${authState.accessToken ? \"bg-emerald-500 animate-pulse\" : \"bg-amber-500 animate-pulse\"}`} />\n          <span className=\"font-mono text-[11px] font-semibold text-slate-300\">\n            {authState.accessToken ? \"GOOGLE-DRIVE-API v3 // CONNECTED\" : \"GOOGLE-DRIVE-SIMULATOR // OFFLINE\"}\n          </span>\n          <span className=\"text-slate-700 hidden sm:inline\">|</span>\n          <span className=\"text-slate-400 text-[10px] hidden sm:inline font-mono\">\n            {authState.accessToken ? `Linked User: ${authState.email}` : \"Vite Client Demonstration Mode\"}\n          </span>\n        </div>\n        \n        <div className=\"flex items-center gap-2 justify-between sm:justify-end\">\n          {authState.accessToken ? (\n            <div className=\"flex items-center gap-2\">\n              {authState.picture && (\n                <img \n                  src={authState.picture} \n                  className=\"h-5 w-5 rounded-full border border-slate-700\" \n                  alt=\"user avatar\" \n                  referrerPolicy=\"no-referrer\"\n                />\n              )}\n              <span className=\"text-[10px] font-mono text-emerald-400 font-semibold max-w-[120px] truncate\">\n                {authState.email}\n              </span>\n              <button\n                onClick={() => setDriveAuth(null, null, null)}\n                className=\"flex items-center gap-1 px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 hover:text-red-400 transition cursor-pointer text-[10px] font-mono\"\n                title=\"Disconnect Google credentials\"\n              >\n                <Unlink className=\"h-3 w-3\" /> Log Out\n              </button>\n            </div>\n          ) : (\n            <button\n              onClick={handleConnectGoogle}\n              className=\"flex items-center gap-1.5 px-2.5 py-1 rounded bg-amber-600 hover:bg-amber-500 text-white transition cursor-pointer text-[10px] font-bold shadow-md shadow-amber-950/20\"\n            >\n              <Link2 className=\"h-3.5 w-3.5 animate-bounce\" />\n              Link Real Google Drive\n            </button>\n          )}\n\n          <span className=\"text-slate-700 hidden sm:inline\">|</span>\n\n          <button\n            onClick={handleSyncDrive}\n            id=\"btn-sync-folder\"\n            className=\"flex items-center gap-1.5 px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 hover:text-white transition cursor-pointer text-[10px] font-semibold text-slate-300\"\n            disabled={isSyncing}\n          >\n            <RefreshCw className={`h-3 w-3 ${isSyncing ? \"animate-spin text-teal-400\" : \"\"}`} />\n            {isSyncing ? \"Syncing...\" : \"Sync Cloud\"}\n          </button>\n        </div>\n      </div>\n\n      <div className=\"p-4 sm:p-5\">\n        {/* Storage Title Info */}\n        <div className=\"flex justify-between items-start gap-4 mb-4 pb-3 border-b border-slate-100\">\n          <div className=\"flex items-start gap-2.5\">\n            <div className=\"p-2 bg-blue-50 text-blue-600 rounded-lg shrink-0\">\n              <Folder className=\"h-5 w-5\" />\n            </div>\n            <div>\n              <div className=\"text-[10px] text-slate-400 uppercase font-mono font-bold\">\n                Designated Cloud Storage Path (SOP Column Target)\n              </div>\n              <h4 className=\"text-sm font-bold text-slate-800 font-display flex items-center gap-1.5 mt-0.5\">\n                {storageLocation || \"SOP Default Documents Storage\"}\n              </h4>\n            </div>\n          </div>\n\n          <div className=\"text-right\">\n            <span className={`inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold ${authState.accessToken ? \"bg-emerald-50 border border-emerald-100 text-emerald-700\" : \"bg-blue-50 border border-blue-100 text-blue-700\"}`}>\n              <ShieldCheck className=\"h-3 w-3\" />\n              {authState.accessToken \n                ? \"Physical Google Synced\" \n                : clientMode ? \"Client Sandbox\" : \"Offline Sandbox\"}\n            </span>\n          </div>\n        </div>\n\n        {/* Security / Non-compliance Banner */}\n        {clientMode && (\n          <div className=\"mb-4 bg-teal-50/70 border border-teal-100 rounded-xl p-3 text-xs text-teal-800 flex gap-2\">\n            <ShieldCheck className=\"h-4 w-4 text-teal-600 shrink-0 mt-0.5\" />\n            <div>\n              <span className=\"font-bold\">Confined Client View Clearance: </span>\n              In order to protect industrial design secrets and competitor pricing strategies, you are locked into project ID <strong className=\"font-mono\">{currentProjectId}</strong>. This folder isolates client-relevant compliance checks, ATR custom passes, photoshoot proofing documents, and certificated logs under 256-bit encryption. Actionable uploads and deletion parameters are locked.\n            </div>\n          </div>\n        )}\n\n        {/* Sync Instruction Banner */}\n        {!authState.accessToken && !clientMode && (\n          <div className=\"mb-4 bg-amber-50/70 border border-amber-100 rounded-xl p-3.5 text-xs text-amber-800 flex gap-2\">\n            <ShieldAlert className=\"h-4.5 w-4.5 text-amber-600 shrink-0 mt-0.5\" />\n            <div className=\"space-y-1\">\n              <span className=\"font-bold\">Currently in Local Demonstration Mode: </span>\n              Files are saved temporarily in custom local caches. If you connect your real Google account using the <strong className=\"text-slate-900\">\"Link Real Google Drive\"</strong> button above, uploads will <strong>physically create custom folder structures in your real Drive</strong> under <code className=\"bg-amber-100 font-mono px-1 rounded text-[10px] font-bold\">Trade2Turkey Logistics/{PROJECT_NAMES[currentProjectId] || currentProjectId}/{stepId}</code> and transfer actual files for end-to-end B2B integrity!\n            </div>\n          </div>\n        )}\n\n        {/* Search Bar / Filters */}\n        <div className=\"mb-4\">\n          <input\n            type=\"text\"\n            placeholder=\"\360\237\224\215 Search files inside this Drive folder path...\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            className=\"w-full text-xs p-2 rounded-lg border border-slate-200 bg-white placeholder-slate-400 focus:outline-none focus:border-blue-500 font-medium\"\n          />\n        </div>\n\n        {/* Files Grid and Table */}\n        <div className=\"space-y-2\">\n          {displayedFiles.length > 0 ? (\n            <div className=\"bg-white border border-slate-150 rounded-xl divide-y divide-slate-100 overflow-hidden\">\n              {displayedFiles.map(file => (\n                <div \n                  key={file.fileName}\n                  className=\"flex items-center justify-between p-3.5 hover:bg-slate-50/50 transition text-xs\"\n                >\n                  <div className=\"flex items-center gap-3 min-w-0 mr-4\">\n                    <span className={`p-2 rounded-lg ${\n                      file.fileType === \"PDF\" ? \"bg-red-50 text-red-600\" :\n                      file.fileType === \"RFQ Sheet\" ? \"bg-emerald-50 text-emerald-600\" :\n                      file.fileType === \"Photoshoot Proof\" ? \"bg-purple-50 text-purple-600\" :\n                      file.fileType === \"Certificate\" ? \"bg-blue-50 text-blue-600\" :\n                      \"bg-slate-50 text-slate-600\"\n                    }`}>\n                      <FileText className=\"h-4.5 w-4.5 shrink-0\" />\n                    </span>\n                    <div className=\"min-w-0\">\n                      <div className=\"font-semibold text-slate-800 truncate\" title={file.fileName}>\n                        {file.fileName}\n                      </div>\n                      <div className=\"flex flex-wrap gap-2 text-[10px] text-slate-400 font-mono mt-0.5\">\n                        <span className=\"text-blue-600 font-bold uppercase text-[9px] bg-blue-50 px-1 rounded\">\n                          {file.fileId ? \"CLOUD REAL\" : \"SANDBOX\"}\n                        </span>\n                        <span>\342\200\242</span>\n                        <span>Type: {file.fileType}</span>\n                        <span>\342\200\242</span>\n                        <span>Size: {file.fileSize}</span>\n                        <span>\342\200\242</span>\n                        <span>Project: {file.projectId}</span>\n                        <span>\342\200\242</span>\n                        <span>Added: {file.dateAdded}</span>\n                      </div>\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center gap-2 shrink-0\">\n                    <button\n                      onClick={() => {\n                        if (file.downloadUrl && file.downloadUrl !== \"#\") {\n                          window.open(file.downloadUrl, \"_blank\");\n                        } else {\n                          alert(`Downloading demonstration document \"${file.fileName}\" directly from secure localized server.`);\n                        }\n                      }}\n                      className=\"inline-flex items-center gap-1 py-1.5 px-3 rounded-lg bg-slate-150 border border-slate-200 hover:bg-slate-200 text-slate-700 hover:text-slate-900 transition font-bold text-[11px] cursor-pointer\"\n                    >\n                      <Download className=\"h-3 w-3\" />\n                      {file.fileId ? \"Open In Drive\" : \"Get\"}\n                    </button>\n\n                    {/* Deletion parameters for Admin Sourcing workspace */}\n                    {!clientMode && (\n                      <button\n                        onClick={() => handleDeleteFile(file.fileName)}\n                        className=\"p-1.5 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition shrink-0 cursor-pointer\"\n                        title=\"Delete from remote storage\"\n                      >\n                        <Trash2 className=\"h-4 w-4\" />\n                      </button>\n                    )}\n                  </div>\n                </div>\n              ))}\n            </div>\n          ) : (\n            <div className=\"bg-white border border-slate-150 border-dashed rounded-xl p-8 text-center\">\n              <Database className=\"h-8 w-8 text-slate-300 mx-auto mb-2\" />\n              <div className=\"text-slate-500 text-xs font-semibold\">No files are matching folders.</div>\n              <p className=\"text-slate-400 text-[11px] mt-1 max-w-sm mx-auto\">\n                No Cloud-storage files found. {clientMode ? \"There are no files uploaded for your specific Project ID in this area.\" : \"As an administrative Agent, you can upload documents or select physical attachments below to map them!\"}\n              </p>\n            </div>\n          )}\n        </div>\n\n        {/* Administrative Upload Center for the Sourcing Advisor */}\n        {!clientMode && (\n          <div className=\"mt-4 border-t border-slate-100 pt-4\">\n            <h5 className=\"text-xs font-bold text-slate-700 uppercase tracking-wider font-mono mb-2.5 flex items-center gap-1.5\">\n              <Database className=\"h-3.5 w-3.5 text-blue-500\" />\n              Secure Sourcing Cloud Sync Upload Console\n            </h5>\n\n            {/* Simulated / Real Drag & Drop Zone */}\n            <div \n              onDragEnter={handleDrag}\n              onDragOver={handleDrag}\n              onDragLeave={handleDrag}\n              onDrop={handleDrop}\n              onClick={() => fileInputRef.current?.click()}\n              className={`border-2 border-dashed rounded-xl p-5 text-center transition cursor-pointer mb-3 ${\n                dragActive ? \"border-blue-505 bg-blue-50/30\" : \"border-slate-300 hover:border-blue-500 hover:bg-slate-100 bg-white\"\n              }`}\n              title=\"Click or Drop your file here\"\n            >\n              <Upload className=\"h-8 w-8 text-slate-400 mx-auto mb-2\" />\n              <div className=\"text-xs text-slate-600\">\n                <span className=\"font-bold text-blue-600\">Drag & Drop real documents</span> or copy/click here to select physical file\n              </div>\n              <p className=\"text-[10px] text-slate-400 mt-1\">\n                PDFs, XLS specification spreadsheets, test certificates, customs briefs, or factory QC photoshoot proofs\n              </p>\n              {authState.accessToken && (\n                <div className=\"mt-2 text-[9px] text-emerald-600 font-mono font-bold tracking-tight bg-emerald-50 inline-block px-2 py-0.5 rounded border border-emerald-100 uppercase\">\n                  Connected to Google Cloud: Directly pipelines to Drive folders\n                </div>\n              )}\n            </div>\n\n            {/* Simulating concrete input to add custom file name easily */}\n            <div className=\"bg-white p-3 border border-slate-200 rounded-xl flex flex-col sm:flex-row gap-2 items-center\">\n              <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-2 w-full\">\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. OekoTexLabReceipt_ComfortPro.pdf\"\n                  value={customFileName}\n                  onChange={(e) => setCustomFileName(e.target.value)}\n                  className=\"p-2 border rounded-lg text-xs font-medium placeholder-slate-400 select-none\"\n                />\n\n                <select\n                  value={customFileType}\n                  onChange={(e) => setCustomFileType(e.t