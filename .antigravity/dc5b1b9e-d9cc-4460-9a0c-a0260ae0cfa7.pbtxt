          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <div className=\"text-[10px] text-slate-400 font-mono\">CALCULATED RECIPE TOTAL EXW</div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <div className=\"text-2xl font-black text-white font-mono\">${recipeMetrics.grandTotal.toFixed(2)}</div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
