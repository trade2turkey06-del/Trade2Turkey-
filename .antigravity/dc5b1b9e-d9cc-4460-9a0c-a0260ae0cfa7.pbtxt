  file_change {
    absolute_path_uri: "file:///src/components/LogisticsSOP.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { \n  Ship, Calendar, Truck, Layers, Coins, Package, BarChart2, CheckSquare, \n  Search, ShieldCheck, Camera, FileText, ArrowRight, RefreshCw, AlertTriangle\n} from \"lucide-react\";\nimport { SopStep, ShipmentMilestone, InventoryItem, FulfillmentOrder } from \"../types\";\n\ninterface LogisticsSOPProps {\n  steps: SopStep[];\n  setSteps: React.Dispatch<React.SetStateAction<SopStep[]>>;\n  shipments: ShipmentMilestone[];\n  setShipments: React.Dispatch<React.SetStateAction<ShipmentMilestone[]>>;\n  inventory: InventoryItem[];\n  setInventory: React.Dispatch<React.SetStateAction<InventoryItem[]>>;\n  orders: FulfillmentOrder[];\n  setOrders: React.Dispatch<React.SetStateAction<FulfillmentOrder[]>>;\n}\n\nexport default function LogisticsSOP({\n  steps,\n  setSteps,\n  shipments,\n  setShipments,\n  inventory,\n  setInventory,\n  orders,\n  setOrders\n}: LogisticsSOPProps) {\n  \n  const [activeSubsection, setActiveSubsection] = useState<\"B.A\" | \"B.B\" | \"B.C\">(\"B.A\");\n  const [searchQuery, setSearchQuery] = useState(\"\");\n\n  // Internal notification helper\n  const [feedback, setFeedback] = useState<string | null>(null);\n  const showFeedback = (msg: string) => {\n    setFeedback(msg);\n    setTimeout(() => setFeedback(null), 3000);\n  };\n\n  // --- FILTER STEPS BY ACTIVE SUBSECTION ---\n  const currentSectionSteps = steps.filter(step => {\n    if (step.section !== \"B\") return false;\n    const matchesSection = \n      (activeSubsection === \"B.A\" && step.subsection.startsWith(\"B.A\")) ||\n      (activeSubsection === \"B.B\" && step.subsection.includes(\"Inventory\")) ||\n      (activeSubsection === \"B.C\" && step.subsection.includes(\"Fulfilment\"));\n    \n    return matchesSection && step.task.toLowerCase().includes(searchQuery.toLowerCase());\n  });\n\n  const handleUpdateStatus = (stepId: string, newStatus: \"Completed\" | \"In Progress\" | \"Pending\" | \"Rejected\") => {\n    setSteps(prev => prev.map(s => {\n      if (s.id === stepId) {\n        return { ...s, status: newStatus };\n      }\n      return s;\n    }));\n    showFeedback(`Step ${stepId} updated to ${newStatus}`);\n  };\n\n  // --- ACTIVE LOGISTICS SHIPMENT MODULE ---\n  const currentShipment = shipments[0] || null;\n  const advanceShipmentMilestone = () => {\n    if (!currentShipment) return;\n    setShipments(prev => prev.map(ship => {\n      const nextIndex = Math.min(ship.milestones.length - 1, ship.currentMilestoneIndex + 1);\n      const updatedMilestones = ship.milestones.map((mil, idx) => {\n        if (idx <= nextIndex) return { ...mil, completed: true };\n        return mil;\n      });\n      return {\n        ...ship,\n        currentMilestoneIndex: nextIndex,\n        status: nextIndex >= 7 ? \"Delivered\" : \"Transit\",\n        milestones: updatedMilestones\n      };\n    }));\n    showFeedback(\"Shipment milestone advanced! Cargo coordinates updated.\");\n  };\n\n  // --- INVENTORY PLANNER MODULE ---\n  const handleUpdateInventoryField = (id: string, field: keyof InventoryItem, value: any) => {\n    setInventory(prev => prev.map(item => {\n      if (item.id === id) {\n        return { ...item, [field]: value };\n      }\n      return item;\n    }));\n  };\n\n  // --- FULFILLMENT MATRIX CONTROLLER ---\n  const [cargoUploadingOrderId, setCargoUploadingOrderId] = useState<string | null>(null);\n  const [mockPhotoUrl, setMockPhotoUrl] = useState(\"https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?q=80&w=400&auto=format&fit=crop\");\n\n  const verifyStockAndAdvance = (ordId: string) => {\n    const order = orders.find(o => o.id === ordId);\n    if (!order) return;\n    const item = inventory.find(i => i.sku === order.sku);\n    \n    if (item && item.physicalStock - item.committedStock > 0) {\n      setOrders(prev => prev.map(o => o.id === ordId ? { ...o, status: \"Stock Verified\" } : o));\n      showFeedback(`Stock available. Item locked for fulfillment.`);\n    } else {\n      showFeedback(`\360\237\232\250 Warning: Insufficient physical available count!`);\n    }\n  };\n\n  const assignCarrierRate = (ordId: string, carrierName: string, rateValue: number) => {\n    setOrders(prev => prev.map(o => {\n      if (o.id === ordId) {\n        return {\n          ...o,\n          selectedRate: { carrier: carrierName, rate: rateValue, duration: \"3 Days\" },\n          status: \"Labeiled\",\n          shippingLabelUrl: `https://example.com/labels/${carrierName.replace(\" \", \"\")}-${ordId}.pdf`,\n          trackingNumber: `${carrierName.toUpperCase().slice(0,3)}-${Date.now()}-EU`\n        };\n      }\n      return o;\n    }));\n    showFeedback(`Carrier DPD/DHL selected. Label generated.`);\n  };\n\n  const uploadCargoProofPhoto = (ordId: string) => {\n    setOrders(prev => prev.map(o => {\n      if (o.id === ordId) {\n        return {\n          ...o,\n          cargoProofPhotoUrl: mockPhotoUrl,\n          status: \"Shipped\"\n        };\n      }\n      return o;\n    }));\n    setCargoUploadingOrderId(null);\n    showFeedback(`Cargo validation picture uploaded as delivery proof!`);\n  };\n\n  const synchronizeAndComplete = (ordId: string) => {\n    const order = orders.find(o => o.id === ordId);\n    if (!order) return;\n\n    // Deduct stock physically as per Step B.C.8 & B.C.9\n    setInventory(prev => prev.map(item => {\n      if (item.sku === order.sku) {\n        return {\n          ...item,\n          physicalStock: Math.max(0, item.physicalStock - 1),\n          committedStock: Math.max(0, item.committedStock - 1)\n        };\n      }\n      return item;\n    }));\n\n    setOrders(prev => prev.map(o => o.id === ordId ? { ...o, status: \"Synced\" } : o));\n    showFeedback(`Successfully updated local databases & synchronized Amazon + Walmart stores!`);\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      \n      {/* Tab select buttons */}\n      <div className=\"flex border-b border-slate-200\">\n        <button\n          onClick={() => setActiveSubsection(\"B.A\")}\n          className={`px-5 py-3 text-sm font-semibold border-b-2 transition ${\n            activeSubsection === \"B.A\"\n              ? \"border-orange-500 text-orange-600\"\n              : \"border-transparent text-slate-500 hover:text-slate-900\"\n          }`}\n        >\n          \360\237\232\242 Project Logistics Tracker (B.A)\n        </button>\n        <button\n          onClick={() => setActiveSubsection(\"B.B\")}\n          className={`px-5 py-3 text-sm font-semibold border-b-2 transition ${\n            activeSubsection === \"B.B\"\n              ? \"border-orange-500 text-orange-600\"\n              : \"border-transparent text-slate-500 hover:text-slate-900\"\n          }`}\n        >\n          \360\237\223\212 Inventory Planning & Forecasting (B.B)\n        </button>\n        <button\n          onClick={() => setActiveSubsection(\"B.C\")}\n          className={`px-5 py-3 text-sm font-semibold border-b-2 transition ${\n            activeSubsection === \"B.C\"\n              ? \"border-orange-500 text-orange-600\"\n              : \"border-transparent text-slate-500 hover:text-slate-900\"\n          }`}\n        >\n          \360\237\223\246 Multi-Channel Fulfillment Hub (B.C)\n        </button>\n      </div>\n\n      {feedback && (\n        <div className=\"p-3 bg-blue-50 border border-blue-200 text-blue-700 rounded-lg text-xs font-semibold flex items-center justify-between\">\n          <span>\342\204\271\357\270\217 {feedback}</span>\n          <button onClick={() => setFeedback(null)}>\342\234\225</button>\n        </div>\n      )}\n\n      {/* =======================================================\n          A. PROJECT EXECUTION & TRACKING SUB-DASHBOARDS\n         ======================================================= */}\n      {activeSubsection === \"B.A\" && currentShipment && (\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n          \n          {/* Tracking milestones progress map simulation */}\n          <div className=\"lg:col-span-8 bg-slate-900 text-white rounded-xl p-6 border border-slate-800 space-y-6\">\n            <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3\">\n              <div>\n                <span className=\"text-[10px] text-orange-400 font-bold uppercase tracking-widest font-mono\">\n                  Export Vessel GPS Coordinates System\n                </span>\n                <h4 className=\"text-lg font-bold font-display\">{currentShipment.vesselName}</h4>\n                <p className=\"text-xs text-slate-400 mt-1 font-mono\">\n                  Container ID: {currentShipment.containerId} | Waybill: MSCT-TR29184\n                </p>\n              </div>\n\n              <button\n                id=\"btn-advance-shipping\"\n                onClick={advanceShipmentMilestone}\n                className=\"bg-orange-500 hover:bg-orange-600 font-bold text-xs text-white px-4 py-2 rounded-lg flex items-center gap-2 cursor-pointer transition border border-orange-600\"\n              >\n                <RefreshCw className=\"h-4 w-4 animate-spin-slow\" /> Advance Vessel Leg\n              </button>\n            </div>\n\n            {/* Simulated Live Route Progress */}\n            <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-850 grid grid-cols-1 md:grid-cols-3 gap-4 text-xs font-mono\">\n              <div className=\"border-r border-slate-800/40 pr-2\">\n                <span className=\"text-slate-500 block text-[10px]\">CURRENT LOCAL CORNER:</span>\n                <strong className=\"text-teal-400 text-sm\">{currentShipment.milestones[currentShipment.currentMilestoneIndex]?.title}</strong>\n              </div>\n              <div className=\"border-r border-slate-800/40 pr-2\">\n                <span className=\"text-slate-500 block text-[10px]\">ROUTE PORTS:</span>\n                <strong className=\"text-slate-200\">Istanbul (AMB) \342\206\222 Rotterdam (RTM)</strong>\n              </div>\n              <div>\n                <span className=\"text-slate-500 block text-[10px]\">GPS SAT LOC:</span>\n                <strong className=\"text-orange-300\">LAT {currentShipment.latitude}\302\260 N | LON {currentShipment.longitude}\302\260 E</strong>\n              </div>\n            </div>\n\n            {/* Milestones stepper */}\n            <div className=\"relative pl-8 space-y-6 before:absolute before:left-[11px] before:top-2 before:bottom-2 before:w-0.5 before:bg-slate-800\">\n              {currentShipment.milestones.map((mil, idx) => {\n                const isActive = idx === currentShipment.currentMilestoneIndex;\n                const isPassed = idx < currentShipment.currentMilestoneIndex;\n                return (\n                  <div key={mil.title} className=\"relative flex gap-4 text-xs\">\n                    \n                    {/* Stepper Dot */}\n                    <div className={`absolute -left-[27px] h-4 w-4 rounded-full border-2 flex items-center justify-center ${\n                      isActive \n                        ? \"bg-orange-500 border-white text-slate-900\" \n                        : isPassed \n                        ? \"bg-green-600 border-green-600\" \n                        : \"bg-slate-950 border-slate-800\"\n                    }`}>\n                      {isPassed && <span className=\"text-[8px] text-white\">\342\234\223</span>}\n                    </div>\n\n                    <div className=\"flex-1\">\n                      <div className=\"flex items-center gap-3 justify-between\">\n                        <strong className={`font-semibold tracking-wide ${isActive ? \"text-orange-400\" : isPassed ? \"text-slate-200\" : \"text-slate-500\"}`}>\n                          {mil.title}\n                        </strong>\n                        <span className=\"font-mono text-[10px] text-slate-500\">{mil.date}</span>\n                      </div>\n                      <p className={`mt-0.5 leading-relaxed text-[11px] ${isActive ? \"text-slate-200\" : \"text-slate-500\"}`}>\n                        {mil.description}\n                      </p>\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Cargo Proof Photos & Customs Documents */}\n          <div className=\"lg:col-span-4 bg-white rounded-xl p-6 border border-slate-200 flex flex-col justify-between\">\n            <div>\n              <span className=\"text-[10px] text-blue-600 font-bold uppercase tracking-wider font-mono\">\n                Verification Proof Box\n              </span>\n              <h4 className=\"text-sm font-bold text-slate-800 mt-1\">Sourcing Site Quality Proofs</h4>\n              <p className=\"text-xs text-slate-500 mt-0.5\">Pre-shipping photography uploaded directly by Turkish inspection team</p>\n\n              <div className=\"grid grid-cols-1 gap-3 mt-4\">\n                {currentShipment.cargoPhotos.map(ph => (\n                  <div key={ph.id} className=\"relative rounded-lg overflow-hidden border bg-slate-100 group\">\n                    <img \n                      src={ph.url} \n                      alt={ph.title} \n                      className=\"h-28 w-full object-cover group-hover:scale-105 transition duration-500\" \n                    />\n                    <div className=\"absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent p-2.5 flex flex-col justify-end\">\n                      <div className=\"font-bold text-white text-[11px]\">{ph.title}</div>\n                      <div className=\"text-[9px] text-slate-300 font-mono\">{ph.timestamp}</div>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            <div className=\"mt-4 pt-4 border-t border-slate-100\">\n              <div className=\"text-[11px] font-bold text-slate-700\">Digital Document Vaults:</div>\n              <div className=\"space-y-1.5 mt-2\">\n                <a href=\"#\" className=\"flex justify-between p-2 rounded border bg-slate-50 text-[10px] hover:bg-slate-100 font-mono\">\n                  <span>\360\237\223\204 Certificate_of_Origin_TR.pdf</span>\n                  <span className=\"text-blue-600\">Download</span>\n                </a>\n                <a href=\"#\" className=\"flex justify-between p-2 rounded border bg-slate-50 text-[10px] hover:bg-slate-100 font-mono\">\n                  <span>\360\237\223\204 Export_Packing_List_1002.xls</span>\n                  <span className=\"text-blue-600\">Download</span>\n                </a>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* =======================================================\n          B. INVENTORY DEEP INTUITIVE FORECASTING\n         ======================================================= */}\n      {activeSubsection === \"B.B\" && (\n        <div className=\"space-y-6\">\n          <div className=\"bg-white p-6 rounded-xl border border-slate-200\">\n            <h4 className=\"text-base font-bold text-slate-800 font-display\">Granular Turkish Storage Forecasts</h4>\n            <p className=\"text-xs text-slate-500 mt-1 leading-relaxed\">\n              Calculate reorder limits automatically using lead time and safety stocks. Trade2Turkey automatically triggers alarm indicators for stocks approaching unsafe levels.\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n            {inventory.map(item => {\n              const available = item.physicalStock - item.committedStock;\n              const dailyUsage = item.forecastDailySales;\n              const leadTimeDays = item.leadTimeDays;\n              const safetyStockDays = item.safetyStockDays;\n              \n              // Daily Average * LeadTime + (Daily Average * SafetyStockDays)\n              const reorderPoint = (dailyUsage * leadTimeDays) + (dailyUsage * safetyStockDays);\n              const statusCritical = available <= reorderPoint;\n\n              return (\n                <div key={item.id} className={`p-5 rounded-xl border bg-white relative overflow-hidden transition shadow-sm ${\n                  statusCritical ? \"border-red-200 ring-2 ring-red-100\" : \"border-slate-200\"\n                }`}>\n                  {statusCritical && (\n                    <div className=\"absolute top-0 right-0 p-1.5 bg-red-600 text-white text-[9px] font-bold tracking-wider font-mono uppercase px-2 rounded-bl-lg flex items-center gap-1 animate-pulse\">\n                      <AlertTriangle className=\"h-3 w-3\" /> Reorder Alert\n                    </div>\n                  )}\n\n                  <div className=\"font-bold text-slate-800 text-base\">{item.name}</div>\n                  <div className=\"text-[10px] text-slate-500 font-mono uppercase tracking-wide mt-0.5\">SKU: {item.sku}</div>\n\n                  <div className=\"grid grid-cols-2 gap-4 border-y py-4 my-4 text-xs\">\n                    <div>\n                      <span className=\"text-slate-400 block font-medium\">Physical Stock:</span>\n                      <input\n                        type=\"number\"\n                        value={item.physicalStock}\n                        onChange={(e) => handleUpdateInventoryField(item.id, \"physicalStock\", Number(e.target.value))}\n                        className=\"font-mono text-base font-extrabold text-slate-800 focus:outline-none w-20 border-b focus:border-orange-500 bg-transparent\"\n                      />\n                    </div>\n                    <div>\n                      <span className=\"text-slate-400 block font-medium\">Committed (B2B/B2C):</span>\n                      <input\n                        type=\"number\"\n                        value={item.committedStock}\n                        onChange={(e) => handleUpdateInventoryField(item.id, \"committedStock\", Number(e.target.value))}\n                        className=\"font-mono text-base font-extrabold text-slate-800 focus:outline-none w-20 border-b focus:border-orange-500 bg-transparent\"\n                      />\n                    </div>\n                    <div>\n                      <span className=\"text-slate-400 block font-medium\">Daily Sales:</span>\n                      <input\n                        type=\"number\"\n                        value={item.forecastDailySales}\n                        onChange={(e) => handleUpdateInventoryField(item.id, \"forecastDailySales\", Number(e.target.value))}\n                        className=\"font-mono text-xs font-bold text-slate-800 focus:outline-none w-16 border-b focus:border-orange-500 bg-transparent\"\n                      />\n                    </div>\n                    <div>\n                      <span className=\"text-slate-400 block font-medium\">Transit Days:</span>\n                      <strong className=\"font-mono text-xs text-slate-800 block mt-1\">{item.leadTimeDays} Transit Days</strong>\n                    </div>\n                  </div>\n\n                  {/* Math calculation display */}\n                  <div className=\"space-y-2 text-xs bg-slate-50 p-3 rounded-lg border border-slate-150\">\n                    <div className=\"flex justify-between\">\n                      <span className=\"text-slate-500\">Available count:</span>\n                      <strong className=\"font-mono text-slate-800\">{available} units</strong>\n                    </div>\n                    <div className=\"flex justify-between\">\n                      <span className=\"text-slate-500\">Reorder threshold:</span>\n                      <strong className=\"font-mono text-slate-800\">{reorderPoint} units</strong>\n                    </div>\n                    <div className=\"border-t pt-2 flex justify-between uppercase font-mono font-bold text-[10px]\">\n                      <span className=\"text-slate-500\">Coverage remaining:</span>\n                      <span className={statusCritical ? \"text-red-600 animate-pulse\" : \"text-green-600\"}>\n                        {Math.floor(available / (dailyUsage || 1))} Days remaining\n                      </span>\n                    </div>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      )}\n\n      {/* =======================================================\n          C. MULTI-CHANNEL SHIPMENT ORDER FULFILLMENT\n         ======================================================= */}\n      {activeSubsection === \"B.C\" && (\n        <div className=\"space-y-6\">\n          <div className=\"bg-white p-6 rounded-xl border border-slate-200\">\n            <h4 className=\"text-base font-bold text-slate-800 font-display\">Multi-Store Shipment Invoicing</h4>\n            <p className=\"text-xs text-slate-500 mt-1 leading-relaxed\">\n              Accept orders directly from Shopify, Amazon and Walmart, lookup instant delivery quotes, mock label downloads, capture packaging proof and synchronize cross-platform stocks as per <strong>standard operating procedures</strong>.\n            </p>\n          </div>\n\n          <div className=\"space-y-4\">\n            {orders.map(ord => (\n              <div key={ord.id} className=\"bg-white p-5 rounded-xl border border-slate-100 shadow-sm relative overflow-hidden\">\n                <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n                  <div>\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"bg-orange-500 text-white font-mono text-[9px] font-bold px-2 py-0.5 rounded uppercase\">\n                        {ord.platform}\n                      </span>\n                      <span className=\"text-xs text-slate-400 font-mono\">ID: {ord.orderId}</span>\n                    </div>\n                    <h5 className=\"font-bold text-slate-800 text-sm mt-1\">{ord.customerName}</h5>\n                    <p className=\"text-xs text-slate-500\">{ord.shippingAddress}</p>\n                    <p className=\"text-xs text-slate-600 mt-1 font-mono\">Target SKU: <strong className=\"text-slate-800\">{ord.sku}</strong></p>\n                  </div>\n\n                  {/* STEPPER CONTROLS FOR FULFILLMENT */}\n                  <div className=\"flex flex-wrap items-center gap-2\">\n                    \n                    {/* Status badges */}\n                    <div className=\"bg-slate-100 p-2 rounded-lg border flex flex-col text-right\">\n                      <span className=\"text-[9px] text-slate-400 uppercase font-mono font-bold\">STATE</span>\n                      <strong className=\"text-xs text-slate-700 font-semibold\">{ord.status}</strong>\n                    </div>\n\n                    {/* Step 1: Check Available Stock */}\n                    {ord.status === \"Pending Check\" && (\n                      <button\n                        id={`btn-verify-stock-${ord.id}`}\n                        onClick={() => verifyStockAndAdvance(ord.id)}\n                        className=\"bg-slate-900 hover:bg-black text-white text-xs font-semibold px-3 py-2 rounded-lg cursor-pointer\"\n                      >\n                        1. Query Stock\n                      </button>\n                    )}\n\n                    {/* Step 2: Rate selection & labeling */}\n                    {ord.status === \"Stock Verified\" && (\n                      <div className=\"flex items-center gap-1\">\n                        <select\n                          onChange={(e) => {\n                            const val = Number(e.target.value);\n                            const name = e.target.options[e.target.selectedIndex].text.split(\" - \")[0];\n                            assignCarrierRate(ord.id, name, val);\n                          }}\n                          className=\"bg-slate-900 text-white text-xs font-semibold p-2 rounded-lg focus:outline-none cursor-pointer\"\n                          defaultValue=\"\"\n                        >\n                          <option value=\"\" disabled>Select Carrier Rate</option>\n                          {ord.shippingRates.map(r => (\n                            <option key={r.carrier} value={r.rate}>{r.carrier} - ${r.rate.toFixed(2)}</option>\n                          ))}\n                        </select>\n                      </div>\n                    )}\n\n                    {/* Step 3: Photoshoot Upload */}\n                    {ord.status === \"Labeiled\" && (\n                      <div className=\"flex items-center gap-2\">\n                        <button\n                          id={`btn-mock-photo-on-${ord.id}`}\n                          onClick={() => setCargoUploadingOrderId(ord.id)}\n                          className=\"bg-orange-600 hover:bg-orange-700 text-white text-xs font-semibold px-3 py-2 rounded-lg flex items-center gap-1.5 cursor-pointer\"\n                        >\n                          <Camera className=\"h-4 w-4\" /> 3. Capture Photo Proof\n                        </button>\n                      </div>\n                    )}\n\n                    {/* Step 4: Synchronize & complete */}\n                    {ord.status === \"Shipped\" && (\n                      <button\n                        id={`btn-platform-sync-${ord.id}`}\n                        onClick={() => synchronizeAndComplete(ord.id)}\n                        className=\"bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold px-3 py-2 rounded-lg flex items-center gap-1.5 transition cursor-pointer\"\n                      >\n                        <RefreshCw className=\"h-3.5 w-3.5 animate-spin-slow\" /> 4. Sync Stores\n                      </button>\n                    )}\n\n                    {/* Complete check */}\n                    {ord.status === \"Synced\" && (\n                      <div className=\"bg-green-100 text-green-800 text-xs px-3 py-2 rounded-lg font-bold flex items-center gap-1\">\n                        <ShieldCheck className=\"h-4 w-4 text-green-600\" /> Fully Dispatched\n                      </div>\n                    )}\n                  </div>\n                </div>\n\n                {/* Tracking information drawer inside orders */}\n                {ord.trackingNumber && (\n                  <div className=\"mt-4 pt-3 border-t border-dashed border-slate-100 flex justify-between items-center text-[11px] font-mono text-slate-500\">\n                    <div>\n                      Carrier: <strong className=\"text-slate-700\">{ord.selectedRate?.carrier}</strong> | Waybill: <strong className=\"text-slate-700\">{ord.trackingNumber}</strong>\n                    </div>\n                    <a href={ord.shippingLabelUrl} target=\"_blank\" rel=\"noreferrer\" className=\"text-blue-600 hover:underline\">\n                      View Shipping Label\n                    </a>\n                  </div>\n                )}\n\n                {/* Simulated cargo photos uploaded display */}\n                {ord.cargoProofPhotoUrl && (\n                  <div className=\"mt-3 flex gap-2 items-center bg-slate-50 p-2 rounded-lg border\">\n                    <img src={ord.cargoProofPhotoUrl} alt=\"Proof\" className=\"h-10 w-10 object-cover rounded\" />\n                    <div className=\"text-[10px] text-slate-500 font-mono\">\n                      Verification photography loaded successfully. Both label barcodes and double-stitch seams matching checklist guidelines.\n                    </div>\n                  </div>\n                )}\n              </div>\n            ))}\n          </div>\n\n          {/* Dialog Cargo simulation helper */}\n          {cargoUploadingOrderId && (\n            <div className=\"fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4\">\n              <div className=\"bg-white rounded-xl p-5 max-w-sm w-full space-y-4\">\n                <h4 className=\"font-bold text-slate-900 text-sm\">Packaging Verification Picture Upload</h4>\n                <p className=\"text-xs text-slate-500\">Take a quick verification photograph of packages to verify labels and seams before logistics forwarding.</p>\n                <div className=\"space-y-2\">\n                  <label className=\"text-xs font-bold text-slate-700 block\">Select Unsplash Package Photo URL:</label>\n                  <select\n                    value={mockPhotoUrl}\n                    onChange={(e) => setMockPhotoUrl(e.target.value)}\n                    className=\"w-full text-xs p-2 border rounded\"\n                  >\n                    <option value=\"https://images.unsplash.com/photo-1512418491533-31f0cf871861?q=80&w=400\">Cardboard box label proof</option>\n                    <option value=\"https://images.unsplash.com/photo-1566576912321-d58ded7a2144?q=80&w=400\">Stuffing packages inside box</option>\n                    <option value=\"https://images.unsplash.com/photo-1549195581-24430f577eb6?q=80&w=400\">Anatolian sewn textiles pile</option>\n                  </select>\n                </div>\n                <div className=\"flex justify-end gap-2 text-xs\">\n                  <button onClick={() => setCargoUploadingOrderId(null)} className=\"p-2 text-slate-500 font-semibold\">Cancel</button>\n                  <button onClick={() => uploadCargoProofPhoto(cargoUploadingOrderId)} className=\"p-2 bg-orange-600 text-white rounded font-bold\">Simulate Upload</button>\n                </div>\n              </div>\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* SOURCING SOP MASTER TABLE OF SERVICE GROUP B */}\n      <div className=\"bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm\">\n        <div className=\"bg-slate-900 p-4 text-white\">\n          <h4 className=\"text-sm font-bold font-display\">Section B Pipeline: Strategic Alignment, Logistics & Fulfillment SOP</h4>\n        </div>\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs border-collapse min-w-[1000px]\">\n            <thead>\n              <tr className=\"bg-slate-50 border-b border-slate-200 text-[10px] text-slate-400 uppercase tracking-widest font-mono\">\n                <th className=\"p-4 w-20\">Step ID</th>\n                <th className=\"p-4 w-1/4\">Activity Task</th>\n                <th className=\"p-4\">Owner</th>\n                <th className=\"p-4\">KPI Metric / SLA Timeout</th>\n                <th className=\"p-4\">Expected Outputs</th>\n                <th className=\"p-4\">Status</th>\n                <th className=\"p-4\">Storage Folder</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100\">\n              {currentSectionSteps.map(step => (\n                <tr key={step.id} className=\"hover:bg-slate-50/50 transition\">\n                  <td className=\"p-4\">\n                    <span className=\"font-mono font-bold bg-amber-50 text-amber-800 px-2.5 py-1 rounded\">\n                      {step.id}\n                    </span>\n                  </td>\n                  <td className=\"p-4\">\n                    <div className=\"font-bold text-slate-800\">{step.task}</div>\n                    <div className=\"text-[10px] text-slate-400 mt-0.5\">Req: {step.requester}</div>\n                  </td>\n                  <td className=\"p-4 font-semibold text-slate-600\">{step.taskOwner}</td>\n                  <td className=\"p-4\">\n                    <div className=\"text-slate-500 max-w-xs\">{step.kpiMetric}</div>\n                    <div className=\"text-[10px] text-slate-400 font-mono mt-0.5\">SLA: {step.kpiTimeDays} days</div>\n                  </td>\n                  <td className=\"p-4 text-slate-600 leading-tight\">{step.requiredOutputs}</td>\n                  <td className=\"p-4\">\n                    <select\n                      value={step.status}\n                      onChange={(e) => handleUpdateStatus(step.id, e.target.value as any)}\n                      className={`font-semibold py-1 px-2 rounded-full border cursor-pointer focus:outline-none text-[11px] ${\n                        step.status === \"Completed\"\n                          ? \"bg-green-100 text-green-800 border-green-200\"\n                          : step.status === \"In Progress\"\n                          ? \"bg-blue-100 text-blue-800 border-blue-200\"\n                          : \"bg-slate-100 text-slate-700 border-slate-200\"\n                      }`}\n                    >\n                      <option value=\"Completed\">Completed</option>\n                      <option value=\"In Progress\">In Progress</option>\n                      <option value=\"Pending\">Pending</option>\n                    </select>\n                  </td>\n                  <td className=\"p-4 font-mono text-slate-500 truncate max-w-[150px]\">{step.storageLocation}</td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    }
