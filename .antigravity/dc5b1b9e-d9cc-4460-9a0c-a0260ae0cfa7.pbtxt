    replacement_chunks {
      target_content: "        {/* Trade2Turkey Welcome Hero Billboard Jumbotron */}\n        <div className=\"bg-gradient-to-r from-orange-600 via-orange-500 to-amber-600 rounded-3xl p-6 md:p-8 text-white shadow-xl shadow-orange-600/10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 relative overflow-hidden\">\n          {/* Subtle geometric lines */}\n          <div className=\"absolute right-0 top-0 bottom-0 w-1/3 bg-white/5 skew-x-12 transform origin-top-right pointer-events-none\" />\n          \n          <div className=\"space-y-2 max-w-2xl\">\n            <span className=\"bg-orange-850 text-orange-200 text-[10px] font-extrabold uppercase font-mono px-3 py-1 rounded-full tracking-wider border border-orange-500/30 flex items-center gap-1.5 w-fit\">\n              <ShieldCheck className=\"h-3 w-3 text-orange-300\" />\n              {currentUser.role === \'owner\' ? \"Trade2Turkey Admin Desk\" : `${currentUser.companyName} Secure Workspace`}\n            </span>\n            <h2 className=\"text-2xl md:text-3xl font-black font-display tracking-tight leading-tight\">\n              {currentUser.role === \"owner\" \n                ? \"Sourcing Pipeline Auditor Command Panel\" \n                : `${currentUser.companyName} Document Vault`}\n            </h2>\n            <p className=\"text-xs md:text-sm text-orange-50/90 leading-relaxed font-normal\">\n              {currentUser.role === \"owner\"\n                ? \"Monitor corporate pipelines, review specific Google Drive folder synchronizations, add custom workspaces, and evaluate Turkish factories.\"\n                : `Welcome to your isolated secure portal. Accessing exclusive Google Drive folders, shipment tracking maps, and transparent component costing sheets assigned to Project ID: ${activeProjectId}`}\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-3 shrink-0\">\n            {/* Active Workspace Status */}\n            <div className=\"bg-white/10 backdrop-blur-sm border border-white/10 px-4 py-3 rounded-2xl text-center min-w-[130px] font-mono\">\n              <span className=\"block text-[10px] uppercase font-bold text-orange-200\">Active Workspace</span>\n              <strong className=\"text-sm font-extrabold\">{activeProjectId}</strong>\n            </div>\n\n            <button\n              id=\"quick-trigger-report\"\n              onClick={() => {\n                setCurrentTab(\"report\");\n                setActiveMinorSheetKey(null);\n              }}\n              className=\"px-4.5 py-3 rounded-xl bg-slate-900 border border-slate-950 font-bold text-xs hover:bg-black transition-all flex items-center gap-1.5 shadow-md shadow-slate-950/20 cursor-pointer\"\n            >\n              <FileSpreadsheet className=\"h-4 w-4 text-orange-500\" /> Export Auditor Report\n            </button>\n          </div>\n        </div>\n\n        {/* OWNER-ONLY: CORPORATE TENANT MANAGEMENT DESK */}\n        {currentUser.role === \"owner\" && (\n          <div id=\"admin-workspace-container\" className=\"bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-6\">\n            <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-slate-100 pb-4\">\n              <div>\n                <h4 className=\"text-base font-bold text-slate-900 flex items-center gap-2 font-display\">\n                  <Users className=\"h-5 w-5 text-orange-600\" /> Corporate Client Workspaces & Tenant Administration\n                </h4>\n                <p className=\"text-xs text-slate-500 mt-1\">\n                  Create isolated workflows, map custom Google Drive directories, and audit active users instantly.\n                </p>\n              </div>\n              <span className=\"text-[10px] bg-amber-50 text-amber-800 font-extrabold px-3 py-1 rounded-full border border-amber-200 uppercase font-mono tracking-wider\">\n                Multi-Tenant Sync Active\n              </span>\n            </div>\n\n            {adminFeedback && (\n              <div className=\"bg-orange-50 border border-orange-100 text-orange-850 text-xs p-4 rounded-2xl font-mono leading-relaxed shadow-inner\">\n                {adminFeedback}\n              </div>\n            )}\n\n            {/* Admin actions grid */}\n            <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n              \n              {/* Form: Add New Corporate Client */}\n              <form onSubmit={handleAddClientAction} className=\"lg:col-span-5 bg-slate-50 p-5 rounded-2xl border border-slate-150 space-y-4\">\n                <div className=\"flex items-center gap-2 text-slate-800 font-bold text-xs uppercase font-mono tracking-wider\">\n                  <PlusCircle className=\"h-4.5 w-4.5 text-orange-600\" /> Provision Corporate Workspace\n                </div>\n\n                <div className=\"space-y-3.5\">\n                  <div className=\"space-y-1.5\">\n                    <label className=\"block text-[10px] font-bold text-slate-500 uppercase tracking-wide\">Client Company Name</label>\n                    <input\n                      type=\"text\"\n                      required\n                      placeholder=\"e.g., Luxury Lounge Inc.\"\n                      value={newClientCompany}\n                      onChange={(e) => setNewClientCompany(e.target.value)}\n                      className=\"w-full p-2.5 bg-white border rounded-xl text-xs text-slate-850 placeholder:text-slate-400 focus:outline-none focus:border-orange-500 transition\"\n                    />\n                  </div>\n\n                  <div className=\"space-y-1.5\">\n                    <label className=\"block text-[10px] font-bold text-slate-500 uppercase tracking-wide\">Company Corporate Email</label>\n                    <div className=\"relative\">\n                      <Mail className=\"absolute left-3 top-2.5 h-4 w-4 text-slate-400\" />\n                      <input\n                        type=\"email\"\n                        required\n                        placeholder=\"client@luxurytrousers.com\"\n                        value={newClientEmail}\n                        onChange={(e) => setNewClientEmail(e.target.value)}\n                        className=\"w-full pl-9 pr-3 py-2.5 bg-white border rounded-xl text-xs text-slate-850 placeholder:text-slate-400 focus:outline-none focus:border-orange-500 transition font-mono\"\n                      />\n                    </div>\n                  </div>\n\n                  <div className=\"space-y-1.5\">\n                    <label className=\"block text-[10px] font-bold text-slate-500 uppercase tracking-wide\">Assign Sourcing Pipeline Project</label>\n                    <select\n                      value={newClientProject}\n                      onChange={(e) => setNewClientProject(e.target.value)}\n                      className=\"w-full p-2.5 bg-white border rounded-xl text-xs text-slate-800 focus:outline-none focus:border-orange-500 transition font-mono font-bold\"\n                    >\n                      <option value=\"PROJ-BEANBAG\">PROJ-BEANBAG (ComfortPro Bean Bags)</option>\n                      <option value=\"PROJ-VELVET\">PROJ-VELVET (Luxury Velvet Ottoman)</option>\n                    </select>\n                  </div>\n\n                  <div className=\"p-3 bg-blue-50/50 border border-blue-100 rounded-xl text-[11px] leading-relaxed text-blue-800\">\n                    \360\237\222\241 <strong>Password Convention:</strong> The access password is auto-configured as email prefix name + \"2026\". (e.g., if email is <code>client@company.com</code>, password is <code>client2026</code>).\n                  </div>\n\n                  <button\n                    type=\"submit\"\n                    className=\"w-full bg-slate-900 border border-slate-950 text-white hover:bg-black font-semibold text-xs py-3 rounded-xl transition cursor-pointer shadow-sm\"\n                  >\n                    Generate Secure Isolation Workspace\n                  </button>\n                </div>\n              </form>\n\n              {/* Grid: View and switch between active corporate clients */}\n              <div className=\"lg:col-span-7 space-y-3\">\n                <span className=\"block text-[10px] font-bold text-slate-400 uppercase tracking-wider font-mono\">Active Registered Client Workspaces</span>\n                \n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3 max-h-[360px] overflow-y-auto pr-1\">\n                  {allCurrentTenantsList.map((tenant) => {\n                    const isViewing = activeProjectId === tenant.projectId;\n                    return (\n                      <div\n                        key={tenant.id}\n                        className={`p-4 rounded-2xl border transition flex flex-col justify-between gap-3 ${\n                          isViewing\n                            ? \"bg-slate-950 text-white border-slate-950 shadow-md\"\n                            : \"bg-white text-slate-800 border-slate-200 hover:border-slate-300\"\n                        }`}\n                      >\n                        <div className=\"space-y-1\">\n                          <div className=\"flex items-center justify-between\">\n                            <h5 className=\"text-xs font-bold font-display truncate max-w-[170px]\">\n                              {tenant.companyName}\n                            </h5>\n                            <span className={`text-[9px] font-extrabold px-1.5 py-0.5 rounded font-mono ${\n                              tenant.projectId === \"PROJ-BEANBAG\"\n                                ? \"bg-orange-500/10 text-orange-400\"\n                                : \"bg-teal-500/10 text-teal-400\"\n                            }`}>\n                              {tenant.projectId}\n                            </span>\n                          </div>\n                          <span className={`block text-[10px] font-mono truncate ${isViewing ? \"text-slate-400\" : \"text-slate-500\"}`}>\n                            {tenant.email}\n                          </span>\n                        </div>\n\n                        <div className=\"flex items-center justify-between border-t border-slate-800/10 pt-2.5 mt-1 select-none\">\n                          <span className={`text-[10px] font-mono ${isViewing ? \"text-emerald-400 font-bold\" : \"text-slate-400\"}`}>\n                            {isViewing ? \"\342\227\217 Active Inspection\" : \"Inactive Inspect\"}\n                          </span>\n                          \n                          <button\n                            type=\"button\"\n                            onClick={() => handleAdminInspectClient(tenant)}\n                            className={`px-2.5 py-1 rounded text-[10px] font-bold cursor-pointer transition ${\n                              isViewing\n                                ? \"bg-orange-600 hover:bg-orange-500 text-white\"\n                                : \"bg-slate-100 hover:bg-slate-200 text-slate-700\"\n                            }`}\n                          >\n                            Inspect Workspace\n                          </button>\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n\n                <div className=\"p-3.5 bg-orange-50/50 border border-orange-100 rounded-2xl flex gap-2.5 text-xs text-orange-900 leading-relaxed\">\n                  <ShieldCheck className=\"h-5 w-5 text-orange-600 mt-0.5 shrink-0\" />\n                  <div>\n                    <strong>Dual-Stitch Security Policy Enforcement:</strong> SofaStyle and Velvet Lounge users remain perfectly compartmentalized. When a user with the corporate credentials of SofaStyle logs in, they are locked to Project ID list filters. They cannot access, browse, or perform uploads to alternate pipelines.\n                  </div>\n                </div>\n              </div>\n\n            </div>\n          </div>\n        )}"
      replacement_content: "        {/* Trade2Turkey Welcome Hero Billboard Jumbotron */}\n        <div className=\"bg-gradient-to-r from-navy via-navy-light to-black rounded-3xl p-6 md:p-8 text-white shadow-xl shadow-navy/10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 relative overflow-hidden\">\n          {/* Subtle geometric lines */}\n          <div className=\"absolute right-0 top-0 bottom-0 w-1/3 bg-white/5 skew-x-12 transform origin-top-right pointer-events-none\" />\n          \n          <div className=\"space-y-2 max-w-2xl\">\n            <span className=\"bg-black/40 text-sky-200 text-[10px] font-extrabold uppercase font-mono px-3 py-1 rounded-full tracking-wider border border-white/10 flex items-center gap-1.5 w-fit\">\n              <ShieldCheck className=\"h-3 w-3 text-sky-300\" />\n              {currentUser.role === \'owner\' ? \"Trade2Turkey Admin Desk\" : `${currentUser.companyName} Secure Workspace`}\n            </span>\n            <h2 className=\"text-2xl md:text-3xl font-black font-display tracking-tight leading-tight\">\n              {currentUser.role === \"owner\" \n                ? \"Sourcing Pipeline Auditor Command Panel\" \n                : `${currentUser.companyName} Document Vault`}\n            </h2>\n            <p className=\"text-xs md:text-sm text-slate-300 leading-relaxed font-normal\">\n              {currentUser.role === \"owner\"\n                ? \"Monitor corporate pipelines, review specific Google Drive folder synchronizations, add custom workspaces, and evaluate Turkish factories with data-driven operational precision.\"\n                : `Welcome to your isolated secure portal. Accessing exclusive Google Drive folders, shipment tracking maps, and transparent component costing sheets assigned to Project ID: ${activeProjectId}`}\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-3 shrink-0\">\n            {/* Active Workspace Status */}\n            <div className=\"bg-white/10 backdrop-blur-sm border border-white/10 px-4 py-3 rounded-2xl text-center min-w-[130px] font-mono\">\n              <span className=\"block text-[10px] uppercase font-bold text-sky-300\">Active Workspace</span>\n              <strong className=\"text-sm font-extrabold\">{activeProjectId}</strong>\n            </div>\n\n            <button\n              id=\"quick-trigger-report\"\n              onClick={() => {\n                setCurrentTab(\"report\");\n                setActiveMinorSheetKey(null);\n              }}\n              className=\"px-4.5 py-3 rounded-xl bg-white text-navy hover:bg-slate-100 transition-all font-bold text-xs flex items-center gap-1.5 shadow-md shadow-white/5 cursor-pointer\"\n            >\n              <FileSpreadsheet className=\"h-4 w-4 text-navy\" /> Export Auditor Report\n            </button>\n          </div>\n        </div>\n\n        {/* OWNER-ONLY: CORPORATE TENANT MANAGEMENT DESK */}\n        {currentUser.role === \"owner\" && (\n          <div id=\"admin-workspace-container\" className=\"bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-6\">\n            <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-slate-100 pb-4\">\n              <div>\n                <h4 className=\"text-base font-bold text-slate-900 flex items-center gap-2 font-display\">\n                  <Users className=\"h-5 w-5 text-navy\" /> Corporate Client Workspaces & Tenant Administration\n                </h4>\n                <p className=\"text-xs text-slate-500 mt-1\">\n                  Create isolated workflows, map custom Google Drive directories, and audit active users instantly.\n                </p>\n              </div>\n              <span className=\"text-[10px] bg-navy/5 text-navy font-extrabold px-3 py-1 rounded-full border border-navy/10 uppercase font-mono tracking-wider\">\n                Multi-Tenant Sync Active\n              </span>\n            </div>\n\n            {adminFeedback && (\n              <div className=\"bg-slate-50 border border-slate-200 text-slate-850 text-xs p-4 rounded-2xl font-mono leading-relaxed shadow-inner\">\n                {adminFeedback}\n              </div>\n            )}\n\n            {/* Admin actions grid */}\n            <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n              \n              {/* Form: Add New Corporate Client */}\n              <form onSubmit={handleAddClientAction} className=\"lg:col-span-5 bg-slate-50 p-5 rounded-2xl border border-slate-150 space-y-4\">\n                <div className=\"flex items-center gap-2 text-slate-800 font-bold text-xs uppercase font-mono tracking-wider\">\n                  <PlusCircle className=\"h-4.5 w-4.5 text-navy\" /> Provision Corporate Workspace\n                </div>\n\n                <div className=\"space-y-3.5\">\n                  <div className=\"space-y-1.5\">\n                    <label className=\"block text-[10px] font-bold text-slate-500 uppercase tracking-wide\">Client Company Name</label>\n                    <input\n                      type=\"text\"\n                      required\n                      placeholder=\"e.g., Luxury Lounge Inc.\"\n                      value={newClientCompany}\n                      onChange={(e) => setNewClientCompany(e.target.value)}\n                      className=\"w-full p-2.5 bg-white border rounded-xl text-xs text-slate-850 placeholder:text-slate-400 focus:outline-none focus:border-navy transition\"\n                    />\n                  </div>\n\n                  <div className=\"space-y-1.5\">\n                    <label className=\"block text-[10px] font-bold text-slate-500 uppercase tracking-wide\">Company Corporate Email</label>\n                    <div className=\"relative\">\n                      <Mail className=\"absolute left-3 top-2.5 h-4 w-4 text-slate-400\" />\n                      <input\n                        type=\"email\"\n                        required\n                        placeholder=\"client@luxurytrousers.com\"\n                        value={newClientEmail}\n                        onChange={(e) => setNewClientEmail(e.target.value)}\n                        className=\"w-full pl-9 pr-3 py-2.5 bg-white border rounded-xl text-xs text-slate-850 placeholder:text-slate-400 focus:outline-none focus:border-navy transition font-mono\"\n                      />\n                    </div>\n                  </div>\n\n                  <div className=\"space-y-1.5\">\n                    <label className=\"block text-[10px] font-bold text-slate-500 uppercase tracking-wide\">Assign Sourcing Pipeline Project</label>\n                    <select\n                      value={newClientProject}\n                      onChange={(e) => setNewClientProject(e.target.value)}\n                      className=\"w-full p-2.5 bg-white border rounded-xl text-xs text-slate-800 focus:outline-none focus:border-navy transition font-mono font-bold\"\n                    >\n                      <option value=\"PROJ-BEANBAG\">PROJ-BEANBAG (ComfortPro Bean Bags)</option>\n                      <option value=\"PROJ-VELVET\">PROJ-VELVET (Luxury Velvet Ottoman)</option>\n                    </select>\n                  </div>\n\n                  <div className=\"p-3 bg-slate-100 border border-slate-200 rounded-xl text-[11px] leading-relaxed text-slate-700\">\n                    \360\237\222\241 <strong>Password Convention:</strong> The access password is auto-configured as email prefix name + \"2026\". (e.g., if email is <code>client@company.com</code>, password is <code>client2026</code>).\n                  </div>\n\n                  <button\n                    type=\"submit\"\n                    className=\"w-full bg-navy hover:bg-navy-light text-white font-semibold text-xs py-3 rounded-xl transition cursor-pointer shadow-sm\"\n                  >\n                    Generate Secure Isolation Workspace\n                  </button>\n                </div>\n              </form>\n\n              {/* Grid: View and switch between active corporate clients */}\n              <div className=\"lg:col-span-7 space-y-3\">\n                <span className=\"block text-[10px] font-bold text-slate-400 uppercase tracking-wider font-mono\">Active Registered Client Workspaces</span>\n                \n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3 max-h-[360px] overflow-y-auto pr-1\">\n                  {allCurrentTenantsList.map((tenant) => {\n                    const isViewing = activeProjectId === tenant.projectId;\n                    return (\n                      <div\n                        key={tenant.id}\n                        className={`p-4 rounded-2xl border transition flex flex-col justify-between gap-3 ${\n                          isViewing\n                            ? \"bg-navy text-white border-navy shadow-md\"\n                            : \"bg-white text-slate-800 border-slate-200 hover:border-slate-300\"\n                        }`}\n                      >\n                        <div className=\"space-y-1\">\n                          <div className=\"flex items-center justify-between\">\n                            <h5 className=\"text-xs font-bold font-display truncate max-w-[170px]\">\n                              {tenant.companyName}\n                            </h5>\n                            <span className={`text-[9px] font-extrabold px-1.5 py-0.5 rounded font-mono ${\n                              tenant.projectId === \"PROJ-BEANBAG\"\n                                ? \"bg-navy-light/20 text-sky-600\"\n                                : \"bg-teal-500/10 text-teal-600\"\n                            }`}>\n                              {tenant.projectId}\n                            </span>\n                          </div>\n                          <span className={`block text-[10px] font-mono truncate ${isViewing ? \"text-slate-200\" : \"text-slate-500\"}`}>\n                            {tenant.email}\n                          </span>\n                        </div>\n\n                        <div className=\"flex items-center justify-between border-t border-slate-250/10 pt-2.5 mt-1 select-none\">\n                          <span className={`text-[10px] font-mono ${isViewing ? \"text-sky-300 font-bold\" : \"text-slate-400\"}`}>\n                            {isViewing ? \"\342\227\217 Active Inspection\" : \"Inactive Inspect\"}\n                          </span>\n                          \n                          <button\n                            type=\"button\"\n                            onClick={() => handleAdminInspectClient(tenant)}\n                            className={`px-2.5 py-1 rounded text-[10px] font-bold cursor-pointer transition ${\n                              isViewing\n                                ? \"bg-white hover:bg-slate-150 text-navy\"\n                                : \"bg-slate-100 hover:bg-slate-200 text-slate-700\"\n                            }`}\n                          >\n                            Inspect Workspace\n                          </button>\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n\n                <div className=\"p-3.5 bg-slate-50 border border-slate-200 rounded-2xl flex gap-2.5 text-xs text-slate-800 leading-relaxed font-sans\">\n                  <ShieldCheck className=\"h-5 w-5 text-navy mt-0.5 shrink-0\" />\n                  <div>\n                    <strong>Dual-Stitch Security Policy Enforcement:</strong> SofaStyle and Velvet Lounge users remain perfectly compartmentalized. When a user with the corporate credentials of SofaStyle logs in, they are locked to Project ID list filters. They cannot access, browse, or perform uploads to alternate pipelines.\n                  </div>\n       