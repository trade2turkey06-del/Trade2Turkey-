      target_content: "  return (\n    <div id=\"login-layout-wrapper\" className=\"min-h-screen bg-slate-900 flex items-center justify-center p-4 selection:bg-orange-500 selection:text-white relative overflow-hidden\">\n      {/* Background radial soft light blobs */}\n      <div className=\"absolute top-[-20%] left-[-10%] w-[50%] h-[50%] rounded-full bg-orange-600/10 blur-[130px] pointer-events-none\" />\n      <div className=\"absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-amber-600/10 blur-[130px] pointer-events-none\" />\n\n      <div id=\"login-card-container\" className=\"relative w-full max-w-lg bg-slate-950/70 backdrop-blur-md rounded-3xl border border-slate-800 p-8 shadow-2xl space-y-8\">\n        \n        {/* Brand Logotype */}\n        <div className=\"text-center space-y-2\">\n          <div className=\"inline-flex items-center justify-center h-14 w-14 rounded-2xl bg-gradient-to-tr from-orange-600 to-amber-500 text-white shadow-lg shadow-orange-500/20\">\n            <ShieldCheck className=\"h-7 w-7\" />\n          </div>\n          <div>\n            <h1 className=\"text-xl font-extrabold text-white tracking-tight font-display\">Secure Sourcing Cloud Sync</h1>\n            <p className=\"text-xs text-slate-400 mt-1 max-w-sm mx-auto\">\n              Trade2Turkey multi-tenant standard operating procedures evidence & Google Drive isolation system.\n            </p>\n          </div>\n        </div>\n\n        {errorMessage && (\n          <div id=\"login-alert-pane\" className=\"bg-red-500/10 border border-red-500/20 text-red-300 text-xs p-3.5 rounded-xl font-medium leading-relaxed\">\n            {errorMessage}\n          </div>\n        )}\n\n        <form onSubmit={handleLoginSubmit} className=\"space-y-4\">\n          <div className=\"space-y-1.5\">\n            <label className=\"block text-[11px] font-bold text-slate-400 uppercase tracking-wider font-mono\">Company Email Address</label>\n            <div className=\"relative\">\n              <Mail className=\"absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-500\" />\n              <input\n                id=\"login-email-input\"\n                type=\"email\"\n                required\n                placeholder=\"client@company.com\"\n                value={email}\n                onChange={(e) => setEmail(e.target.value)}\n                className=\"w-full pl-10 pr-4 py-3 bg-slate-900 border border-slate-800 rounded-xl text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500/30 transition font-mono\"\n              />\n            </div>\n          </div>\n\n          <div className=\"space-y-1.5\">\n            <label className=\"block text-[11px] font-bold text-slate-400 uppercase tracking-wider font-mono\">Secure Access Password</label>\n            <div className=\"relative\">\n              <Lock className=\"absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-500\" />\n              <input\n                id=\"login-password-input\"\n                type={showPassword ? \"text\" : \"password\"}\n                required\n                placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                value={password}\n                onChange={(e) => setPassword(e.target.value)}\n                className=\"w-full pl-10 pr-10 py-3 bg-slate-900 border border-slate-800 rounded-xl text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500/30 transition font-mono\"\n              />\n              <button\n                type=\"button\"\n                id=\"toggle-password-visibility\"\n                onClick={() => setShowPassword(!showPassword)}\n                className=\"absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 hover:text-slate-300 cursor-pointer p-1 rounded\"\n              >\n                {showPassword ? <EyeOff className=\"h-4 w-4\" /> : <Eye className=\"h-4 w-4\" />}\n              </button>\n            </div>\n          </div>\n\n          <button\n            type=\"submit\"\n            id=\"login-submit-btn\"\n            disabled={loading}\n            className=\"w-full mt-2 bg-gradient-to-r from-orange-600 to-amber-600 hover:from-orange-500 hover:to-amber-500 text-white text-xs font-bold py-3.5 rounded-xl transition-all shadow-lg shadow-orange-600/10 flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50\"\n          >\n            {loading ? (\n              <>\n                <Loader2 className=\"h-4 w-4 animate-spin text-white\" /> Loading Secure Workspace...\n              </>\n            ) : (\n              <>\n                Verify Corporate Identity <ChevronRight className=\"h-4 w-4\" />\n              </>\n            )}\n          </button>\n        </form>\n\n        {/* Client switcher helper section */}\n        <div id=\"quick-login-sandbox\" className=\"border-t border-slate-800/80 pt-5 space-y-3\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[10px] uppercase font-bold text-slate-500 font-mono tracking-wider\">PRESET SANDBOX CLIENTS</span>\n            <span className=\"text-[9px] text-orange-400 font-semibold uppercase bg-orange-950/50 px-2 py-0.5 rounded border border-orange-500/10\">Quick Sandbox Demo</span>\n          </div>\n\n          <div className=\"grid grid-cols-1 gap-2.5\">\n            <button\n              type=\"button\"\n              id=\"fill-client-a\"\n              onClick={() => handleQuickFill(\"sofastyle@trade2turkey.com\")}\n              className=\"flex justify-between items-center text-left text-[11px] p-2.5 bg-slate-900 hover:bg-slate-850 border border-slate-800 rounded-xl text-slate-300 hover:text-white transition group cursor-pointer\"\n            >\n              <div>\n                <strong className=\"block text-slate-200\">SofaStyle Furnishings (Client A)</strong>\n                <span className=\"text-slate-500 font-mono\">sofastyle@trade2turkey.com</span>\n              </div>\n              <span className=\"text-[9px] bg-slate-800 px-1.5 py-0.5 rounded text-orange-400 group-hover:bg-orange-500 group-hover:text-white transition font-mono\">\n                Fill\n              </span>\n            </button>\n\n            <button\n              type=\"button\"\n              id=\"fill-client-b\"\n              onClick={() => handleQuickFill(\"velvetlounge@trade2turkey.com\")}\n              className=\"flex justify-between items-center text-left text-[11px] p-2.5 bg-slate-900 hover:bg-slate-850 border border-slate-800 rounded-xl text-slate-300 hover:text-white transition group group cursor-pointer\"\n            >\n              <div>\n                <strong className=\"block text-slate-200\">Velvet Lounge Interiors (Client B)</strong>\n                <span className=\"text-slate-500 font-mono\">velvetlounge@trade2turkey.com</span>\n              </div>\n              <span className=\"text-[9px] bg-slate-800 px-1.5 py-0.5 rounded text-orange-400 group-hover:bg-orange-500 group-hover:text-white transition font-mono\">\n                Fill\n              </span>\n            </button>\n\n            <button\n              type=\"button\"\n              id=\"fill-owner-admin\"\n              onClick={() => handleQuickFill(\"trade2turkey06@gmail.com\")}\n              className=\"flex justify-between items-center text-left text-[11px] p-2.5 bg-slate-900 hover:bg-slate-850 border border-slate-800 rounded-xl text-slate-300 hover:text-white transition group cursor-pointer\"\n            >\n              <div>\n                <strong className=\"block text-slate-200\">Trade2Turkey Owner (Owner Desk)</strong>\n                <span className=\"text-slate-500 font-mono\">trade2turkey06@gmail.com</span>\n              </div>\n              <span className=\"text-[9px] bg-slate-800 px-1.5 py-0.5 rounded text-orange-400 group-hover:bg-orange-500 group-hover:text-white transition font-mono\">\n                Fill\n              </span>\n            </button>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );"
      replacement_content: "  return (\n    <div id=\"login-layout-wrapper\" className=\"min-h-screen bg-neutral-950 flex items-center justify-center p-4 selection:bg-navy selection:text-white relative overflow-hidden\">\n      {/* Background radial soft light blobs of Navy Ink */}\n      <div className=\"absolute top-[-20%] left-[-10%] w-[60%] h-[60%] rounded-full bg-navy/20 blur-[130px] pointer-events-none\" />\n      <div className=\"absolute bottom-[-10%] right-[-10%] w-[60%] h-[60%] rounded-full bg-navy/15 blur-[130px] pointer-events-none\" />\n\n      <div id=\"login-card-container\" className=\"relative w-full max-w-lg bg-neutral-900/80 backdrop-blur-xl rounded-3xl border border-neutral-800 p-8 shadow-2xl space-y-8\">\n        \n        {/* Brand Logotype & Vector Custom Globe */}\n        <div className=\"text-center space-y-3\">\n          <div className=\"relative inline-flex items-center justify-center h-24 w-24 rounded-full bg-navy/10 border border-neutral-800 mb-1\">\n            <svg className=\"h-20 w-20 mx-auto\" viewBox=\"0 0 100 100\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n              {/* Base sphere */}\n              <circle cx=\"50\" cy=\"50\" r=\"38\" fill=\"url(#globeGradient)\" opacity=\"0.95\" />\n              {/* Network lines */}\n              <circle cx=\"50\" cy=\"50\" r=\"30\" stroke=\"#38bdf8\" strokeWidth=\"0.5\" strokeDasharray=\"4 3\" opacity=\"0.3\" />\n              <circle cx=\"50\" cy=\"50\" r=\"22\" stroke=\"#22d3ee\" strokeWidth=\"0.5\" strokeDasharray=\"3 3\" opacity=\"0.4\" />\n              {/* Ellipses representing orbits */}\n              <ellipse cx=\"50\" cy=\"50\" rx=\"38\" ry=\"14\" stroke=\"#38bdf8\" strokeWidth=\"0.75\" transform=\"rotate(-30 50 50)\" opacity=\"0.7\" />\n              <ellipse cx=\"50\" cy=\"50\" rx=\"38\" ry=\"14\" stroke=\"#22d3ee\" strokeWidth=\"0.75\" transform=\"rotate(30 50 50)\" opacity=\"0.7\" />\n              {/* Connecting network web lines */}\n              <line x1=\"28\" y1=\"35\" x2=\"72\" y2=\"65\" stroke=\"#ffffff\" strokeWidth=\"0.4\" opacity=\"0.4\" />\n              <line x1=\"28\" y1=\"65\" x2=\"72\" y2=\"35\" stroke=\"#ffffff\" strokeWidth=\"0.4\" opacity=\"0.4\" />\n              <line x1=\"50\" y1=\"14\" x2=\"50\" y2=\"86\" stroke=\"#38bdf8\" strokeWidth=\"0.4\" opacity=\"0.3\" />\n              {/* Glowing nodes */}\n              <circle cx=\"28\" cy=\"35\" r=\"2\" fill=\"#ffffff\" />\n              <circle cx=\"28\" cy=\"35\" r=\"4\" stroke=\"#38bdf8\" strokeWidth=\"0.5\" opacity=\"0.6\" />\n              <circle cx=\"72\" cy=\"65\" r=\"2\" fill=\"#38bdf8\" />\n              <circle cx=\"50\" cy=\"20\" r=\"1.5\" fill=\"#22d3ee\" />\n              <circle cx=\"50\" cy=\"80\" r=\"1.5\" fill=\"#38bdf8\" />\n              <circle cx=\"72\" cy=\"35\" r=\"2.5\" fill=\"#ffffff\" />\n              <circle cx=\"72\" cy=\"35\" r=\"5\" stroke=\"#ffffff\" strokeWidth=\"0.5\" opacity=\"0.5\" />\n              <circle cx=\"28\" cy=\"65\" r=\"2\" fill=\"#22d3ee\" />\n              <circle cx=\"50\" cy=\"50\" r=\"3\" fill=\"#ffffff\" />\n              <circle cx=\"50\" cy=\"50\" r=\"7\" stroke=\"#ffffff\" strokeWidth=\"0.5\" opacity=\"0.4\" />\n              <circle cx=\"38\" cy=\"48\" r=\"1\" fill=\"#e0f2fe\" />\n              <circle cx=\"62\" cy=\"52\" r=\"1\" fill=\"#e0f2fe\" />\n              \n              <defs>\n                <radialGradient id=\"globeGradient\" cx=\"0\" cy=\"0\" r=\"1\" gradientUnits=\"userSpaceOnUse\" transform=\"translate(42 42) rotate(45) scale(46)\">\n                  <stop offset=\"0%\" stopColor=\"#22d3ee\" />\n                  <stop offset=\"60%\" stopColor=\"#1B3058\" />\n                  <stop offset=\"100%\" stopColor=\"#000000\" />\n                </radialGradient>\n              </defs>\n            </svg>\n          </div>\n          <div>\n            <h1 className=\"text-2xl font-black text-white tracking-tight font-display\">Trade2Turkey</h1>\n            <p className=\"text-[10px] text-sky-400 font-extrabold uppercase tracking-widest font-mono\">\n              Digital Workflows, Disciplined Sourcing\n            </p>\n            <p className=\"text-xs italic text-neutral-400 mt-2 max-w-sm mx-auto font-sans\">\n              \"Where data meets manufacturing reality.\"\n            </p>\n          </div>\n        </div>\n\n        {errorMessage && (\n          <div id=\"login-alert-pane\" className=\"bg-red-500/10 border border-red-500/20 text-red-300 text-xs p-3.5 rounded-xl font-medium leading-relaxed font-mono\">\n            {errorMessage}\n          </div>\n        )}\n\n        <form onSubmit={handleLoginSubmit} className=\"space-y-4\">\n          <div className=\"space-y-1.5 font-sans\">\n            <label className=\"block text-[10px] font-bold text-neutral-400 uppercase tracking-wider font-mono\">Corporate Email Address</label>\n            <div className=\"relative\">\n              <Mail className=\"absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-neutral-500\" />\n              <input\n                id=\"login-email-input\"\n                type=\"email\"\n                required\n                placeholder=\"client@trade2turkey.com\"\n                value={email}\n                onChange={(e) => setEmail(e.target.value)}\n                className=\"w-full pl-10 pr-4 py-3 bg-neutral-950 border border-neutral-800 rounded-xl text-sm text-neutral-100 placeholder:text-neutral-600 focus:outline-none focus:border-navy focus:ring-1 focus:ring-navy/30 transition font-mono\"\n              />\n            </div>\n          </div>\n\n          <div className=\"space-y-1.5 font-sans\">\n            <label className=\"block text-[10px] font-bold text-neutral-400 uppercase tracking-wider font-mono\">Secure Access Password</label>\n            <div className=\"relative\">\n              <Lock className=\"absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-neutral-500\" />\n              <input\n                id=\"login-password-input\"\n                type={showPassword ? \"text\" : \"password\"}\n                required\n                placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                value={password}\n                onChange={(e) => setPassword(e.target.value)}\n                className=\"w-full pl-10 pr-10 py-3 bg-neutral-950 border border-neutral-800 rounded-xl text-sm text-neutral-100 placeholder:text-neutral-600 focus:outline-none focus:border-navy focus:ring-1 focus:ring-navy/30 transition font-mono\"\n              />\n              <button\n                type=\"button\"\n                id=\"toggle-password-visibility\"\n                onClick={() => setShowPassword(!showPassword)}\n                className=\"absolute right-3 top-1/2 -translate-y-1/2 text-neutral-550 hover:text-neutral-300 cursor-pointer p-1 rounded\"\n              >\n                {showPassword ? <EyeOff className=\"h-4 w-4\" /> : <Eye className=\"h-4 w-4\" />}\n              </button>\n            </div>\n          </div>\n\n          <button\n            type=\"submit\"\n            id=\"login-submit-btn\"\n            disabled={loading}\n            className=\"w-full mt-2 bg-navy hover:bg-navy-light text-white text-xs font-bold py-3.5 rounded-xl transition-all shadow-lg shadow-navy/20 flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50 font-sans\"\n          >\n            {loading ? (\n              <>\n                <Loader2 className=\"h-4 w-4 animate-spin text-white\" /> Loading Secure Workspace...\n              </>\n            ) : (\n              <>\n                Verify Corporate Identity <ChevronRight className=\"h-4 w-4\" />\n              </>\n            )}\n          </button>\n        </form>\n\n        {/* Client switcher helper section */}\n        <div id=\"quick-login-sandbox\" className=\"border-t border-neutral-800/80 pt-5 space-y-3\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[9px] uppercase font-bold text-neutral-500 font-mono tracking-wider\">PRESET SANBOX WORKSPACES</span>\n            <span className=\"text-[8px] text-sky-400 font-bold uppercase bg-navy/20 px-2 py-0.5 rounded border border-navy/20\">Secure Multi-Tenant</span>\n          </div>\n\n          <div className=\"grid grid-cols-1 gap-2\">\n            <button\n              type=\"button\"\n              id=\"fill-client-a\"\n              onClick={() => handleQuickFill(\"sofastyle@trade2turkey.com\")}\n              className=\"flex justify-between items-center text-left text-[11px] p-2 bg-neutral-950 hover:bg-neutral-800 border border-neutral-800/60 rounded-xl text-neutral-400 hover:text-white transition group cursor-pointer\"\n            >\n              <div>\n                <strong className=\"block text-neutral-200\">SofaStyle Furnishings (Client A)</strong>\n                <span className=\"text-neutral-500 font-mono text-[10px]\">sofastyle@trade2turkey.com</span>\n              </div>\n              <span className=\"text-[9px] bg-neutral-900 px-2 py-0.5 rounded text-sky-400 group-hover:bg-navy group-hover:text-white transition font-mono\">\n                Fill\n              </span>\n            </button>\n\n            <button\n              type=\"button\"\n              id=\"fill-client-b\"\n              onClick={() => handleQuickFill(\"velvetlounge@trade2turkey.com\")}\n              className=\"flex justify-between items-center text-left text-[11px] p-2 bg-neutral-950 hover:bg-neutral-800 border border-neutral-800/60 rounded-xl text-neutral-400 hover:text-white transition group cursor-pointer\"\n            >\n              <div>\n                <strong className=\"block text-neutral-200\">Velvet Lounge Interiors (Client B)</strong>\n                <span className=\"text-neutral-500 font-mono text-[10px]\">velvetlounge@trade2turkey.com</span>\n              </div>\n              <span className=\"text-[9px] bg-neutral-900 px-2 py-0.5 rounded text-sky-400 group-hover:bg-navy group-hover:text-white transition font-mono\">\n                Fill\n              </span>\n            </button>\n\n            <button\n              type=\"button\"\n              id=\"fill-owner-admin\"\n              onClick={() => handleQuickFill(\"trade2turkey06@gmail.com\")}\n              className=\"flex justify-between items-center text-left text-[11px] p-2 bg-neutral-950 hover:bg-neutral-800 border border-neutral-800/60 rounded-xl text-neutral-400 hover:text-white transition group cursor-pointer\"\n            >\n              <div>\n                <strong className=\"block text-neutral-200\">Trade2Turkey Admin (System Owner)</strong>\n                <span className=\"text-neutral-500 font-mono text-[10px]\">trade2turkey06@gmail.com</span>\n              </div>\n              <span className=\"text-[9px] bg-neutral-900 px-2 py-0.5 rounded text-sky-400 group-hover:bg-navy group-hover:text-white transition font-mono\">\n                Fill\n              </span>\n            </button>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );"
