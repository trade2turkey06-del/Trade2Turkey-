  file_change {
    absolute_path_uri: "file:///src/components/LoginScreen.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { UserTenant, PRESET_CREDENTIALS, INITIAL_TENANTS } from \"../data/usersData\";\nimport { ShieldCheck, Lock, Mail, ChevronRight, Eye, EyeOff, Loader2 } from \"lucide-react\";\n\ninterface LoginScreenProps {\n  onLoginSuccess: (user: UserTenant) => void;\n}\n\nexport default function LoginScreen({ onLoginSuccess }: LoginScreenProps) {\n  const [email, setEmail] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [showPassword, setShowPassword] = useState(false);\n  const [loading, setLoading] = useState(false);\n  const [errorMessage, setErrorMessage] = useState<string | null>(null);\n\n  // Quick fill preset credentials for convenient review\n  const handleQuickFill = (presetEmail: string) => {\n    setEmail(presetEmail);\n    const foundPreset = PRESET_CREDENTIALS[presetEmail];\n    if (foundPreset) {\n      setPassword(foundPreset.password);\n    }\n  };\n\n  const handleLoginSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!email || !password) {\n      setErrorMessage(\"Please enter both email and password.\");\n      return;\n    }\n\n    setErrorMessage(null);\n    setLoading(true);\n\n    // Simulate authenticating or contacting database/local presets\n    setTimeout(() => {\n      const lowerEmail = email.trim().toLowerCase();\n      const presetCred = PRESET_CREDENTIALS[lowerEmail];\n\n      if (presetCred && presetCred.password === password) {\n        // Find tenant mapping\n        const tenant = INITIAL_TENANTS.find(t => t.id === presetCred.id);\n        if (tenant) {\n          setLoading(false);\n          onLoginSuccess(tenant);\n          return;\n        }\n      }\n\n      // Check dynamic custom clients from local storage\n      try {\n        const storedCustomUsers = localStorage.getItem(\"t2t_custom_users\");\n        if (storedCustomUsers) {\n          const parsed = JSON.parse(storedCustomUsers) as UserTenant[];\n          const foundCustom = parsed.find(u => u.email.toLowerCase() === lowerEmail);\n          if (foundCustom) {\n            // Check matching password (if custom user, password is same as email name prefix for simplicity in demonstration)\n            const expectedPass = lowerEmail.split(\"@\")[0] + \"2026\";\n            if (password === expectedPass) {\n              setLoading(false);\n              onLoginSuccess(foundCustom);\n              return;\n            }\n          }\n        }\n      } catch (err) {\n        console.warn(\"Storage fetch failed\", err);\n      }\n\n      setLoading(false);\n      setErrorMessage(\"Invalid credentials. Try using the quick-fill assistance below!\");\n    }, 850);\n  };\n\n  return (\n    <div id=\"login-layout-wrapper\" className=\"min-h-screen bg-slate-900 flex items-center justify-center p-4 selection:bg-orange-500 selection:text-white relative overflow-hidden\">\n      {/* Background radial soft light blobs */}\n      <div className=\"absolute top-[-20%] left-[-10%] w-[50%] h-[50%] rounded-full bg-orange-600/10 blur-[130px] pointer-events-none\" />\n      <div className=\"absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-amber-600/10 blur-[130px] pointer-events-none\" />\n\n      <div id=\"login-card-container\" className=\"relative w-full max-w-lg bg-slate-950/70 backdrop-blur-md rounded-3xl border border-slate-800 p-8 shadow-2xl space-y-8\">\n        \n        {/* Brand Logotype */}\n        <div className=\"text-center space-y-2\">\n          <div className=\"inline-flex items-center justify-center h-14 w-14 rounded-2xl bg-gradient-to-tr from-orange-600 to-amber-500 text-white shadow-lg shadow-orange-500/20\">\n            <ShieldCheck className=\"h-7 w-7\" />\n          </div>\n          <div>\n            <h1 className=\"text-xl font-extrabold text-white tracking-tight font-display\">Secure Sourcing Cloud Sync</h1>\n            <p className=\"text-xs text-slate-400 mt-1 max-w-sm mx-auto\">\n              Trade2Turkey multi-tenant standard operating procedures evidence & Google Drive isolation system.\n            </p>\n          </div>\n        </div>\n\n        {errorMessage && (\n          <div id=\"login-alert-pane\" className=\"bg-red-500/10 border border-red-500/20 text-red-300 text-xs p-3.5 rounded-xl font-medium leading-relaxed\">\n            {errorMessage}\n          </div>\n        )}\n\n        <form onSubmit={handleLoginSubmit} className=\"space-y-4\">\n          <div className=\"space-y-1.5\">\n            <label className=\"block text-[11px] font-bold text-slate-400 uppercase tracking-wider font-mono\">Company Email Address</label>\n            <div className=\"relative\">\n              <Mail className=\"absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-500\" />\n              <input\n                id=\"login-email-input\"\n                type=\"email\"\n                required\n                placeholder=\"client@company.com\"\n                value={email}\n                onChange={(e) => setEmail(e.target.value)}\n                className=\"w-full pl-10 pr-4 py-3 bg-slate-900 border border-slate-800 rounded-xl text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500/30 transition font-mono\"\n              />\n            </div>\n          </div>\n\n          <div className=\"space-y-1.5\">\n            <label className=\"block text-[11px] font-bold text-slate-400 uppercase tracking-wider font-mono\">Secure Access Password</label>\n            <div className=\"relative\">\n              <Lock className=\"absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-500\" />\n              <input\n                id=\"login-password-input\"\n                type={showPassword ? \"text\" : \"password\"}\n                required\n                placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                value={password}\n                onChange={(e) => setPassword(e.target.value)}\n                className=\"w-full pl-10 pr-10 py-3 bg-slate-900 border border-slate-800 rounded-xl text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500/30 transition font-mono\"\n              />\n              <button\n                type=\"button\"\n                id=\"toggle-password-visibility\"\n                onClick={() => setShowPassword(!showPassword)}\n                className=\"absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 hover:text-slate-300 cursor-pointer p-1 rounded\"\n              >\n                {showPassword ? <EyeOff className=\"h-4 w-4\" /> : <Eye className=\"h-4 w-4\" />}\n              </button>\n            </div>\n          </div>\n\n          <button\n            type=\"submit\"\n            id=\"login-submit-btn\"\n            disabled={loading}\n            className=\"w-full mt-2 bg-gradient-to-r from-orange-600 to-amber-600 hover:from-orange-500 hover:to-amber-500 text-white text-xs font-bold py-3.5 rounded-xl transition-all shadow-lg shadow-orange-600/10 flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50\"\n          >\n            {loading ? (\n              <>\n                <Loader2 className=\"h-4 w-4 animate-spin text-white\" /> Loading Secure Workspace...\n              </>\n            ) : (\n              <>\n                Verify Corporate Identity <ChevronRight className=\"h-4 w-4\" />\n              </>\n            )}\n          </button>\n        </form>\n\n        {/* Client switcher helper section */}\n        <div id=\"quick-login-sandbox\" className=\"border-t border-slate-800/80 pt-5 space-y-3\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[10px] uppercase font-bold text-slate-500 font-mono tracking-wider\">PRESET SANDBOX CLIENTS</span>\n            <span className=\"text-[9px] text-orange-400 font-semibold uppercase bg-orange-950/50 px-2 py-0.5 rounded border border-orange-500/10\">Quick Sandbox Demo</span>\n          </div>\n\n          <div className=\"grid grid-cols-1 gap-2.5\">\n            <button\n              type=\"button\"\n              id=\"fill-client-a\"\n              onClick={() => handleQuickFill(\"sofastyle@trade2turkey.com\")}\n              className=\"flex justify-between items-center text-left text-[11px] p-2.5 bg-slate-900 hover:bg-slate-850 border border-slate-800 rounded-xl text-slate-300 hover:text-white transition group cursor-pointer\"\n            >\n              <div>\n                <strong className=\"block text-slate-200\">SofaStyle Furnishings (Client A)</strong>\n                <span className=\"text-slate-500 font-mono\">sofastyle@trade2turkey.com</span>\n              </div>\n              <span className=\"text-[9px] bg-slate-800 px-1.5 py-0.5 rounded text-orange-400 group-hover:bg-orange-500 group-hover:text-white transition font-mono\">\n                Fill\n              </span>\n            </button>\n\n            <button\n              type=\"button\"\n              id=\"fill-client-b\"\n              onClick={() => handleQuickFill(\"velvetlounge@trade2turkey.com\")}\n              className=\"flex justify-between items-center text-left text-[11px] p-2.5 bg-slate-900 hover:bg-slate-850 border border-slate-800 rounded-xl text-slate-300 hover:text-white transition group group cursor-pointer\"\n            >\n              <div>\n                <strong className=\"block text-slate-200\">Velvet Lounge Interiors (Client B)</strong>\n                <span className=\"text-slate-500 font-mono\">velvetlounge@trade2turkey.com</span>\n              </div>\n              <span className=\"text-[9px] bg-slate-800 px-1.5 py-0.5 rounded text-orange-400 group-hover:bg-orange-500 group-hover:text-white transition font-mono\">\n                Fill\n              </span>\n            </button>\n\n            <button\n              type=\"button\"\n              id=\"fill-owner-admin\"\n              onClick={() => handleQuickFill(\"trade2turkey06@gmail.com\")}\n              className=\"flex justify-between items-center text-left text-[11px] p-2.5 bg-slate-900 hover:bg-slate-850 border border-slate-800 rounded-xl text-slate-300 hover:text-white transition group cursor-pointer\"\n            >\n              <div>\n                <strong className=\"block text-slate-200\">Trade2Turkey Owner (Owner Desk)</strong>\n                <span className=\"text-slate-500 font-mono\">trade2turkey06@gmail.com</span>\n              </div>\n              <span className=\"text-[9px] bg-slate-800 px-1.5 py-0.5 rounded text-orange-400 group-hover:bg-orange-500 group-hover:text-white transition font-mono\">\n                Fill\n              </span>\n            </button>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n}\n"
    }
