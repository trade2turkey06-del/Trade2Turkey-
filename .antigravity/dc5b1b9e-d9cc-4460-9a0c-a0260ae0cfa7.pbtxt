geLocation}\n                            clientMode={false}\n                            currentProjectId={currentProjectId}\n                            onStatusChange={(id, newStatus) => handleUpdateStatus(id, newStatus as any)}\n                            onFileUploadedNotify={(fileName) => triggerUploadNotification(step.task, fileName)}\n                          />\n                        </td>\n                      </tr>\n                    )}\n                  </React.Fragment>\n                );\n              })}\n            </tbody>\n          </table>\n        </div>\n        \n        {/* Table count info */}\n        <div className=\"bg-slate-50 border-t p-3 text-xs text-slate-500 font-medium flex items-center justify-between\">\n          <span>Showing {filterSteps.length} of 21 crucial Trade2Turkey standard sourcing activities</span>\n          <span className=\"text-orange-600 font-semibold\">\342\230\205 Golden rules of sourcing: Verification, Double-stitch safety & 0% customs ATR compliance.</span>\n        </div>"
