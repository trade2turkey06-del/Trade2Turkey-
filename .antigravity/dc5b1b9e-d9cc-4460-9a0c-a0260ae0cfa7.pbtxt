        target_content: "      {/* SOURCING SOP MASTER TABLE */}\n      <div className=\"bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-sm border-collapse min-w-[1000px]\">\n            <thead>\n              <tr className=\"bg-slate-50 border-b border-slate-200 text-[10px] text-slate-400 uppercase tracking-widest font-mono\">\n                <th className=\"p-4 w-20\">Step ID</th>\n                <th className=\"p-4 w-1/4\">Sourcing Task Activity</th>\n                <th className=\"p-4\">Owner</th>\n                <th className=\"p-4\">KPI / Standard Metric</th>\n                <th className=\"p-4\">SLA Days</th>\n                <th className=\"p-4\">Status</th>\n                <th className=\"p-4\">Evidence Storage</th>\n                <th className=\"p-4 text-center\">Interactive Area</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100\">\n              {filterSteps.map(step => {\n                const hasMinorSheet = !!step.minorSheetKey;\n                return (\n                  <tr \n                    key={step.id} \n                    className={`hover:bg-slate-50/50 group transition ${hasMinorSheet ? \"cursor-pointer bg-amber-50/10 hover:bg-amber-50/30\" : \"\"}`}\n                    onClick={() => {\n                      if (hasMinorSheet && step.minorSheetKey) {\n                        onOpenMinorSheet(step.minorSheetKey);\n                      }\n                    }}\n                  >\n                    {/* ID Column */}\n                    <td className=\"p-4\">\n                      <span className={`text-[11px] font-mono font-bold tracking-tight px-2 py-1 rounded ${\n                        step.id.startsWith(\"A.A\") \n                          ? \"bg-indigo-50 text-indigo-700\" \n                          : \"bg-teal-50 text-teal-700\"\n                      }`}>\n                        {step.id}\n                      </span>\n                    </td>\n\n                    {/* Task Title with Description Indicators */}\n                    <td className=\"p-4\">\n                      <div>\n                        <div className=\"font-semibold text-slate-800\">{step.task}</div>\n                        <div className=\"text-[10px] text-slate-400 font-mono mt-0.5\">{step.requester} (Req)</div>\n                      </div>\n                    </td>\n\n                    {/* Owner */}\n                    <td className=\"p-4\">\n                      <span className=\"text-xs font-semibold text-slate-600 block\">\n                        {step.taskOwner}\n                      </span>\n                    </td>\n\n                    {/* KPI Metric */}\n                    <td className=\"p-4\">\n                      <div className=\"text-xs text-slate-500 leading-tight max-w-[200px]\">\n                        {step.kpiMetric}\n                      </div>\n                    </td>\n\n                    {/* KPI Timeout Days */}\n                    <td className=\"p-4\">\n                      <span className=\"font-mono text-xs font-bold text-slate-700\">\n                        {step.kpiTimeDays}d\n                      </span>\n                    </td>\n\n                    {/* Work status interactive dropdown */}\n                    <td className=\"p-4\" onClick={(e) => e.stopPropagation()}>\n                      <select\n                        value={step.status}\n                        onChange={(e) => handleUpdateStatus(step.id, e.target.value as any)}\n                        className={`text-xs font-bold py-1 px-2.5 rounded-full border cursor-pointer focus:outline-none ${\n                          step.status === \"Completed\"\n                            ? \"bg-green-100 text-green-800 border-green-200\"\n                              : step.status === \"In Progress\"\n                            ? \"bg-blue-100 text-blue-800 border-blue-200\"\n                            : \"bg-slate-100 text-slate-700 border-slate-200\"\n                        }`}\n                      >\n                        <option value=\"Completed\">Completed</option>\n                        <option value=\"In Progress\">In Progress</option>\n                        <option value=\"Pending\">Pending</option>\n                      </select>\n                    </td>\n\n                    {/* Required storage folder link representation */}\n                    <td className=\"p-4\">\n                      <div className=\"text-xs font-medium text-slate-500 hover:text-slate-900 flex items-center gap-1\">\n                        <FileText className=\"h-3.5 w-3.5 text-slate-400 inline\" />\n                        <span className=\"truncate max-w-[120px]\" title={step.storageLocation}>\n                          {step.storageLocation || \"N/A\"}\n                        </span>\n                      </div>\n                    </td>\n\n                    {/* Interactive Sourcing worksheet area pointer */}\n                    <td className=\"p-4 text-center\" onClick={(e) => e.stopPropagation()}>\n                      {hasMinorSheet ? (\n                        <button\n                          id={`minor-sheet-trigger-${step.id}`}\n                          onClick={() => step.minorSheetKey && onOpenMinorSheet(step.minorSheetKey)}\n                          className=\"bg-amber-600 hover:bg-amber-700 text-white font-bold text-[10px] uppercase px-3 py-1.5 rounded-lg flex items-center justify-center gap-1.5 mx-auto transition-all shadow-sm cursor-pointer\"\n                        >\n                          <Eye className=\"h-4 w-4\" /> Open Solver\n                        </button>\n                      ) : (\n                        <div className=\"text-xs text-slate-400 font-mono\">- Standard Step -</div>\n                      )}\n                    </td>\n                  </tr>\n                );\n              })}\n            </tbody>\n          </table>\n        </div>"
        replacement_content: "      {/* Project ID Selection & Toast Alerts */}\n      {toastMessage && (\n        <div className=\"bg-slate-900 border border-teal-500 text-teal-400 p-4 rounded-xl text-xs font-mono flex items-center justify-between shadow-lg animate-bounce sticky top-4 z-50\">\n          <span>{toastMessage}</span>\n          <button onClick={() => setToastMessage(null)} className=\"text-teal-400 hover:text-white font-bold ml-4\">\342\234\225</button>\n        </div>\n      )}\n\n      <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-slate-900 p-4 rounded-xl text-white\">\n        <div>\n          <h4 className=\"text-sm font-bold font-display text-slate-100 flex items-center gap-2\">\n            <span className=\"h-2 w-2 rounded-full bg-blue-500 animate-pulse\" />\n            Active Sourcing Project Context\n          </h4>\n          <p className=\"text-[11px] text-slate-400 mt-1 font-mono\">\n            Used to securely filter real-time cloud folders and audit certificates in downstream portals.\n          </p>\n        </div>\n        <div className=\"flex items-center gap-2\">\n          <span className=\"text-xs text-slate-300 font-semibold font-mono\">Secure Project ID:</span>\n          <select\n            value={currentProjectId}\n            onChange={(e) => setCurrentProjectId(e.target.value)}\n            className=\"p-1.5 rounded-lg border border-slate-700 bg-slate-800 text-xs font-bold text-teal-400 focus:outline-none focus:ring-1 focus:ring-teal-400 font-mono\"\n          >\n            <option value=\"PROJ-BEANBAG\">PROJ-BEANBAG (ComfortPro Bean Bags)</option>\n            <option value=\"PROJ-VELVET\">PROJ-VELVET (Luxury Velvet Ottoman)</option>\n          </select>\n        </div>\n      </div>\n\n      {/* SOURCING SOP MASTER TABLE */}\n      <div className=\"bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-sm border-collapse min-w-[1000px]\">\n            <thead>\n              <tr className=\"bg-slate-50 border-b border-slate-200 text-[10px] text-slate-400 uppercase tracking-widest font-mono\">\n                <th className=\"p-4 w-20\">Step ID</th>\n                <th className=\"p-4 w-1/4\">Sourcing Task Activity</th>\n                <th className=\"p-4\">Owner</th>\n                <th className=\"p-4\">KPI / Standard Metric</th>\n                <th className=\"p-4\">SLA Days</th>\n                <th className=\"p-4\">Status</th>\n                <th className=\"p-4\">Evidence Storage</th>\n                <th className=\"p-4 text-center\">Interactive Area</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100\">\n              {filterSteps.map(step => {\n                const hasMinorSheet = !!step.minorSheetKey;\n                const isExpanded = expandedStepId === step.id;\n                return (\n                  <React.Fragment key={step.id}>\n                    <tr \n                      className={`hover:bg-slate-50/50 group transition ${\n                        isExpanded ? \"bg-slate-50 border-l-4 border-blue-500\" : \"\"\n                      } ${hasMinorSheet ? \"bg-amber-50/5 hover:bg-amber-50/20\" : \"\"}`}\n                      onClick={() => setExpandedStepId(isExpanded ? null : step.id)}\n                    >\n                      {/* ID Column */}\n                      <td className=\"p-4\">\n                        <span className={`text-[11px] font-mono font-bold tracking-tight px-2 py-1 rounded cursor-pointer ${\n                          step.id.startsWith(\"A.A\") \n                            ? \"bg-indigo-50 text-indigo-700 font-bold\" \n                            : \"bg-teal-50 text-teal-700 font-bold\"\n                        }`}>\n                          {step.id}\n                        </span>\n                      </td>\n\n                      {/* Task Title with Description Indicators */}\n                      <td className=\"p-4\">\n                        <div>\n                          <div className=\"font-semibold text-slate-800 cursor-pointer\">{step.task}</div>\n                          <div className=\"text-[10px] text-slate-400 font-mono mt-0.5\">{step.requester} (Req)</div>\n                        </div>\n                      </td>\n\n                      {/* Owner */}\n                      <td className=\"p-4\">\n                        <span className=\"text-xs font-semibold text-slate-600 block\">\n                          {step.taskOwner}\n                        </span>\n                      </td>\n\n                      {/* KPI Metric */}\n                      <td className=\"p-4\">\n                        <div className=\"text-xs text-slate-500 leading-tight max-w-[200px]\">\n                          {step.kpiMetric}\n                        </div>\n                      </td>\n\n                      {/* KPI Timeout Days */}\n                      <td className=\"p-4\">\n                        <span className=\"font-mono text-xs font-bold text-slate-700\">\n                          {step.kpiTimeDays}d\n                        </span>\n                      </td>\n\n                      {/* Work status interactive dropdown */}\n                      <td className=\"p-4\" onClick={(e) => e.stopPropagation()}>\n                        <select\n                          value={step.status}\n                          onChange={(e) => handleUpdateStatus(step.id, e.target.value as any)}\n                          className={`text-xs font-bold py-1 px-2.5 rounded-full border cursor-pointer focus:outline-none ${\n                            step.status === \"Completed\"\n                              ? \"bg-green-100 text-green-800 border-green-200\"\n                              : step.status === \"In Progress\"\n                              ? \"bg-blue-100 text-blue-800 border-blue-200\"\n                              : \"bg-slate-100 text-slate-700 border-slate-200\"\n                          }`}\n                        >\n                          <option value=\"Completed\">Completed</option>\n                          <option value=\"In Progress\">In Progress</option>\n                          <option value=\"Pending\">Pending</option>\n                        </select>\n                      </td>\n\n                      {/* Required storage folder link representation */}\n                      <td className=\"p-4\">\n                        <button \n                          onClick={(e) => {\n                            e.stopPropagation();\n                            setExpandedStepId(isExpanded ? null : step.id);\n                          }}\n                          className=\"text-xs font-medium text-slate-500 hover:text-blue-600 flex items-center gap-1 cursor-pointer transition\"\n                        >\n                          <FileText className=\"h-3.5 w-3.5 text-blue-500 inline\" />\n                          <span className=\"truncate max-w-[120px] underline decoration-dotted\" title={step.storageLocation}>\n                            {step.storageLocation || \"Click to View Link\"}\n                          </span>\n                        </button>\n                      </td>\n\n                      {/* Interactive Sourcing worksheet area pointer */}\n                      <td className=\"p-4 text-center\" onClick={(e) => e.stopPropagation()}>\n                        <div className=\"flex items-center justify-center gap-2\">\n                          {hasMinorSheet && (\n                            <button\n                              id={`minor-sheet-trigger-${step.id}`}\n                              onClick={() => step.minorSheetKey && onOpenMinorSheet(step.minorSheetKey)}\n                              className=\"bg-amber-600 hover:bg-amber-700 text-white font-bold text-[10px] uppercase px-2.5 py-1.5 rounded-lg flex items-center justify-center gap-1.5 transition-all shadow-b cursor-pointer\"\n                            >\n                              <Eye className=\"h-3.5 w-3.5\" /> Work\n                            </button>\n                          )}\n                          <button\n                            onClick={() => setExpandedStepId(isExpanded ? null : step.id)}\n                            className=\"text-[10px] px-2 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-100 text-slate-600 hover:text-slate-900 transition flex items-center gap-1 font-bold cursor-pointer\"\n                          >\n                            Files\n                            {isExpanded ? <ChevronUp className=\"h-3 w-3\" /> : <ChevronDown className=\"h-3 w-3\" />}\n                          </button>\n                        </div>\n                      </td>\n                    </tr>\n\n                    {/* Expandable Google Drive Area (Rule 1 & Rule 2) */}\n                    {isExpanded && (\n                      <tr className=\"bg-slate-100/50\">\n                        <td colSpan={8} className=\"p-4 sm:p-6 border-b border-slate-200\">\n                          <GoogleDriveFolder\n                            stepId={step.id}\n                            storageLocation={step.storageLocation}\n                            clientMode={false}\n                            currentProjectId={currentProjectId}\n                            onStatusChange={(id, newStatus) => handleUpdateStatus(id, newStatus as any)}\n                            onFileUploadedNotify={(fileName) => triggerUploadNotification(step.task, fileName)}\n                          />\n                        </td>\n                      </tr>\n                    )}\n                  </React.Fragment>\n                );\n              })}\n            </tbody>\n          </table>\n        </div>"
