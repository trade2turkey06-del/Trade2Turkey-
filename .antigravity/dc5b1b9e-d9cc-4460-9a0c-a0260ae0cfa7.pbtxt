          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      materialSubtotal += rawCost;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      wastageCost += (effectiveCost - rawCost);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
