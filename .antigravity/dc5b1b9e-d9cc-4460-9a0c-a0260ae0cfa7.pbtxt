          text: "                          leadTime: Math.round(rem * 0.4),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          quality: Math.round(rem * 0.45),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
