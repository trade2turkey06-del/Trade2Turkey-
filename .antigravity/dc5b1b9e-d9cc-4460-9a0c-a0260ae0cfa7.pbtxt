      original_chunk {
        target_content: "      {/* SOURCING SOP MASTER TABLE OF SERVICE GROUP B */}\n      <div className=\"bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm\">\n        <div className=\"bg-slate-950 p-4 text-white\">\n          <h4 className=\"text-sm font-bold font-display\">Section B Pipeline: Strategic Alignment, Logistics & Fulfillment SOP</h4>\n        </div>\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs border-collapse min-w-[1000px]\">\n            <thead>\n              <tr className=\"bg-slate-50 border-b border-slate-200 text-[10px] text-slate-400 uppercase tracking-widest font-mono\">\n                <th className=\"p-4 w-20\">Step ID</th>\n                <th className=\"p-4 w-1/4\">Activity Task</th>\n                <th className=\"p-4\">Owner</th>\n                <th className=\"p-4\">KPI Metric / SLA Timeout</th>\n                <th className=\"p-4\">Expected Outputs</th>\n                <th className=\"p-4\">Status</th>\n                <th className=\"p-4\">Storage Folder</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100\">\n              {currentSectionSteps.map(step => (\n                <tr key={step.id} className=\"hover:bg-slate-50/50 transition\">\n                  <td className=\"p-4\">\n                    <span className=\"font-mono font-bold bg-amber-50 text-amber-800 px-2.5 py-1 rounded\">\n                      {step.id}\n                    </span>\n                  </td>\n                  <td className=\"p-4\">\n                    <div className=\"font-bold text-slate-800\">{step.task}</div>\n                    <div className=\"text-[10px] text-slate-400 mt-0.5\">Req: {step.requester}</div>\n                  </td>\n                  <td className=\"p-4 font-semibold text-slate-600\">{step.taskOwner}</td>\n                  <td className=\"p-4\">\n                    <div className=\"text-slate-500 max-w-xs\">{step.kpiMetric}</div>\n                    <div className=\"text-[10px] text-slate-400 font-mono mt-0.5\">SLA: {step.kpiTimeDays} days</div>\n                  </td>\n                  <td className=\"p-4 text-slate-600 leading-tight\">{step.requiredOutputs}</td>\n                  <td className=\"p-4\">\n                    <select\n                      value={step.status}\n                      onChange={(e) => handleUpdateStatus(step.id, e.target.value as any)}\n                      className={`font-semibold py-1 px-2 rounded-full border cursor-pointer focus:outline-none text-[11px] ${\n                        step.status === \"Completed\"\n                          ? \"bg-green-100 text-green-800 border-green-200\"\n                          : step.status === \"In Progress\"\n                          ? \"bg-blue-100 text-blue-800 border-blue-200\"\n                          : \"bg-slate-100 text-slate-700 border-slate-200\"\n                      }`}\n                    >\n                      <option value=\"Completed\">Completed</option>\n                      <option value=\"In Progress\">In Progress</option>\n                      <option value=\"Pending\">Pending</option>\n                    </select>\n                  </td>\n                  <td className=\"p-4 font-mono text-slate-500 truncate max-w-[150px]\">{step.storageLocation}</td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>"
        replacement_content: "      {/* Project ID Selection & Toast Alerts */}\n      {toastMessage && (\n        <div className=\"bg-slate-900 border border-teal-500 text-teal-400 p-4 rounded-xl text-xs font-mono flex items-center justify-between shadow-lg animate-bounce sticky top-4 z-50\">\n          <span>{toastMessage}</span>\n          <button onClick={() => setToastMessage(null)} className=\"text-teal-400 hover:text-white font-bold ml-4\">\342\234\225</button>\n        </div>\n      )}\n\n      {/* SOURCING SOP MASTER TABLE OF SERVICE GROUP B */}\n      <div className=\"bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm\">\n        <div className=\"bg-slate-900 p-4 text-white flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div>\n            <h4 className=\"text-sm font-bold font-display\">Section B Pipeline: Strategic Alignment, Logistics & Fulfillment SOP</h4>\n            <p className=\"text-[10px] text-slate-400 font-mono mt-0.5\">Click column Digital Storage Folder links to browse aligned Google Drive file sync vaults</p>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xs text-slate-400 font-semibold font-mono\">Project ID:</span>\n            <select\n              value={currentProjectId}\n              onChange={(e) => setCurrentProjectId(e.target.value)}\n              className=\"p-1 px-2 rounded border border-slate-700 bg-slate-800 text-[10px] font-bold text-teal-400 focus:outline-none focus:ring-1 focus:ring-teal-400 font-mono\"\n            >\n              <option value=\"PROJ-BEANBAG\">PROJ-BEANBAG</option>\n              <option value=\"PROJ-VELVET\">PROJ-VELVET</option>\n            </select>\n          </div>\n        </div>\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs border-collapse min-w-[1000px]\">\n            <thead>\n              <tr className=\"bg-slate-50 border-b border-slate-200 text-[10px] text-slate-400 uppercase tracking-widest font-mono\">\n                <th className=\"p-4 w-20\">Step ID</th>\n                <th className=\"p-4 w-1/4\">Activity Task</th>\n                <th className=\"p-4\">Owner</th>\n                <th className=\"p-4\">KPI Metric / SLA Timeout</th>\n                <th className=\"p-4\">Expected Outputs</th>\n                <th className=\"p-4\">Status</th>\n                <th className=\"p-3 w-32\">Google Drive Storage</th>\n                <th className=\"p-3 text-center\">Actions</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100\">\n              {currentSectionSteps.map(step => {\n                const isExpanded = expandedStepId === step.id;\n                return (\n                  <React.Fragment key={step.id}>\n                    <tr \n                      className={`hover:bg-slate-50/50 transition cursor-pointer ${\n                        isExpanded ? \"bg-slate-50 border-l-4 border-blue-500\" : \"\"\n                      }`}\n                      onClick={() => setExpandedStepId(isExpanded ? null : step.id)}\n                    >\n                      <td className=\"p-4\">\n                        <span className=\"font-mono font-bold bg-amber-50 text-amber-800 px-2.5 py-1 rounded\">\n                          {step.id}\n                        </span>\n                      </td>\n                      <td className=\"p-4\">\n                        <div className=\"font-bold text-slate-800\">{step.task}</div>\n                        <div className=\"text-[10px] text-slate-400 mt-0.5 font-mono\">Req: {step.requester}</div>\n                      </td>\n                      <td className=\"p-4 font-semibold text-slate-600\">{step.taskOwner}</td>\n                      <td className=\"p-4\">\n                        <div className=\"text-slate-500 max-w-xs\">{step.kpiMetric}</div>\n                        <div className=\"text-[10px] text-slate-400 font-mono mt-0.5\">SLA: {step.kpiTimeDays} days</div>\n                      </td>\n                      <td className=\"p-4 text-slate-600 leading-tight\">{step.requiredOutputs}</td>\n                      <td className=\"p-4\" onClick={(e) => e.stopPropagation()}>\n                        <select\n                          value={step.status}\n                          onChange={(e) => handleUpdateStatus(step.id, e.target.value as any)}\n                          className={`font-semibold py-1 px-2 rounded-full border cursor-pointer focus:outline-none text-[11px] ${\n                            step.status === \"Completed\"\n                              ? \"bg-green-100 text-green-800 border-green-200\"\n                              : step.status === \"In Progress\"\n                              ? \"bg-blue-100 text-blue-800 border-blue-200\"\n                              : \"bg-slate-100 text-slate-700 border-slate-200\"\n                          }`}\n                        >\n                          <option value=\"Completed\">Completed</option>\n                          <option value=\"In Progress\">In Progress</option>\n                          <option value=\"Pending\">Pending</option>\n                        </select>\n                      </td>\n                      <td className=\"p-3\">\n                        <button\n                          onClick={(e) => {\n                            e.stopPropagation();\n                            setExpandedStepId(isExpanded ? null : step.id);\n                          }}\n                          className=\"text-[11px] text-blue-600 hover:text-blue-800 underline decoration-dotted font-bold text-left flex items-center gap-1 cursor-pointer transition\"\n                          title={step.storageLocation}\n                        >\n                          <FileText className=\"h-3.5 w-3.5 shrink-0\" />\n                          <span className=\"truncate max-w-[90px]\">{step.storageLocation || \"Open Folder\"}</span>\n                        </button>\n                      </td>\n                      <td className=\"p-3 text-center\" onClick={(e) => e.stopPropagation()}>\n                        <button\n                          onClick={() => setExpandedStepId(isExpanded ? null : step.id)}\n                          className=\"text-[10px] px-2 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-150 text-slate-700 hover:text-slate-900 transition flex items-center gap-1 font-bold cursor-pointer mx-auto\"\n                        >\n                          Files\n                          {isExpanded ? <ChevronUp className=\"h-3 w-3\" /> : <ChevronDown className=\"h-3 w-3\" />}\n                        </button>\n                      </td>\n                    </tr>\n\n                    {/* Expandable Simulated Real-Time Cloud Folder Section */}\n                    {isExpanded && (\n                      <tr className=\"bg-slate-100/50\">\n                        <td colSpan={8} className=\"p-4 sm:p-5 border-b border-rose-100\">\n                          <GoogleDriveFolder\n                            stepId={step.id}\n                            storageLocation={step.storageLocation}\n                            clientMode={false}\n                            currentProjectId={currentProjectId}\n                            onStatusChange={(id, newStatus) => handleUpdateStatus(id, newStatus as any)}\n                            onFileUploadedNotify={(fileName) => triggerUploadNotification(step.task, fileName)}\n                          />\n                        </td>\n                      </tr>\n                    )}\n                  </React.Fragment>\n                );\n              })}\n            </tbody>\n          </table>\n        </div>\n      </div>"
