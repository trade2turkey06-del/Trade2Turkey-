  file_change {
    absolute_path_uri: "file:///src/components/Navbar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \"react\";\nimport { Globe, Shield, User, FileText, ChevronRight, Menu, X, Clock } from \"lucide-react\";\n\ninterface NavbarProps {\n  currentTab: string;\n  setCurrentTab: (tab: string) => void;\n  clientMode: boolean;\n  setClientMode: (mode: boolean) => void;\n}\n\nexport default function Navbar({ currentTab, setCurrentTab, clientMode, setClientMode }: NavbarProps) {\n  const [mobileMenuOpen, setMobileMenuOpen] = React.useState(false);\n  const [timestamp, setTimestamp] = React.useState(\"2026-06-03 19:22:00 UTC\");\n\n  // Keep a clean design\n  const navItems = [\n    { id: \"sourcing\", label: \"Sourcing SOP (Section A)\", icon: Globe },\n    { id: \"logistics\", label: \"Project Alignment & Logistics (Section B)\", icon: FileText },\n    { id: \"suppliers\", label: \"Supplier Evaluations\", icon: Shield },\n    { id: \"client-portal\", label: \"Client Verification Portal\", icon: User },\n  ];\n\n  return (\n    <header className=\"sticky top-0 z-50 w-full border-b border-slate-200 bg-white/95 backdrop-blur-md\">\n      <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8\">\n        {/* Logo and Brand */}\n        <div className=\"flex items-center gap-3\">\n          <div className=\"flex h-10 w-10 items-center justify-center rounded-xl bg-orange-600 text-white font-semibold shadow-md shadow-orange-600/20 font-display\">\n            T2T\n          </div>\n          <div>\n            <h1 className=\"text-xl font-bold tracking-tight text-slate-900 font-display\">\n              Trade2Turkey\n            </h1>\n            <p className=\"text-xs font-medium text-slate-500\">\n              Export Logistics & Verification Suite\n            </p>\n          </div>\n        </div>\n\n        {/* Desktop Navigation */}\n        <nav className=\"hidden lg:flex items-center gap-1\">\n          {navItems.map((item) => {\n            const Icon = item.icon;\n            const isActive = currentTab === item.id;\n            return (\n              <button\n                key={item.id}\n                id={`nav-${item.id}`}\n                onClick={() => {\n                  setCurrentTab(item.id);\n                  setClientMode(item.id === \"client-portal\");\n                }}\n                className={`flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-all ${\n                  isActive\n                    ? \"bg-orange-50 text-orange-600 font-semibold\"\n                    : \"text-slate-600 hover:text-slate-900 hover:bg-slate-50\"\n                }`}\n              >\n                <Icon className=\"h-4 w-4\" />\n                {item.label}\n              </button>\n            );\n          })}\n        </nav>\n\n        {/* Global Controls & Status */}\n        <div className=\"hidden md:flex items-center gap-4\">\n          <div className=\"flex items-center gap-2 rounded-lg bg-slate-50 px-3 py-1.5 border border-slate-100 text-slate-500 text-xs font-mono\">\n            <Clock className=\"h-3.5 w-3.5 text-slate-400\" />\n            <span>2026-06-03 19:22 UTC</span>\n          </div>\n\n          <button\n            id=\"toggle-client-mode\"\n            onClick={() => {\n              const newMode = !clientMode;\n              setClientMode(newMode);\n              if (newMode) {\n                setCurrentTab(\"client-portal\");\n              } else if (currentTab === \"client-portal\") {\n                setCurrentTab(\"sourcing\");\n              }\n            }}\n            className={`cursor-pointer rounded-lg px-3 py-1.5 text-xs font-semibold tracking-wide transition-all uppercase ${\n              clientMode\n                ? \"bg-blue-600 text-white hover:bg-blue-700 shadow-md shadow-blue-600/15\"\n                : \"bg-slate-200 text-slate-700 hover:bg-slate-300\"\n            }`}\n          >\n            {clientMode ? \"\360\237\224\222 Exit Client View\" : \"\360\237\221\245 Client/Stakeholder Mode\"}\n          </button>\n        </div>\n\n        {/* Mobile Menu Icon */}\n        <div className=\"flex lg:hidden items-center gap-2\">\n          <button\n            onClick={() => {\n              const newMode = !clientMode;\n              setClientMode(newMode);\n              if (newMode) {\n                setCurrentTab(\"client-portal\");\n              } else if (currentTab === \"client-portal\") {\n                setCurrentTab(\"sourcing\");\n              }\n            }}\n            className={`rounded-lg px-2 py-1 text-xs font-semibold uppercase transition-all ${\n              clientMode ? \"bg-blue-600 text-white\" : \"bg-slate-200 text-slate-700\"\n            }`}\n          >\n            {clientMode ? \"Client Active\" : \"Go Client\"}\n          </button>\n          <button\n            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n            className=\"rounded-lg p-2 text-slate-600 hover:bg-slate-100 hover:text-slate-900\"\n          >\n            {mobileMenuOpen ? <X className=\"h-6 w-6\" /> : <Menu className=\"h-6 w-6\" />}\n          </button>\n        </div>\n      </div>\n\n      {/* Mobile Drawer */}\n      {mobileMenuOpen && (\n        <div className=\"lg:hidden bg-white border-t border-slate-100 px-4 py-3 flex flex-col gap-2\">\n          {navItems.map((item) => {\n            const Icon = item.icon;\n            const isActive = currentTab === item.id;\n            return (\n              <button\n                key={item.id}\n                id={`mob-nav-${item.id}`}\n                onClick={() => {\n                  setCurrentTab(item.id);\n                  setClientMode(item.id === \"client-portal\");\n                  setMobileMenuOpen(false);\n                }}\n                className={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium ${\n                  isActive\n                    ? \"bg-orange-50 text-orange-600\"\n                    : \"text-slate-600 hover:bg-slate-50\"\n                }`}\n              >\n                <Icon className=\"h-4 w-4\" />\n                {item.label}\n              </button>\n            );\n          })}\n        </div>\n      )}\n    </header>\n  );\n}\n"
    }
