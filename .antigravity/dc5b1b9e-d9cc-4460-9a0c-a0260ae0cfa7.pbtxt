    instruction: "Isolate LocalStorage keys and state hydrations per activeProjectId to ensure perfect multi-tenant data containment."
    replacement_infos {
      original_chunk {
        target_content: "  // Core application persisted states\n  const [sopSteps, setSopSteps] = useState<SopStep[]>([]);\n  const [targetSpecs, setTargetSpecs] = useState<TargetSpecification[]>([]);\n  const [rfqs, setRfqs] = useState<RfqSubmission[]>([]);\n  const [valueChain, setValueChain] = useState<ValueChainCosting[]>([]);\n  const [rfqMatrix, setRfqMatrix] = useState<RfqComparativeMatrix[]>([]);\n  const [recipes, setRecipes] = useState<ProductRecipe[]>([]);\n  const [suppliers, setSuppliers] = useState<Supplier[]>([]);\n  const [shipments, setShipments] = useState<ShipmentMilestone[]>([]);\n  const [inventory, setInventory] = useState<InventoryItem[]>([]);\n  const [fulfillmentOrders, setFulfillmentOrders] = useState<FulfillmentOrder[]>([]);\n\n  // 1. Initial State Hydrator\n  useEffect(() => {\n    try {\n      const getOrInit = (key: string, initial: any) => {\n        const stored = localStorage.getItem(`t2t_v1_${key}`);\n        if (stored) {\n          return JSON.parse(stored);\n        }\n        return initial;\n      };\n\n      setSopSteps(getOrInit(\"sop_steps\", INITIAL_SOP_STEPS));\n      setTargetSpecs(getOrInit(\"target_specs\", INITIAL_TARGET_SPECS));\n      setRfqs(getOrInit(\"rfqs\", INITIAL_RFQS));\n      setValueChain(getOrInit(\"value_chain\", INITIAL_VALUE_CHAIN_COSTINGS));\n      setRfqMatrix(getOrInit(\"rfq_matrix\", INITIAL_RFQ_MATRICES));\n      setRecipes(getOrInit(\"recipes\", INITIAL_PRODUCT_RECIPES));\n      setSuppliers(getOrInit(\"suppliers\", INITIAL_SUPPLIERS));\n      setShipments(getOrInit(\"shipments\", INITIAL_SHIPMENTS));\n      setInventory(getOrInit(\"inventory\", INITIAL_INVENTORY_ITEMS));\n      setFulfillmentOrders(getOrInit(\"orders\", INITIAL_FULFILLMENT_ORDERS));\n    } catch (e) {\n      console.warn(\"Local storage fallback loaded.\", e);\n    }\n  }, []);\n\n  // Sync Google Drive OAuth postMessage messages\n  useEffect(() => {\n    const handleGoogleMessage = (event: MessageEvent) => {\n      if (event.data?.type === \"OAUTH_AUTH_SUCCESS\") {\n        const { accessToken, email, picture } = event.data;\n        setDriveAuth(accessToken, email, picture);\n      }\n    };\n    window.addEventListener(\"message\", handleGoogleMessage);\n    return () => window.removeEventListener(\"message\", handleGoogleMessage);\n  }, []);\n\n  // 2. State Sync persistence autoSaver\n  useEffect(() => {\n    if (sopSteps.length === 0) return; // avoid overwrite during startup\n    try {\n      localStorage.setItem(\"t2t_v1_sop_steps\", JSON.stringify(sopSteps));\n      localStorage.setItem(\"t2t_v1_target_specs\", JSON.stringify(targetSpecs));\n      localStorage.setItem(\"t2t_v1_rfqs\", JSON.stringify(rfqs));\n      localStorage.setItem(\"t2t_v1_value_chain\", JSON.stringify(valueChain));\n      localStorage.setItem(\"t2t_v1_rfq_matrix\", JSON.stringify(rfqMatrix));\n      localStorage.setItem(\"t2t_v1_recipes\", JSON.stringify(recipes));\n      localStorage.setItem(\"t2t_v1_suppliers\", JSON.stringify(suppliers));\n      localStorage.setItem(\"t2t_v1_shipments\", JSON.stringify(shipments));\n      localStorage.setItem(\"t2t_v1_inventory\", JSON.stringify(inventory));\n      localStorage.setItem(\"t2t_v1_orders\", JSON.stringify(fulfillmentOrders));\n    } catch (e) {\n      console.warn(\"Storage quota or disabled storage.\", e);\n    }\n  }, [\n    sopSteps, targetSpecs, rfqs, valueChain, rfqMatrix, \n    recipes, suppliers, shipments, inventory, fulfillmentOrders\n  ]);"
        replacement_content: "  // State synchronization guard (stores the project associated with active memory states to prevent race overrides)\n  const [loadedProjectId, setLoadedProjectId] = useState<string>(\"\");\n\n  // Core application persisted states\n  const [sopSteps, setSopSteps] = useState<SopStep[]>([]);\n  const [targetSpecs, setTargetSpecs] = useState<TargetSpecification[]>([]);\n  const [rfqs, setRfqs] = useState<RfqSubmission[]>([]);\n  const [valueChain, setValueChain] = useState<ValueChainCosting[]>([]);\n  const [rfqMatrix, setRfqMatrix] = useState<RfqComparativeMatrix[]>([]);\n  const [recipes, setRecipes] = useState<ProductRecipe[]>([]);\n  const [suppliers, setSuppliers] = useState<Supplier[]>([]);\n  const [shipments, setShipments] = useState<ShipmentMilestone[]>([]);\n  const [inventory, setInventory] = useState<InventoryItem[]>([]);\n  const [fulfillmentOrders, setFulfillmentOrders] = useState<FulfillmentOrder[]>([]);\n\n  // 1. Initial State Hydrator: loads dataset filtered strictly by active project ID\n  useEffect(() => {\n    try {\n      const getOrInitActiveProject = (key: string, initial: any, isGlobalFallback = false) => {\n        // Multi-tenant key prefix\n        const activeKey = `t2t_v2_${activeProjectId}_${key}`;\n        const stored = localStorage.getItem(activeKey);\n        if (stored) {\n          return JSON.parse(stored);\n        }\n\n        // Backward compatibility fallback during migration\n        if (!isGlobalFallback && activeProjectId === \"PROJ-BEANBAG\") {\n          const oldGlobalStored = localStorage.getItem(`t2t_v1_${key}`);\n          if (oldGlobalStored) {\n            return JSON.parse(oldGlobalStored);\n          }\n        }\n\n        // Deep copy the initial template to ensure state manipulations do not corrupt original mock definitions\n        return JSON.parse(JSON.stringify(initial));\n      };\n\n      setSopSteps(getOrInitActiveProject(\"sop_steps\", INITIAL_SOP_STEPS));\n      setTargetSpecs(getOrInitActiveProject(\"target_specs\", INITIAL_TARGET_SPECS));\n      setRfqs(getOrInitActiveProject(\"rfqs\", INITIAL_RFQS));\n      setValueChain(getOrInitActiveProject(\"value_chain\", INITIAL_VALUE_CHAIN_COSTINGS));\n      setRfqMatrix(getOrInitActiveProject(\"rfq_matrix\", INITIAL_RFQ_MATRICES));\n      setRecipes(getOrInitActiveProject(\"recipes\", INITIAL_PRODUCT_RECIPES));\n      setSuppliers(getOrInitActiveProject(\"suppliers\", INITIAL_SUPPLIERS));\n      setShipments(getOrInitActiveProject(\"shipments\", INITIAL_SHIPMENTS));\n      setInventory(getOrInitActiveProject(\"inventory\", INITIAL_INVENTORY_ITEMS));\n      setFulfillmentOrders(getOrInitActiveProject(\"orders\", INITIAL_FULFILLMENT_ORDERS));\n      \n      // Update our loaded tracker AFTER state updates have queued to prevent pre-load saves of old project state\n      setLoadedProjectId(activeProjectId);\n    } catch (e) {\n      console.warn(\"Local storage fallback loaded.\", e);\n    }\n  }, [activeProjectId]);\n\n  // Sync Google Drive OAuth postMessage messages\n  useEffect(() => {\n    const handleGoogleMessage = (event: MessageEvent) => {\n      if (event.data?.type === \"OAUTH_AUTH_SUCCESS\") {\n        const { accessToken, email, picture } = event.data;\n        setDriveAuth(accessToken, email, picture);\n      }\n    };\n    window.addEventListener(\"message\", handleGoogleMessage);\n    return () => window.removeEventListener(\"message\", handleGoogleMessage);\n  }, []);\n\n  // 2. State Sync persistence autoSaver: saves strictly to the isolated active project namespace\n  useEffect(() => {\n    // CRITICAL SECURITY GUARD: Block saving back to local storage if memory states belong to a different project\n    if (loadedProjectId !== activeProjectId) return;\n    if (sopSteps.length === 0) return; // avoid overwrite during startup\n    \n    try {\n      localStorage.setItem(`t2t_v2_${activeProjectId}_sop_steps`, JSON.stringify(sopSteps));\n      localStorage.setItem(`t2t_v2_${activeProjectId}_target_specs`, JSON.stringify(targetSpecs));\n      localStorage.setItem(`t2t_v2_${activeProjectId}_rfqs`, JSON.stringify(rfqs));\n      localStorage.setItem(`t2t_v2_${activeProjectId}_value_chain`, JSON.stringify(valueChain));\n      localStorage.setItem(`t2t_v2_${activeProjectId}_rfq_matrix`, JSON.stringify(rfqMatrix));\n      localStorage.setItem(`t2t_v2_${activeProjectId}_recipes`, JSON.stringify(recipes));\n      localStorage.setItem(`t2t_v2_${activeProjectId}_suppliers`, JSON.stringify(suppliers));\n      localStorage.setItem(`t2t_v2_${activeProjectId}_shipments`, JSON.stringify(shipments));\n      localStorage.setItem(`t2t_v2_${activeProjectId}_inventory`, JSON.stringify(inventory));\n      localStorage.setItem(`t2t_v2_${activeProjectId}_orders`, JSON.stringify(fulfillmentOrders));\n    } catch (e) {\n      console.warn(\"Storage quota or disabled storage.\", e);\n    }\n  }, [\n    loadedProjectId, activeProjectId,\n    sopSteps, targetSpecs, rfqs, valueChain, rfqMatrix, \n    recipes, suppliers, shipments, inventory, fulfillmentOrders\n  ]);"
      }
      num_matches: 1
    }
  }
}
