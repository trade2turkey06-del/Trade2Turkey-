          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                }`}>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  {statusCritical && ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
