        }
        lines {
          text: "    const totalLandedCost = exwTotal + domesticLog + exportCust + freight + dutyVal + broker + ware + inland + buffer;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const perUnitLanded = totalLandedCost / cost.quantity;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
