    replacement_chunks {
      replacement_content: "import React from \"react\";\nimport { Globe, Shield, User, FileText, Menu, X, Clock, LogOut, RefreshCw } from \"lucide-react\";\nimport { UserTenant } from \"../data/usersData\";\n\ninterface NavbarProps {\n  currentTab: string;\n  setCurrentTab: (tab: string) => void;\n  clientMode: boolean;\n  setClientMode: (mode: boolean) => void;\n  currentUser: UserTenant | null;\n  onLogout: () => void;\n  activeProjectId: string;\n  setActiveProjectId: (projectId: string) => void;\n}\n\nexport default function Navbar({\n  currentTab,\n  setCurrentTab,\n  clientMode,\n  setClientMode,\n  currentUser,\n  onLogout,\n  activeProjectId,\n  setActiveProjectId\n}: NavbarProps) {\n  const [mobileMenuOpen, setMobileMenuOpen] = React.useState(false);\n\n  // If client, restrict tabs or adjust labels if needed.\n  // Standard navigation links\n  const navItems = [\n    { id: \"sourcing\", label: \"Sourcing SOP (Section A)\", icon: Globe },\n    { id: \"logistics\", label: \"Project Alignment & Logistics (Section B)\", icon: FileText },\n    { id: \"suppliers\", label: \"Supplier Evaluations\", icon: Shield },\n    { id: \"client-portal\", label: \"Client Verification Portal\", icon: User },\n  ];\n\n  return (\n    <header className=\"sticky top-0 z-50 w-full border-b border-slate-200 bg-white/95 backdrop-blur-md\">\n      <div className=\"mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8\">\n        \n        {/* Logo and Brand */}\n        <div className=\"flex items-center gap-3\">\n          <div className=\"flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-tr from-orange-600 to-amber-500 text-white font-black shadow-md shadow-orange-600/15 font-display\">\n            T2T\n          </div>\n          <div>\n            <h1 className=\"text-sm font-bold tracking-tight text-slate-900 font-display flex items-center gap-1.5 leading-none\">\n              Trade2Turkey\n              {currentUser?.role === \"owner\" ? (\n                <span className=\"text-[9px] bg-red-100 text-red-700 font-extrabold px-1.5 py-0.5 rounded-md font-mono tracking-wider uppercase\">\n                  OWNER\n                </span>\n              ) : (\n                <span className=\"text-[9px] bg-green-100 text-green-700 font-extrabold px-1.5 py-0.5 rounded-md font-mono tracking-wider uppercase\">\n                  CLIENT\n                </span>\n              )}\n            </h1>\n            <p className=\"text-[10px] font-semibold text-slate-400 mt-1 uppercase tracking-wider font-mono\">\n              B2B Cloud Isolation\n            </p>\n          </div>\n        </div>\n\n        {/* Desktop Navigation */}\n        <nav className=\"hidden lg:flex items-center gap-1\">\n          {navItems.map((item) => {\n            const Icon = item.icon;\n            const isActive = currentTab === item.id;\n            return (\n              <button\n                key={item.id}\n                id={`nav-${item.id}`}\n                onClick={() => {\n                  setCurrentTab(item.id);\n                  setClientMode(item.id === \"client-portal\");\n                }}\n                className={`flex items-center gap-2 px-3.5 py-2 rounded-lg text-xs font-semibold transition-all cursor-pointer ${\n                  isActive\n                    ? \"bg-orange-50 text-orange-600 font-bold\"\n                    : \"text-slate-600 hover:text-slate-900 hover:bg-slate-50\"\n                }`}\n              >\n                <Icon className=\"h-4 w-4\" />\n                {item.label}\n              </button>\n            );\n          })}\n        </nav>\n\n        {/* Global Controls, Switcher & User Profile */}\n        <div className=\"hidden md:flex items-center gap-3\">\n          \n          {/* Owner-Level Global Project Controller */}\n          {currentUser?.role === \"owner\" && (\n            <div className=\"flex items-center gap-1 text-xs bg-slate-100 p-1.5 rounded-xl border border-slate-200\">\n              <span className=\"text-[10px] font-bold text-slate-500 font-mono pl-1\">VIEW AS:</span>\n              <select\n                value={activeProjectId}\n                onChange={(e) => setActiveProjectId(e.target.value)}\n                className=\"bg-white px-2 py-1 rounded border border-slate-200 text-slate-800 font-bold font-mono focus:outline-none\"\n              >\n                <option value=\"PROJ-BEANBAG\">ComfortPro Bean Bags</option>\n                <option value=\"PROJ-VELVET\">Velvet Ottoman</option>\n              </select>\n            </div>\n          )}\n\n          {/* Timezone compliance tracker */}\n          <div className=\"flex items-center gap-1.5 rounded-xl bg-slate-50 px-3 py-1.5 border border-slate-100 text-slate-500 text-[10px] font-mono\">\n            <Clock className=\"h-3.5 w-3.5 text-slate-400\" />\n            <span>Operational GMT+3</span>\n          </div>\n\n          {/* Corporate Profile indicator */}\n          {currentUser && (\n            <div className=\"flex items-center gap-2.5 pl-2 border-l border-slate-200\">\n              <div className=\"text-right\">\n                <div id=\"user-display-name\" className=\"text-xs font-bold text-slate-800 leading-none\">\n                  {currentUser.companyName}\n                </div>\n                <div id=\"user-display-email\" className=\"text-[9px] text-slate-400 font-mono mt-0.5 leading-none\">\n                  {currentUser.email}\n                </div>\n              </div>\n              \n              {/* Logout Button */}\n              <button\n                id=\"header-logout-btn\"\n                onClick={onLogout}\n                title=\"Log Out of system\"\n                className=\"p-1.5 rounded-lg border border-slate-200 hover:bg-rose-50 hover:border-rose-200 text-slate-400 hover:text-rose-600 transition cursor-pointer\"\n              >\n                <LogOut className=\"h-4 w-4\" />\n              </button>\n            </div>\n          )}\n        </div>\n\n        {/* Mobile Menu Trigger & Action buttons */}\n        <div className=\"flex lg:hidden items-center gap-2\">\n          {currentUser && (\n            <button\n              onClick={onLogout}\n              className=\"p-1 px-2.5 rounded bg-slate-100 hover:bg-rose-50 text-slate-600 hover:text-rose-600 text-[10px] font-bold flex items-center gap-1 transition\"\n            >\n              <LogOut className=\"h-3 w-3\" /> Log Out\n            </button>\n          )}\n          <button\n            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n            className=\"rounded-lg p-1.5 text-slate-600 hover:bg-slate-100 hover:text-slate-900 cursor-pointer\"\n          >\n            {mobileMenuOpen ? <X className=\"h-6 w-6\" /> : <Menu className=\"h-6 w-6\" />}\n          </button>\n        </div>\n      </div>\n\n      {/* Mobile drawer layout */}\n      {mobileMenuOpen && (\n        <div className=\"lg:hidden bg-white border-t border-slate-100 px-4 py-4 flex flex-col gap-3.5 shadow-inner\">\n          \n          {currentUser?.role === \"owner\" && (\n            <div className=\"bg-slate-50 p-2.5 rounded-xl border border-slate-100 flex items-center justify-between text-xs font-semibold\">\n              <span className=\"text-slate-500\">Workspace Context:</span>\n              <select\n                value={activeProjectId}\n                onChange={(e) => setActiveProjectId(e.target.value)}\n                className=\"bg-white p-1 rounded font-bold font-mono text-slate-800 focus:outline-none border border-slate-200\"\n              >\n                <option value=\"PROJ-BEANBAG\">ComfortPro Bean Bags</option>\n                <option value=\"PROJ-VELVET\">Velvet Ottoman</option>\n              </select>\n            </div>\n          )}\n\n          <div className=\"flex flex-col gap-1\">\n            {navItems.map((item) => {\n              const Icon = item.icon;\n              const isActive = currentTab === item.id;\n              return (\n                <button\n                  key={item.id}\n                  id={`mob-nav-${item.id}`}\n                  onClick={() => {\n                    setCurrentTab(item.id);\n                    setClientMode(item.id === \"client-portal\");\n                    setMobileMenuOpen(false);\n                  }}\n                  className={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs font-semibold ${\n                    isActive\n                      ? \"bg-orange-50 text-orange-600\"\n                      : \"text-slate-600 hover:bg-slate-50\"\n                  }`}\n                >\n                  <Icon className=\"h-4 w-4\" />\n                  {item.label}\n                </button>\n              );\n            })}\n          </div>\n\n          {currentUser && (\n            <div className=\"pt-3 border-t border-slate-100 text-center text-[10px] text-slate-400 font-semibold font-mono uppercase\">\n              Logged in: {currentUser.companyName} ({currentUser.role})\n            </div>\n          )}\n        </div>\n      )}\n    </header>\n  );\n}\n"
    }
