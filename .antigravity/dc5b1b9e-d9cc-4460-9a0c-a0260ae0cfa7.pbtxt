          text: "            <p className=\"text-xs text-slate-500 mt-1 leading-relaxed\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              Calculate reorder limits automatically using lead time and safety stocks. Trade2Turkey automatically triggers alarm indicators for stocks approaching unsafe levels."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            </p>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
