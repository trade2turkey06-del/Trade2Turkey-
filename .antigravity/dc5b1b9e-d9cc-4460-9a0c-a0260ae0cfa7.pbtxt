        target_content: "import React, { useState } from \"react\";\nimport { \n  Ship, Calendar, Truck, Layers, Coins, Package, BarChart2, CheckSquare, \n  Search, ShieldCheck, Camera, FileText, ArrowRight, RefreshCw, AlertTriangle\n} from \"lucide-react\";\nimport { SopStep, ShipmentMilestone, InventoryItem, FulfillmentOrder } from \"../types\";\n\ninterface LogisticsSOPProps {\n  steps: SopStep[];\n  setSteps: React.Dispatch<React.SetStateAction<SopStep[]>>;\n  shipments: ShipmentMilestone[];\n  setShipments: React.Dispatch<React.SetStateAction<ShipmentMilestone[]>>;\n  inventory: InventoryItem[];\n  setInventory: React.Dispatch<React.SetStateAction<InventoryItem[]>>;\n  orders: FulfillmentOrder[];\n  setOrders: React.Dispatch<React.SetStateAction<FulfillmentOrder[]>>;\n}\n\nexport default function LogisticsSOP({\n  steps,\n  setSteps,\n  shipments,\n  setShipments,\n  inventory,\n  setInventory,\n  orders,\n  setOrders\n}: LogisticsSOPProps) {\n  \n  const [activeSubsection, setActiveSubsection] = useState<\"B.A\" | \"B.B\" | \"B.C\">(\"B.A\");\n  const [searchQuery, setSearchQuery] = useState(\"\");\n\n  // Internal notification helper\n  const [feedback, setFeedback] = useState<string | null>(null);\n  const showFeedback = (msg: string) => {\n    setFeedback(msg);\n    setTimeout(() => setFeedback(null), 3000);\n  };"
        replacement_content: "import React, { useState } from \"react\";\nimport { \n  Ship, Calendar, Truck, Layers, Coins, Package, BarChart2, CheckSquare, \n  Search, ShieldCheck, Camera, FileText, ArrowRight, RefreshCw, AlertTriangle, ChevronDown, ChevronUp\n} from \"lucide-react\";\nimport { SopStep, ShipmentMilestone, InventoryItem, FulfillmentOrder } from \"../types\";\nimport GoogleDriveFolder from \"./GoogleDriveFolder\";\n\ninterface LogisticsSOPProps {\n  steps: SopStep[];\n  setSteps: React.Dispatch<React.SetStateAction<SopStep[]>>;\n  shipments: ShipmentMilestone[];\n  setShipments: React.Dispatch<React.SetStateAction<ShipmentMilestone[]>>;\n  inventory: InventoryItem[];\n  setInventory: React.Dispatch<React.SetStateAction<InventoryItem[]>>;\n  orders: FulfillmentOrder[];\n  setOrders: React.Dispatch<React.SetStateAction<FulfillmentOrder[]>>;\n}\n\nexport default function LogisticsSOP({\n  steps,\n  setSteps,\n  shipments,\n  setShipments,\n  inventory,\n  setInventory,\n  orders,\n  setOrders\n}: LogisticsSOPProps) {\n  \n  const [activeSubsection, setActiveSubsection] = useState<\"B.A\" | \"B.B\" | \"B.C\">(\"B.A\");\n  const [searchQuery, setSearchQuery] = useState(\"\");\n  const [expandedStepId, setExpandedStepId] = useState<string | null>(null);\n  const [currentProjectId, setCurrentProjectId] = useState<string>(\"PROJ-BEANBAG\");\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\n\n  // Internal notification helper\n  const [feedback, setFeedback] = useState<string | null>(null);\n  const showFeedback = (msg: string) => {\n    setFeedback(msg);\n    setTimeout(() => setFeedback(null), 3000);\n  };\n\n  const triggerUploadNotification = (taskName: string, fileName: string) => {\n    setToastMessage(`\360\237\216\211 Google Drive Auto-Sync: Successfully uploaded \"${fileName}\" to Google Drive folder! Status for \"${taskName}\" updated to \"Completed\".`);\n    setTimeout(() => setToastMessage(null), 6000);\n  };"
