    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { \n  FileText, Search, User, Filter, AlertCircle, ChevronDown, CheckCircle2, \n  Clock, ArrowUpRight, HelpCircle, Eye, SlidersHorizontal, Settings\n} from \"lucide-react\";\nimport { SopStep } from \"../types\";\n\ninterface SourcingSOPProps {\n  steps: SopStep[];\n  setSteps: React.Dispatch<React.SetStateAction<SopStep[]>>;\n  onOpenMinorSheet: (sheetKey: string) => void;\n}\n\nexport default function SourcingSOP({ steps, setSteps, onOpenMinorSheet }: SourcingSOPProps) {\n  const [searchTerm, setSearchTerm] = useState(\"\");\n  const [selectedSub, setSelectedSub] = useState<string>(\"all\");\n  const [selectedOwner, setSelectedOwner] = useState<string>(\"all\");\n\n  const filterSteps = steps.filter(step => {\n    if (step.section !== \"A\") return false;\n    const matchesSearch = step.task.toLowerCase().includes(searchTerm.toLowerCase()) || \n                          step.id.toLowerCase().includes(searchTerm.toLowerCase());\n    const matchesSub = selectedSub === \"all\" || step.subsection.includes(selectedSub);\n    const matchesOwner = selectedOwner === \"all\" || step.taskOwner === selectedOwner;\n    return matchesSearch && matchesSub && matchesOwner;\n  });\n\n  const handleUpdateStatus = (stepId: string, newStatus: \"Completed\" | \"In Progress\" | \"Pending\" | \"Rejected\") => {\n    setSteps(prev => prev.map(step => {\n      if (step.id === stepId) {\n        return { \n          ...step, \n          status: newStatus,\n          approved: newStatus === \"Completed\" ? \"Approved\" : step.approved\n        };\n      }\n      return step;\n    }));\n  };\n\n  const subsections = [\n    { id: \"all\", label: \"All Sourcing (A.A & A.B)\" },\n    { id: \"Discovery and Feasiblity\", label: \"A.A: Discovery & Feasibility\" },\n    { id: \"Quotation, Quality and Compliance\", label: \"A.B: Quotation, Quality & Compliance\" },\n  ];\n\n  const distinctOwners = [\"all\", \"Project Manager\", \"Sourcing Manager\", \"General Manager\"];\n\n  return (\n    <div className=\"space-y-6\">\n      \n      {/* Visual Progress Dashboard cards */}\n      <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4\">\n        <div className=\"bg-white p-4 rounded-xl border border-slate-200\">\n          <div className=\"text-slate-400 text-xs font-semibold uppercase tracking-wider font-mono\">Discovery Progress</div>\n          <div className=\"flex items-baseline gap-2 mt-2\">\n            <span className=\"text-2xl font-black text-slate-900 font-display\">100%</span>\n            <span className=\"text-xs text-green-600 font-bold\">A.A Completed</span>\n          </div>\n          <div className=\"w-full bg-slate-100 h-1.5 rounded-full mt-3 overflow-hidden\">\n            <div className=\"bg-green-600 h-1.5\" style={{ width: \"100%\" }}></div>\n          </div>\n        </div>\n\n        <div className=\"bg-white p-4 rounded-xl border border-slate-200\">\n          <div className=\"text-slate-400 text-xs font-semibold uppercase tracking-wider font-mono\">Compliance & Quality</div>\n          <div className=\"flex items-baseline gap-2 mt-2\">\n            <span className=\"text-2xl font-black text-slate-900 font-display\">100%</span>\n            <span className=\"text-xs text-green-600 font-bold\">A.B Completed</span>\n          </div>\n          <div className=\"w-full bg-slate-100 h-1.5 rounded-full mt-3 overflow-hidden\">\n            <div className=\"bg-green-600 h-1.5\" style={{ width: \"100%\" }}></div>\n          </div>\n        </div>\n\n        <div className=\"bg-white p-4 rounded-xl border border-slate-200\">\n          <div className=\"text-slate-400 text-xs font-semibold uppercase tracking-wider font-mono\">Total SLA Duration</div>\n          <div className=\"flex items-baseline gap-2 mt-2\">\n            <span className=\"text-2xl font-black text-orange-600 font-display\">86 Days</span>\n            <span className=\"text-xs text-slate-500 font-mono\">Discovery to Contract</span>\n          </div>\n          <div className=\"w-full bg-slate-100 h-1.5 rounded-full mt-3 overflow-hidden\">\n            <div className=\"bg-orange-500 h-1.5\" style={{ width: \"86%\" }}></div>\n          </div>\n        </div>\n\n        <div className=\"bg-white p-4 rounded-xl border border-slate-200\">\n          <div className=\"text-slate-400 text-xs font-semibold uppercase tracking-wider font-mono\">Turkish Sourcing Matrix</div>\n          <div className=\"flex items-baseline gap-3 mt-2\">\n            <span className=\"text-2xl font-bold text-teal-800\">Bursa & Izmir</span>\n            <span className=\"text-xs font-bold text-emerald-600\">3 Audited Factories</span>\n          </div>\n          <div className=\"w-full bg-slate-100 h-1.5 rounded-full mt-3 overflow-hidden\">\n            <div className=\"bg-teal-700 h-1.5\" style={{ width: \"60%\" }}></div>\n          </div>\n        </div>\n      </div>\n\n      {/* Grid Filter Bar */}\n      <div className=\"bg-white p-4 rounded-xl border border-slate-200 flex flex-col md:flex-row items-center justify-between gap-4\">\n        <div className=\"flex flex-wrap items-center gap-2 w-full md:w-auto\">\n          {subsections.map(sub => (\n            <button\n              key={sub.id}\n              onClick={() => setSelectedSub(sub.id)}\n              className={`px-3.5 py-1.5 text-xs font-semibold rounded-lg transition-all ${\n                selectedSub === sub.id \n                  ? \"bg-slate-900 text-white shadow-sm\" \n                  : \"bg-slate-50 text-slate-600 hover:bg-slate-100\"\n              }`}\n            >\n              {sub.label}\n            </button>\n          ))}\n        </div>\n\n        <div className=\"flex items-center gap-2 w-full md:w-auto justify-end\">\n          <div className=\"relative w-full md:w-48\">\n            <Search className=\"absolute left-3 top-2.5 h-4 w-4 text-slate-400\" />\n            <input\n              type=\"text\"\n              placeholder=\"Search SOP steps...\"\n              value={searchTerm}\n              onChange={(e) => setSearchTerm(e.target.value)}\n              className=\"w-full p-2 pl-9 text-xs rounded-lg border border-slate-200 focus:outline-none focus:border-slate-400\"\n            />\n          </div>\n\n          <label className=\"text-xs font-semibold text-slate-500 hidden md:block\">Owner:</label>\n          <select\n            value={selectedOwner}\n            onChange={(e) => setSelectedOwner(e.target.value)}\n            className=\"p-2 text-xs border rounded-lg bg-white text-slate-700 focus:outline-none\"\n          >\n            {distinctOwners.map(owner => (\n              <option key={owner} value={owner}>\n                {owner === \"all\" ? \"All Owners\" : owner}\n              </option>\n            ))}\n          </select>\n        </div>\n      </div>\n\n      {/* SOURCING SOP MASTER TABLE */}\n      <div className=\"bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-sm border-collapse min-w-[1000px]\">\n            <thead>\n              <tr className=\"bg-slate-50 border-b border-slate-200 text-[10px] text-slate-400 uppercase tracking-widest font-mono\">\n                <th className=\"p-4 w-20\">Step ID</th>\n                <th className=\"p-4 w-1/4\">Sourcing Task Activity</th>\n                <th className=\"p-4\">Owner</th>\n                <th className=\"p-4\">KPI / Standard Metric</th>\n                <th className=\"p-4\">SLA Days</th>\n                <th className=\"p-4\">Status</th>\n                <th className=\"p-4\">Evidence Storage</th>\n                <th className=\"p-4 text-center\">Interactive Area</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100\">\n              {filterSteps.map(step => {\n                const hasMinorSheet = !!step.minorSheetKey;\n                return (\n                  <tr \n                    key={step.id} \n                    className={`hover:bg-slate-50/50 group transition ${hasMinorSheet ? \"cursor-pointer bg-amber-50/10 hover:bg-amber-50/30\" : \"\"}`}\n                    onClick={() => {\n                      if (hasMinorSheet && step.minorSheetKey) {\n                        onOpenMinorSheet(step.minorSheetKey);\n                      }\n                    }}\n                  >\n                    {/* ID Column */}\n                    <td className=\"p-4\">\n                      <span className={`text-[11px] font-mono font-bold tracking-tight px-2 py-1 rounded ${\n                        step.id.startsWith(\"A.A\") \n                          ? \"bg-indigo-50 text-indigo-700\" \n                          : \"bg-teal-50 text-teal-700\"\n                      }`}>\n                        {step.id}\n                      </span>\n                    </td>\n\n                    {/* Task Title with Description Indicators */}\n                    <td className=\"p-4\">\n                      <div>\n                        <div className=\"font-semibold text-slate-800\">{step.task}</div>\n                        <div className=\"text-[10px] text-slate-400 font-mono mt-0.5\">{step.requester} (Req)</div>\n                      </div>\n                    </td>\n\n                    {/* Owner */}\n                    <td className=\"p-4\">\n                      <span className=\"text-xs font-semibold text-slate-600 block\">\n                        {step.taskOwner}\n                      </span>\n                    </td>\n\n                    {/* KPI Metric */}\n                    <td className=\"p-4\">\n                      <div className=\"text-xs text-slate-500 leading-tight max-w-[200px]\">\n                        {step.kpiMetric}\n                      </div>\n                    </td>\n\n                    {/* KPI Timeout Days */}\n                    <td className=\"p-4\">\n                      <span className=\"font-mono text-xs font-bold text-slate-700\">\n                        {step.kpiTimeDays}d\n                      </span>\n                    </td>\n\n                    {/* Work status interactive dropdown */}\n                    <td className=\"p-4\" onClick={(e) => e.stopPropagation()}>\n                      <select\n                        value={step.status}\n                        onChange={(e) => handleUpdateStatus(step.id, e.target.value as any)}\n                        className={`text-xs font-bold py-1 px-2.5 rounded-full border cursor-pointer focus:outline-none ${\n                          step.status === \"Completed\"\n                            ? \"bg-green-100 text-green-800 border-green-200\"\n                            : step.status === \"In Progress\"\n                            ? \"bg-blue-100 text-blue-800 border-blue-200\"\n                            : \"bg-slate-100 text-slate-700 border-slate-200\"\n                        }`}\n                      >\n                        <option value=\"Completed\">Completed</option>\n                        <option value=\"In Progress\">In Progress</option>\n                        <option value=\"Pending\">Pending</option>\n                      </select>\n                    </td>\n\n                    {/* Required storage folder link representation */}\n                    <td className=\"p-4\">\n                      <div className=\"text-xs font-medium text-slate-500 hover:text-slate-900 flex items-center gap-1\">\n                        <FileText className=\"h-3.5 w-3.5 text-slate-400 inline\" />\n                        <span className=\"truncate max-w-[120px]\" title={step.storageLocation}>\n                          {step.storageLocation || \"N/A\"}\n                        </span>\n                      </div>\n                    </td>\n\n                    {/* Interactive Sourcing worksheet area pointer */}\n                    <td className=\"p-4 text-center\" onClick={(e) => e.stopPropagation()}>\n                      {hasMinorSheet ? (\n                        <button\n                          id={`minor-sheet-trigger-${step.id}`}\n                          onClick={() => step.minorSheetKey && onOpenMinorSheet(step.minorSheetKey)}\n                          className=\"bg-amber-600 hover:bg-amber-700 text-white font-bold text-[10px] uppercase px-3 py-1.5 rounded-lg flex items-center justify-center gap-1.5 mx-auto transition-all shadow-sm cursor-pointer\"\n                        >\n                          <Eye className=\"h-4 w-4\" /> Open Solver\n                        </button>\n                      ) : (\n                        <div className=\"text-xs text-slate-400 font-mono\">- Standard Step -</div>\n                      )}\n                    </td>\n                  </tr>\n                );\n              })}\n            </tbody>\n          </table>\n        </div>\n        \n        {/* Table count info */}\n        <div className=\"bg-slate-50 border-t p-3 text-xs text-slate-500 font-medium flex items-center justify-between\">\n          <span>Showing {filterSteps.length} of 21 crucial Trade2Turkey standard sourcing activities</span>\n          <span className=\"text-orange-600 font-semibold\">\342\230\205 Golden rules of sourcing: Verification, Double-stitch safety & 0% customs ATR compliance.</span>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    }
