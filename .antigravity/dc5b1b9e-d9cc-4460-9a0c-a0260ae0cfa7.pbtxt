          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  onChange={(e) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    setRfqs(prev => prev.map(r => r.id === selectedRfqId ? { ...r, status: e.target.value as any } : r));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    showBanner(`RFQ Campaign status updated to ${e.target.value}`);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
