          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          <td className=\"py-2.5 text-right\">${baseRaw.toFixed(2)}</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          <td className=\"py-2.5 text-right text-red-400\">+{mat.scrapRatePercent}%</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          <td className=\"py-2.5 text-right text-slate-500\">${waste.toFixed(3)}</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          <td className=\"py-2.5 text-right text-orange-300 font-bold\">${adjusted.toFixed(2)}</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        </tr>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
