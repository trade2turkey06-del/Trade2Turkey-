          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        const val = Number(e.target.value);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        setRecipes(prev => prev.map(r => r.id === selectedRecipeId ? { ...r, laborCostUsd: val } : r));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      }}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
