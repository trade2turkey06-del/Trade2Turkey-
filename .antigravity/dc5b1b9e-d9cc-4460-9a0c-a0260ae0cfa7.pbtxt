        }
        lines {
          text: "      materialSubtotal += rawCost;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      wastageCost += (effectiveCost - rawCost);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      parts.push({"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        name: mat.name,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
