  file_change {
    absolute_path_uri: "file:///src/components/ClientPortal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { \n  ShieldCheck, Ship, FileText, Download, Award, Coins, Scale, \n  MapPin, Clock, Lock, CheckCircle2, ListFilter, Users, BarChart2\n} from \"lucide-react\";\nimport { ShipmentMilestone, Supplier, ProductRecipe } from \"../types\";\n\ninterface ClientPortalProps {\n  shipments: ShipmentMilestone[];\n  suppliers: Supplier[];\n  recipes: ProductRecipe[];\n}\n\nexport default function ClientPortal({ shipments, suppliers, recipes }: ClientPortalProps) {\n  \n  // Simulated Secure Passcode\n  const [passcode, setPasscode] = useState(\"\");\n  const [isAuthenticated, setIsAuthenticated] = useState(true); // default true for preview convenience\n\n  const [activeTab, setActiveTab] = useState<\"tracking\" | \"evidence\" | \"transparent-cost\">(\"tracking\");\n\n  // Select the active shipment and supplier\n  const activeShipment = shipments[0];\n  const auditSupplier = suppliers.find(s => s.name === activeShipment?.supplierName) || suppliers[0];\n  const activeRecipe = recipes.find(r => r.productName === activeShipment?.productName) || recipes[0];\n\n  const handleAuth = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (passcode.toLowerCase() === \"turkey2026\") {\n      setIsAuthenticated(true);\n    } else {\n      alert(\"Invalid Client Access Passcode! For testing, use: turkey2026\");\n    }\n  };\n\n  // Recipe Calculations\n  const getRecipeCostMetrics = (recipe: ProductRecipe) => {\n    if (!recipe) return { material: 0, waste: 0, parts: [], grandTotal: 0 };\n    let materialSubtotal = 0;\n    let wastageCost = 0;\n    const parts: any[] = [];\n\n    recipe.materials.forEach(mat => {\n      const rawCost = mat.qtyRequired * mat.unitCostUsd;\n      const effectiveCost = rawCost * (1 + (mat.scrapRatePercent / 100));\n      materialSubtotal += rawCost;\n      wastageCost += (effectiveCost - rawCost);\n      parts.push({\n        name: mat.name,\n        qty: `${mat.qtyRequired} ${mat.unit}`,\n        rate: mat.unitCostUsd,\n        scrap: mat.scrapRatePercent,\n        effective: parseFloat(effectiveCost.toFixed(2))\n      });\n    });\n\n    const grandTotal = materialSubtotal + wastageCost + recipe.laborCostUsd + recipe.packagingCostUsd + recipe.overheadCostUsd;\n\n    return {\n      material: parseFloat(materialSubtotal.toFixed(2)),\n      waste: parseFloat(wastageCost.toFixed(2)),\n      grandTotal: parseFloat(grandTotal.toFixed(2)),\n      parts\n    };\n  };\n\n  const recipeMetrics = getRecipeCostMetrics(activeRecipe);\n\n  if (!isAuthenticated) {\n    return (\n      <div className=\"max-w-md mx-auto my-12 bg-white rounded-2xl border border-slate-200 p-8 shadow-sm text-center space-y-6\">\n        <div className=\"h-12 w-12 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center mx-auto text-xl\">\n          <Lock className=\"h-6 w-6\" />\n        </div>\n        <div>\n          <h3 className=\"text-lg font-bold font-display text-slate-950\">Secure Client Verification & Logistics Portal</h3>\n          <p className=\"text-xs text-slate-500 mt-1 leading-relaxed\">\n            Enter your Trade2Turkey client passcode to view your shipment milestone tracking, factory audit evidence files, and transparent recipes.\n          </p>\n        </div>\n\n        <form onSubmit={handleAuth} className=\"space-y-3\">\n          <input\n            type=\"password\"\n            placeholder=\"Enter Client Passcode\"\n            value={passcode}\n            onChange={(e) => setPasscode(e.target.value)}\n            className=\"w-full p-2.5 border rounded-lg text-sm text-center focus:border-orange-500 bg-slate-50 font-mono\"\n          />\n          <p className=\"text-[10px] text-slate-400\">Preview Demo Key: <strong className=\"text-slate-600\">turkey2026</strong></p>\n\n          <button\n            type=\"submit\"\n            className=\"w-full bg-slate-900 hover:bg-black text-white text-xs font-semibold py-2.5 rounded-lg transition cursor-pointer\"\n          >\n            Authenticate Connection\n          </button>\n        </form>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      \n      {/* Branded secure header */}\n      <div className=\"bg-slate-950 text-white p-6 rounded-2xl border border-slate-900 flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center gap-1.5 text-[10px] font-mono tracking-wider font-semibold text-orange-400\">\n            <ShieldCheck className=\"h-3.5 w-3.5 text-orange-500\" /> SECURE CLIENT CONNECTIVITY ACTIVE\n          </div>\n          <h2 className=\"text-xl font-bold font-display text-white mt-1\">Client Board: ComfortPro Large Bean Bags Sourcing</h2>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Partner: <strong className=\"text-white\">{auditSupplier?.name}</strong> | Standard Trade Portals: Ambarli Port (Istanbul) to Rotterdam\n          </p>\n        </div>\n\n        <div className=\"text-xs text-slate-400 flex items-center gap-2 bg-slate-900/60 p-2.5 rounded-xl border border-slate-800\">\n          <Clock className=\"h-4 w-4 text-slate-500 shrink-0\" />\n          <div>\n            <div className=\"font-mono text-slate-300\">2026-06-03 19:26 UTC</div>\n            <div className=\"text-[9px] text-slate-500\">Auto-refresh frequency: Realtime</div>\n          </div>\n        </div>\n      </div>\n\n      {/* Internal Navigation tabs for Client Mode */}\n      <div className=\"flex border-b border-slate-200\">\n        <button\n          onClick={() => setActiveTab(\"tracking\")}\n          className={`flex items-center gap-2 px-6 py-2.5 text-xs font-bold border-b-2 transition ${\n            activeTab === \"tracking\"\n              ? \"border-orange-500 text-orange-600\"\n              : \"border-transparent text-slate-500 hover:text-slate-900\"\n          }`}\n        >\n          <Ship className=\"h-4 w-4\" /> Live Sea Transit Milestones\n        </button>\n        <button\n          onClick={() => setActiveTab(\"evidence\")}\n          className={`flex items-center gap-2 px-6 py-2.5 text-xs font-bold border-b-2 transition ${\n            activeTab === \"evidence\"\n              ? \"border-orange-500 text-orange-600\"\n              : \"border-transparent text-slate-500 hover:text-slate-900\"\n          }`}\n        >\n          <FileText className=\"h-4 w-4\" /> Quality Control & Site Evidences\n        </button>\n        <button\n          onClick={() => setActiveTab(\"transparent-cost\")}\n          className={`flex items-center gap-2 px-6 py-2.5 text-xs font-bold border-b-2 transition ${\n            activeTab === \"transparent-cost\"\n              ? \"border-orange-500 text-orange-600\"\n              : \"border-transparent text-slate-500 hover:text-slate-900\"\n          }`}\n        >\n          <Coins className=\"h-4 w-4\" /> Granular Component Recipe Costing\n        </button>\n      </div>\n\n      {/* --- TAB CONTENT 1: GPS VESSEL TRACKING --- */}\n      {activeTab === \"tracking\" && activeShipment && (\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 bg-white p-6 rounded-2xl border border-slate-200\">\n          <div className=\"lg:col-span-4 space-y-4\">\n            <div className=\"bg-slate-50 p-4 rounded-xl border border-slate-150 text-xs\">\n              <span className=\"text-[10px] text-slate-400 font-mono font-bold block uppercase\">SHIPMENT METRICS</span>\n              <div className=\"space-y-3 mt-3\">\n                <div className=\"flex justify-between\">\n                  <span className=\"text-slate-500\">Waybill Seal No:</span>\n                  <strong className=\"text-slate-800 font-mono\">MSCT-100293</strong>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span className=\"text-slate-500\">Carrier Vessel:</span>\n                  <strong className=\"text-slate-800\">{activeShipment.vesselName}</strong>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span className=\"text-slate-500\">Container Dim:</span>\n                  <strong className=\"text-slate-800\">40ft High Cube</strong>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span className=\"text-slate-500\">Departure port:</span>\n                  <strong className=\"text-slate-850\">Port of Ambarli, Istanbul</strong>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span className=\"text-slate-500\">Arrival Port:</span>\n                  <strong className=\"text-slate-850\">Port of Rotterdam</strong>\n                </div>\n                <div className=\"flex justify-between pt-2 border-t font-mono\">\n                  <span className=\"text-slate-500 font-bold\">ETA Target:</span>\n                  <strong className=\"text-orange-600\">{activeShipment.estimatedArrival}</strong>\n                </div>\n              </div>\n            </div>\n\n            {/* Simulated Live Route Sea coordinates */}\n            <div className=\"bg-slate-900 text-slate-200 p-4 rounded-xl border border-slate-800 text-xs text-center space-y-1.5 font-mono\">\n              <span className=\"text-slate-500 block text-[10px]\">CURRENT SEA MAP SECTOR</span>\n              <div className=\"text-medium text-slate-100\">Mediterranean Sea Sector - Strait of Messina</div>\n              <div className=\"text-xs text-teal-400\">LAT {activeShipment.latitude}\302\260 N | LON {activeShipment.longitude}\302\260 E</div>\n            </div>\n          </div>\n\n          <div className=\"lg:col-span-8 border-l border-slate-100 pl-0 lg:pl-6 space-y-6\">\n            <div>\n              <h4 className=\"text-base font-bold text-slate-850\">Live Vessel Milestones Feed</h4>\n              <p className=\"text-xs text-slate-500\">Monitor custom clearance milestones, packing photos and sailing logistics leg-by-leg:</p>\n            </div>\n\n            <div className=\"relative pl-6 space-y-5 before:absolute before:left-[11px] before:top-2 before:bottom-2 before:w-0.5 before:bg-slate-200 text-xs\">\n              {activeShipment.milestones.map((mil, idx) => {\n                const isActive = idx === activeShipment.currentMilestoneIndex;\n                const isPassed = idx < activeShipment.currentMilestoneIndex;\n                return (\n                  <div key={mil.title} className=\"relative flex gap-4\">\n                    <div className={`absolute -left-[20px] h-3 w-3 rounded-full border flex items-center justify-center ${\n                      isActive \n                        ? \"bg-orange-500 border-white text-slate-900\" \n                        : isPassed \n                        ? \"bg-green-600 border-green-600 text-white\" \n                        : \"bg-slate-100 border-slate-200\"\n                    }`}>\n                      {isPassed && <span className=\"text-[6px]\">\342\234\223</span>}\n                    </div>\n\n                    <div className=\"flex-1\">\n                      <div className=\"flex justify-between items-center bg-slate-50/50 p-2.5 rounded-lg border border-slate-100\">\n                        <div>\n                          <strong className={isActive ? \"text-orange-600\" : isPassed ? \"text-slate-800\" : \"text-slate-400\"}>\n                            {mil.title}\n                          </strong>\n                          <p className=\"text-[11px] text-slate-500 mt-1 leading-relaxed\">{mil.description}</p>\n                        </div>\n                        <span className=\"font-mono text-[9px] text-slate-400 whitespace-nowrap ml-3\">{mil.date}</span>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* --- TAB CONTENT 2: TRANSPARENT EVIDENCE FILES --- */}\n      {activeTab === \"evidence\" && (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          \n          {/* Site Audit Report Card */}\n          <div className=\"bg-white p-6 rounded-2xl border border-slate-200 space-y-4\">\n            <div className=\"flex items-center gap-2\">\n              <Award className=\"h-5 w-5 text-orange-500\" />\n              <h4 className=\"text-base font-bold text-slate-950\">Factory Audited Credentials</h4>\n            </div>\n            <p className=\"text-xs text-slate-500 leading-relaxed\">\n              We score and evaluate each Bursa, Turkey factory layout under strict guidelines: employee fair wages, safety exits, non-toxic chemical raw inputs.\n            </p>\n\n            <div className=\"bg-slate-50 p-4 rounded-xl border border-slate-100 space-y-3 text-xs\">\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-500\">Auditor-in-charge:</span>\n                <strong className=\"text-slate-800\">Trade2Turkey Sourcing Team</strong>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-500\">Site Compliance Score:</span>\n                <strong className=\"text-green-600 font-mono\">{auditSupplier?.auditScorePercent}% Score</strong>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-slate-500\">NDA Validation:</span>\n                <strong className=\"text-slate-800 font-mono\">Completed (Signed 2026-06-16)</strong>\n              </div>\n            </div>\n\n            <div className=\"border-t pt-4\">\n              <div className=\"text-xs font-bold text-slate-850 mb-2\">Direct evidence PDFs for download:</div>\n              <div className=\"space-y-2\">\n                {auditSupplier?.evidenceFiles.map(fn => (\n                  <div key={fn.name} className=\"flex justify-between items-center p-2.5 rounded-lg border bg-slate-50/50 text-xs\">\n                    <div className=\"flex items-center gap-2\">\n                      <FileText className=\"h-4 w-4 text-slate-400\" />\n                      <span className=\"text-[11px] font-semibold text-slate-700 truncate max-w-[170px]\">{fn.name}</span>\n                    </div>\n                    <a href={fn.downloadUrl} className=\"text-[10px] text-blue-600 font-bold font-mono\">\n                      Download ({fn.size})\n                    </a>\n                  </div>\n                ))}\n              </div>\n            </div>\n          </div>\n\n          {/* Sourcing Inspection Photos */}\n          <div className=\"bg-white p-6 rounded-2xl border border-slate-200 space-y-4\">\n            <h4 className=\"text-base font-bold text-slate-950\">Active Batch QC Photography</h4>\n            <p className=\"text-xs text-slate-500\">Verify double-stitching quality and vacuum compressions of ComfortPro bean bag fillings:</p>\n\n            <div className=\"grid grid-cols-3 gap-3\">\n              {activeShipment?.cargoPhotos.map(ph => (\n                <div key={ph.id} className=\"relative rounded-lg overflow-hidden border bg-slate-100 group\">\n                  <img src={ph.url} alt={ph.title} className=\"h-20 w-full object-cover group-hover:scale-105 transition duration-500\" />\n                  <div className=\"absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition p-1.5 flex flex-col justify-end text-white text-[9px]\">\n                    <strong>{ph.title}</strong>\n                  </div>\n                </div>\n              ))}\n            </div>\n\n            <div className=\"p-4 bg-orange-50 border border-orange-100 rounded-xl flex gap-3 text-xs text-orange-800\">\n              <ShieldCheck className=\"h-5 w-5 text-orange-600 shrink-0 mt-0.5\" />\n              <div>\n                <h5 className=\"font-bold\">Trade2Turkey Standard Certificate</h5>\n                <p className=\"text-[11px] text-orange-700 leading-relaxed mt-0.5\">\n                  This product has been filled by virgin non-toxic EPS safe pellets. Certified REACH compliant.\n                </p>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* --- TAB CONTENT 3: TRANSPARENT COMPONENT COST BREAKDOWNS --- */}\n      {activeTab === \"transparent-cost\" && activeRecipe && (\n        <div className=\"bg-white p-6 rounded-2xl border border-slate-200 space-y-6\">\n          <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b pb-4\">\n            <div>\n              <h4 className=\"text-base font-bold text-slate-905\">Transparent Bill-of-Materials Breakdown</h4>\n              <p className=\"text-xs text-slate-500 mt-1\">Granular components list of active recipe materials & processing overhead offsets:</p>\n            </div>\n            \n            <div className=\"text-right\">\n              <span className=\"text-[10px] uppercase font-mono font-bold text-slate-400\">Calculated Direct Unit Cost</span>\n              <strong className=\"text-2xl font-black text-slate-950 block font-mono\">${recipeMetrics.grandTotal.toFixed(2)}</strong>\n            </div>\n          </div>\n\n          <div className=\"overflow-x-auto border rounded-xl bg-slate-50/50\">\n            <table className=\"w-full text-left text-xs border-collapse\">\n              <thead>\n                <tr className=\"bg-slate-100 border-b p-3 text-slate-500 font-bold font-mono\">\n                  <th className=\"p-3\">Recipe Component Raw Item</th>\n                  <th className=\"p-3\">Quantity Ratio</th>\n                  <th className=\"p-3 font-mono\">Base Rate (USD)</th>\n                  <th className=\"p-3 font-mono text-center\">Scrap Waste Factor</th>\n                  <th className=\"p-3 text-teal-800\">Direct Mill Source</th>\n                  <th className=\"p-3 text-right\">Adjusted Effective Price</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-150 text-slate-700\">\n                {recipeMetrics.parts.map((p: any) => (\n                  <tr key={p.name} className=\"hover:bg-slate-50\">\n                    <td className=\"p-3 font-semibold text-slate-800\">{p.name}</td>\n                    <td className=\"p-3\">{p.qty}</td>\n                    <td className=\"p-3 font-mono\">${p.rate.toFixed(3)}</td>\n                    <td className=\"p-3 text-center text-red-500 font-mono\">+{p.scrap}%</td>\n                    <td className=\"p-3 font-semibold text-teal-700\">{p.source || \"Bursa Thread Factory\"}</td>\n                    <td className=\"p-3 text-right font-bold text-slate-950 font-mono\">${p.effective.toFixed(2)}</td>\n                  </tr>\n                ))}\n                \n                {/* Additional overhead calculations as columns */}\n                <tr className=\"bg-slate-50 font-semibold text-slate-800\">\n                  <td colSpan={5} className=\"p-3 text-right text-xs\">Labour & Sewing Add-on:</td>\n                  <td className=\"p-3 text-right font-mono text-slate-800\">${activeRecipe.laborCostUsd.toFixed(2)}</td>\n                </tr>\n                <tr className=\"bg-slate-50 font-semibold text-slate-800\">\n                  <td colSpan={5} className=\"p-3 text-right text-xs\">Master Export Packaging Box Fee:</td>\n                  <td className=\"p-3 text-right font-mono text-slate-800\">${activeRecipe.packagingCostUsd.toFixed(2)}</td>\n                </tr>\n                <tr className=\"bg-slate-50 font-semibold text-slate-800 border-t-2 border-slate-350\">\n                  <td colSpan={5} className=\"p-3 text-right text-xs font-bold text-slate-950\">Effective EXW Product total:</td>\n                  <td className=\"p-3 text-right text-orange-600 font-black text-[13px] font-mono\">${recipeMetrics.grandTotal.toFixed(2)}</td>\n                </tr>\n              </tbody>\n            </table>\n          </div>\n\n          <div className=\"p-4 bg-teal-50 border border-teal-100 rounded-xl flex gap-3 text-xs leading-relaxed text-teal-800\">\n            <Coins className=\"h-5 w-5 text-teal-600 mt-0.5 shrink-0\" />\n            <div>\n              <h5 className=\"font-bold text-teal-950\">Transparent Trust Program</h5>\n              <p className=\"mt-1\">\n                At Trade2Turkey, we calculate and declare every granular penny on fabric yards and safety zippers transparently. There are no surprise markups in our sourcing process.\n              </p>\n            </div>\n          </div>\n        </div>\n      )}\n\n    </div>\n  );\n}\n"
