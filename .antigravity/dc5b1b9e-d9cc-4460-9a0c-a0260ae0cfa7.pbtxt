        lines {
          text: "                      const baseRaw = mat.qtyRequired * mat.unitCostUsd;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      const waste = baseRaw * (mat.scrapRatePercent / 100);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      const adjusted = baseRaw + waste;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
