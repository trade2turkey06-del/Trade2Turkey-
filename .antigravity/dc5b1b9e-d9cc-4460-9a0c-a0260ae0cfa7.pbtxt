        }
        lines {
          text: "                - Direct Qty: {currentRfq.targetQty} units<br/>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                - Desired Lead Time: Under 25 Days<br/><br/>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                Please fill in your raw material specification breakdowns, packaging weight metrics and earliest shipping date quotes."
