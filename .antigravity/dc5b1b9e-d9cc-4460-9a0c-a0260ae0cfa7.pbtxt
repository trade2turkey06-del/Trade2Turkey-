50\" cy=\"80\" r=\"1.5\" fill=\"#38bdf8\" />\n              <circle cx=\"72\" cy=\"35\" r=\"2.5\" fill=\"#ffffff\" />\n              <circle cx=\"72\" cy=\"35\" r=\"5\" stroke=\"#ffffff\" strokeWidth=\"0.5\" opacity=\"0.5\" />\n              <circle cx=\"28\" cy=\"65\" r=\"2\" fill=\"#22d3ee\" />\n              <circle cx=\"50\" cy=\"50\" r=\"3\" fill=\"#ffffff\" />\n              <circle cx=\"50\" cy=\"50\" r=\"7\" stroke=\"#ffffff\" strokeWidth=\"0.5\" opacity=\"0.4\" />\n              <circle cx=\"38\" cy=\"48\" r=\"1\" fill=\"#e0f2fe\" />\n              <circle cx=\"62\" cy=\"52\" r=\"1\" fill=\"#e0f2fe\" />\n              \n              <defs>\n                <radialGradient id=\"globeGradient\" cx=\"0\" cy=\"0\" r=\"1\" gradientUnits=\"userSpaceOnUse\" transform=\"translate(42 42) rotate(45) scale(46)\">\n                  <stop offset=\"0%\" stopColor=\"#22d3ee\" />\n                  <stop offset=\"60%\" stopColor=\"#1B3058\" />\n                  <stop offset=\"100%\" stopColor=\"#000000\" />\n                </radialGradient>\n              </defs>\n            </svg>\n          </div>\n          <div>\n            <h1 className=\"text-2xl font-black text-white tracking-tight font-display\">Trade2Turkey</h1>\n            <p className=\"text-[10px] text-sky-400 font-extrabold uppercase tracking-widest font-mono\">\n              Digital Workflows, Disciplined Sourcing\n            </p>\n            <p className=\"text-xs italic text-neutral-400 mt-2 max-w-sm mx-auto font-sans\">\n              \"Where data meets manufacturing reality.\"\n            </p>\n          </div>\n        </div>"
