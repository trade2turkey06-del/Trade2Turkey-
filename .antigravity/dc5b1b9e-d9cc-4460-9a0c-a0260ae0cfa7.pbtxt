    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState, useEffect } from \"react\";\nimport Navbar from \"./components/Navbar\";\nimport SourcingSOP from \"./components/SourcingSOP\";\nimport MinorSheets from \"./components/MinorSheets\";\nimport LogisticsSOP from \"./components/LogisticsSOP\";\nimport SupplierScoring from \"./components/SupplierScoring\";\nimport ClientPortal from \"./components/ClientPortal\";\nimport ReportGenerator from \"./components/ReportGenerator\";\nimport LoginScreen from \"./components/LoginScreen\";\nimport { UserTenant, INITIAL_TENANTS } from \"./data/usersData\";\nimport { setDriveAuth } from \"./lib/driveAuth\";\n\nimport { \n  INITIAL_SOP_STEPS, INITIAL_TARGET_SPECS, INITIAL_RFQS, \n  INITIAL_VALUE_CHAIN_COSTINGS, INITIAL_RFQ_MATRICES, \n  INITIAL_PRODUCT_RECIPES, INITIAL_SUPPLIERS, INITIAL_SHIPMENTS, \n  INITIAL_INVENTORY_ITEMS, INITIAL_FULFILLMENT_ORDERS,\n  SopStep, TargetSpecification, RfqSubmission, ValueChainCosting,\n  RfqComparativeMatrix, ProductRecipe, Supplier, ShipmentMilestone,\n  InventoryItem, FulfillmentOrder\n} from \"./types\";\n\nimport { \n  FileSpreadsheet, ClipboardList, ShieldAlert, Users, PlusCircle,\n  Compass, Coins, Truck, Settings, FileText, CheckCircle, Eye, ShieldCheck, Mail, Lock\n} from \"lucide-react\";\n\nexport default function App() {\n  // Active corporate context state\n  const [currentUser, setCurrentUser] = useState<UserTenant | null>(() => {\n    try {\n      const stored = localStorage.getItem(\"t2t_current_user\");\n      return stored ? JSON.parse(stored) : null;\n    } catch {\n      return null;\n    }\n  });\n\n  const [activeProjectId, setActiveProjectId] = useState<string>(\"PROJ-BEANBAG\");\n\n  // Dynamic user store in localStorage to persist new corporate clients added by the owner\n  const [customUsers, setCustomUsers] = useState<UserTenant[]>(() => {\n    try {\n      const stored = localStorage.getItem(\"t2t_custom_users\");\n      return stored ? JSON.parse(stored) : [];\n    } catch {\n      return [];\n    }\n  });\n\n  // Admin Workspace Creation State\n  const [newClientEmail, setNewClientEmail] = useState(\"\");\n  const [newClientCompany, setNewClientCompany] = useState(\"\");\n  const [newClientProject, setNewClientProject] = useState(\"PROJ-BEANBAG\");\n  const [adminFeedback, setAdminFeedback] = useState<string | null>(null);\n\n  // Synchronize dynamic user profile mapping when logging in\n  useEffect(() => {\n    if (currentUser) {\n      localStorage.setItem(\"t2t_current_user\", JSON.stringify(currentUser));\n      // Force change context to the tenant\'s exact project ID if they are a regular client\n      if (currentUser.role === \"client\") {\n        setActiveProjectId(currentUser.projectId);\n      }\n    } else {\n      localStorage.removeItem(\"t2t_current_user\");\n    }\n  }, [currentUser]);\n\n  // Tab control\n  const [currentTab, setCurrentTab] = useState<string>(\"sourcing\");\n  const [clientMode, setClientMode] = useState<boolean>(false);\n  \n  // Embedded Minor sheet key tracker (linked from click on certain Major SOP steps)\n  const [activeMinorSheetKey, setActiveMinorSheetKey] = useState<string | null>(null);\n\n  // Core application persisted states\n  const [sopSteps, setSopSteps] = useState<SopStep[]>([]);\n  const [targetSpecs, setTargetSpecs] = useState<TargetSpecification[]>([]);\n  const [rfqs, setRfqs] = useState<RfqSubmission[]>([]);\n  const [valueChain, setValueChain] = useState<ValueChainCosting[]>([]);\n  const [rfqMatrix, setRfqMatrix] = useState<RfqComparativeMatrix[]>([]);\n  const [recipes, setRecipes] = useState<ProductRecipe[]>([]);\n  const [suppliers, setSuppliers] = useState<Supplier[]>([]);\n  const [shipments, setShipments] = useState<ShipmentMilestone[]>([]);\n  const [inventory, setInventory] = useState<InventoryItem[]>([]);\n  const [fulfillmentOrders, setFulfillmentOrders] = useState<FulfillmentOrder[]>([]);\n\n  // 1. Initial State Hydrator\n  useEffect(() => {\n    try {\n      const getOrInit = (key: string, initial: any) => {\n        const stored = localStorage.getItem(`t2t_v1_${key}`);\n        if (stored) {\n          return JSON.parse(stored);\n        }\n        return initial;\n      };\n\n      setSopSteps(getOrInit(\"sop_steps\", INITIAL_SOP_STEPS));\n      setTargetSpecs(getOrInit(\"target_specs\", INITIAL_TARGET_SPECS));\n      setRfqs(getOrInit(\"rfqs\", INITIAL_RFQS));\n      setValueChain(getOrInit(\"value_chain\", INITIAL_VALUE_CHAIN_COSTINGS));\n      setRfqMatrix(getOrInit(\"rfq_matrix\", INITIAL_RFQ_MATRICES));\n      setRecipes(getOrInit(\"recipes\", INITIAL_PRODUCT_RECIPES));\n      setSuppliers(getOrInit(\"suppliers\", INITIAL_SUPPLIERS));\n      setShipments(getOrInit(\"shipments\", INITIAL_SHIPMENTS));\n      setInventory(getOrInit(\"inventory\", INITIAL_INVENTORY_ITEMS));\n      setFulfillmentOrders(getOrInit(\"orders\", INITIAL_FULFILLMENT_ORDERS));\n    } catch (e) {\n      console.warn(\"Local storage fallback loaded.\", e);\n    }\n  }, []);\n\n  // Sync Google Drive OAuth postMessage messages\n  useEffect(() => {\n    const handleGoogleMessage = (event: MessageEvent) => {\n      if (event.data?.type === \"OAUTH_AUTH_SUCCESS\") {\n        const { accessToken, email, picture } = event.data;\n        setDriveAuth(accessToken, email, picture);\n      }\n    };\n    window.addEventListener(\"message\", handleGoogleMessage);\n    return () => window.removeEventListener(\"message\", handleGoogleMessage);\n  }, []);\n\n  // 2. State Sync persistence autoSaver\n  useEffect(() => {\n    if (sopSteps.length === 0) return; // avoid overwrite during startup\n    try {\n      localStorage.setItem(\"t2t_v1_sop_steps\", JSON.stringify(sopSteps));\n      localStorage.setItem(\"t2t_v1_target_specs\", JSON.stringify(targetSpecs));\n      localStorage.setItem(\"t2t_v1_rfqs\", JSON.stringify(rfqs));\n      localStorage.setItem(\"t2t_v1_value_chain\", JSON.stringify(valueChain));\n      localStorage.setItem(\"t2t_v1_rfq_matrix\", JSON.stringify(rfqMatrix));\n      localStorage.setItem(\"t2t_v1_recipes\", JSON.stringify(recipes));\n      localStorage.setItem(\"t2t_v1_suppliers\", JSON.stringify(suppliers));\n      localStorage.setItem(\"t2t_v1_shipments\", JSON.stringify(shipments));\n      localStorage.setItem(\"t2t_v1_inventory\", JSON.stringify(inventory));\n      localStorage.setItem(\"t2t_v1_orders\", JSON.stringify(fulfillmentOrders));\n    } catch (e) {\n      console.warn(\"Storage quota or disabled storage.\", e);\n    }\n  }, [\n    sopSteps, targetSpecs, rfqs, valueChain, rfqMatrix, \n    recipes, suppliers, shipments, inventory, fulfillmentOrders\n  ]);\n\n  // Handle Logout Session clear\n  const handleLogout = () => {\n    setCurrentUser(null);\n    setClientMode(false);\n    setCurrentTab(\"sourcing\");\n  };\n\n  // Add Dynamic user workspace as administrator\n  const handleAddClientAction = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newClientEmail || !newClientCompany) {\n      setAdminFeedback(\"Please fill out both email and team properties.\");\n      return;\n    }\n\n    const cleanedEmail = newClientEmail.trim().toLowerCase();\n    const prefix = cleanedEmail.split(\"@\")[0];\n    const generatedPass = `${prefix}2026`;\n\n    // Create Tenant Model\n    const newTenant: UserTenant = {\n      id: `custom_${prefix}_${Date.now()}`,\n      email: cleanedEmail,\n      companyName: newClientCompany,\n      role: \"client\",\n      projectId: newClientProject,\n      driveFolderName: `${newClientProject} (${newClientCompany})`\n    };\n\n    // Save in state & localStorage\n    const updated = [...customUsers, newTenant];\n    setCustomUsers(updated);\n    localStorage.setItem(\"t2t_custom_users\", JSON.stringify(updated));\n\n    // Save Preset Credentials\n    // For demonstration, registering on-the-fly dynamically injects credentials matched in login preset handler\n    try {\n      const storedPresets = localStorage.getItem(\"t2t_preset_creds\") || \"{}\";\n      const parsedPresets = JSON.parse(storedPresets);\n      parsedPresets[cleanedEmail] = { password: generatedPass, id: newTenant.id };\n      localStorage.setItem(\"t2t_preset_creds\", JSON.stringify(parsedPresets));\n    } catch (err) {\n      console.warn(\"Failed preset cred save\", err);\n    }\n\n    // Success notification\n    setAdminFeedback(`\360\237\216\211 Success! Workspace created for ${newClientCompany}. Credentials set to Email: ${cleanedEmail} | Password: ${generatedPass}`);\n    setNewClientEmail(\"\");\n    setNewClientCompany(\"\");\n    \n    setTimeout(() => setAdminFeedback(null), 12000);\n  };\n\n  // Switch workspace context and simulate dynamic client login\n  const handleAdminInspectClient = (tenant: UserTenant) => {\n    setActiveProjectId(tenant.projectId);\n    setAdminFeedback(`\360\237\224\215 Inspection Mode: Viewing workspace associated with guest tenant \"${tenant.companyName}\". Close selection dropdown in navigation bar to restore administrator context.`);\n    window.scrollTo({ top: 380, behavior: \"smooth\" });\n  };\n\n  // 3. Render login portal screen if un-authenticated\n  if (!currentUser) {\n    return <LoginScreen onLoginSuccess={(user) => setCurrentUser(user)} />;\n  }\n\n  // List of all active tenants (initial defaults + manually added ones)\n  const allCurrentTenantsList = [...INITIAL_TENANTS.filter(t => t.role !== \"owner\"), ...customUsers];\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 flex flex-col font-sans select-none antialiased\">\n      \n      {/* Dynamic Navigation bar header */}\n      <Navbar \n        currentTab={currentTab} \n        setCurrentTab={(tab) => {\n          setCurrentTab(tab);\n          setActiveMinorSheetKey(null); // Reset focus sheets on tab swap\n        }}\n        clientMode={clientMode}\n        setClientMode={setClientMode}\n        currentUser={currentUser}\n        onLogout={handleLogout}\n        activeProjectId={activeProjectId}\n        setActiveProjectId={setActiveProjectId}\n      />\n\n      {/* Primary Context area wrapper container layout */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8\">\n        \n        {/* Trade2Turkey Welcome Hero Billboard Jumbotron */}\n        <div className=\"bg-gradient-to-r from-orange-600 via-orange-500 to-amber-600 rounded-3xl p-6 md:p-8 text-white shadow-xl shadow-orange-600/10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 relative overflow-hidden\">\n          {/* Subtle geometric lines */}\n          <div className=\"absolute right-0 top-0 bottom-0 w-1/3 bg-white/5 skew-x-12 transform origin-top-right pointer-events-none\" />\n          \n          <div className=\"space-y-2 max-w-2xl\">\n            <span className=\"bg-orange-850 text-orange-200 text-[10px] font-extrabold uppercase font-mono px-3 py-1 rounded-full tracking-wider border border-orange-500/30 flex items-center gap-1.5 w-fit\">\n              <ShieldCheck className=\"h-3 w-3 text-orange-300\" />\n              {currentUser.role === \'owner\' ? \"Trade2Turkey Admin Desk\" : `${currentUser.companyName} Secure Workspace`}\n            </span>\n            <h2 className=\"text-2xl md:text-3xl font-black font-display tracking-tight leading-tight\">\n              {currentUser.role === \"owner\" \n                ? \"Sourcing Pipeline Auditor Command Panel\" \n                : `${currentUser.companyName} Document Vault`}\n            </h2>\n            <p className=\"text-xs md:text-sm text-orange-50/90 leading-relaxed font-normal\">\n              {currentUser.role === \"owner\"\n                ? \"Monitor corporate pipelines, review specific Google Drive folder synchronizations, add custom workspaces, and evaluate Turkish factories.\"\n                : `Welcome to your isolated secure portal. Accessing exclusive Google Drive folders, shipment tracking maps, and transparent component costing sheets assigned to Project ID: ${activeProjectId}`}\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-3 shrink-0\">\n            {/* Active Workspace Status */}\n            <div className=\"bg-white/10 backdrop-blur-sm border border-white/10 px-4 py-3 rounded-2xl text-center min-w-[130px] font-mono\">\n              <span className=\"block text-[10px] uppercase font-bold text-orange-200\">Active Workspace</span>\n              <strong className=\"text-sm font-extrabold\">{activeProjectId}</strong>\n            </div>\n\n            <button\n              id=\"quick-trigger-report\"\n              onClick={() => {\n                setCurrentTab(\"report\");\n                setActiveMinorSheetKey(null);\n              }}\n              className=\"px-4.5 py-3 rounded-xl bg-slate-900 border border-slate-950 font-bold text-xs hover:bg-black transition-all flex items-center gap-1.5 shadow-md shadow-slate-950/20 cursor-pointer\"\n            >\n              <FileSpreadsheet className=\"h-4 w-4 text-orange-500\" /> Export Auditor Report\n            </button>\n          </div>\n        </div>\n\n        {/* OWNER-ONLY: CORPORATE TENANT MANAGEMENT DESK */}\n        {currentUser.role === \"owner\" && (\n          <div id=\"admin-workspace-container\" className=\"bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-6\">\n            <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-slate-100 pb-4\">\n              <div>\n                <h4 className=\"text-base font-bold text-slate-900 flex items-center gap-2 font-display\">\n                  <Users className=\"h-5 w-5 text-orange-600\" /> Corporate Client Workspaces & Tenant Administration\n                </h4>\n                <p className=\"text-xs text-slate-500 mt-1\">\n                  Create isolated workflows, map custom Google Drive directories, and audit active users instantly.\n                </p>\n              </div>\n              <span className=\"text-[10px] bg-amber-50 text-amber-800 font-extrabold px-3 py-1 rounded-full border border-amber-200 uppercase font-mono tracking-wider\">\n                Multi-Tenant Sync Active\n              </span>\n            </div>\n\n            {adminFeedback && (\n              <div className=\"bg-orange-50 border border-orange-100 text-orange-850 text-xs p-4 rounded-2xl font-mono leading-relaxed shadow-inner\">\n                {adminFeedback}\n              </div>\n            )}\n\n            {/* Admin actions grid */}\n            <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n              \n              {/* Form: Add New Corporate Client */}\n              <form onSubmit={handleAddClientAction} className=\"lg:col-span-5 bg-slate-50 p-5 rounded-2xl border border-slate-150 space-y-4\">\n                <div className=\"flex items-center gap-2 text-slate-800 font-bold text-xs uppercase font-mono tracking-wider\">\n                  <PlusCircle className=\"h-4.5 w-4.5 text-orange-600\" /> Provision Corporate Workspace\n                </div>\n\n                <div className=\"space-y-3.5\">\n                  <div className=\"space-y-1.5\">\n                    <label className=\"block text-[10px] font-bold text-slate-500 uppercase tracking-wide\">Client Company Name</label>\n                    <input\n                      type=\"text\"\n                      required\n                      placeholder=\"e.g., Luxury Lounge Inc.\"\n                      value={newClientCompany}\n                      onChange={(e) => setNewClientCompany(e.target.value)}\n                      className=\"w-full p-2.5 bg-white border rounded-xl text-xs text-slate-850 placeholder:text-slate-400 focus:outline-none focus:border-orange-500 transition\"\n                    />\n                  </div>\n\n                  <div className=\"space-y-1.5\">\n                    <label className=\"block text-[10px] font-bold text-slate-500 uppercase tracking-wide\">Company Corporate Email</label>\n                    <div className=\"relative\">\n                      <Mail className=\"absolute left-3 top-2.5 h-4 w-4 text-slate-400\" />\n                      <input\n                        type=\"email\"\n                        required\n                        placeholder=\"client@luxurytrousers.com\"\n                        value={newClientEmail}\n                        onChange={(e) => setNewClientEmail(e.target.value)}\n                        className=\"w-full pl-9 pr-3 py-2.5 bg-white border rounded-xl text-xs text-slate-850 placeholder:text-slate-400 focus:outline-none focus:border-orange-500 transition font-mono\"\n                      />\n                    </div>\n                  </div>\n\n                  <div className=\"space-y-1.5\">\n                    <label className=\"block text-[10px] font-bold text-slate-500 uppercase tracking-wide\">Assign Sourcing Pipeline Project</label>\n                    <select\n                      value={newClientProject}\n                      onChange={(e) => setNewClientProject(e.target.value)}\n                      className=\"w-full p-2.5 bg-white border rounded-xl text-xs text-slate-800 focus:outline-none focus:border-orange-500 transition font-mono font-bold\"\n                    >\n                      <option value=\"PROJ-BEANBAG\">PROJ-BEANBAG (ComfortPro Bean Bags)</option>\n                      <option value=\"PROJ-VELVET\">PROJ-VELVET (Luxury Velvet Ottoman)</option>\n                    </select>\n                  </div>\n\n                  <div className=\"p-3 bg-blue-50/50 border border-blue-100 rounded-xl text-[11px] leading-relaxed text-blue-800\">\n                    \360\237\222\241 <strong>Password Convention:</strong> The access password is auto-configured as email prefix name + \"2026\". (e.g., if email is <code>client@company.com</code>, password is <code>client2026</code>).\n                  </div>\n\n                  <button\n                    type=\"submit\"\n                    className=\"w-full bg-slate-900 border border-slate-950 text-white hover:bg-black font-semibold text-xs py-3 rounded-xl transition cursor-pointer shadow-sm\"\n                  >\n                    Generate Secure Isolation Workspace\n                  </button>\n                </div>\n              </form>\n\n              {/* Grid: View and switch between active corporate clients */}\n              <div className=\"lg:col-span-7 space-y-3\">\n                <span className=\"block text-[10px] font-bold text-slate-400 uppercase tracking-wider font-mono\">Active Registered Client Workspaces</span>\n                \n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3 max-h-[360px] overflow-y-auto pr-1\">\n                  {allCurrentTenantsList.map((tenant) => {\n                    const isViewing = activeProjectId === tenant.projectId;\n                    return (\n                      <div\n                        key={tenant.id}\n                        className={`p-4 rounded-2xl border transition flex flex-col justify-between gap-3 ${\n                          isViewing\n                            ? \"bg-slate-950 text-white border-slate-950 shadow-md\"\n                            : \"bg-white text-slate-800 border-slate-200 hover:border-slate-300\"\n                        }`}\n                      >\n                        <div className=\"space-y-1\">\n                          <div className=\"flex items-center justify-between\">\n                            <h5 className=\"text-xs font-bold font-display truncate max-w-[170px]\">\n                              {tenant.companyName}\n                            </h5>\n                            <span className={`text-[9px] font-extrabold px-1.5 py-0.5 rounded font-mono ${\n                              tenant.projectId === \"PROJ-BEANBAG\"\n                                ? \"bg-orange-500/10 text-orange-400\"\n                                : \"bg-teal-500/10 text-teal-400\"\n                            }`}>\n                              {tenant.projectId}\n                            </span>\n                          </div>\n                          <span className={`block text-[10px] font-mono truncate ${isViewing ? \"text-slate-400\" : \"text-slate-500\"}`}>\n                            {tenant.email}\n                          </span>\n                        </div>\n\n                        <div className=\"flex items-center justify-between border-t border-slate-800/10 pt-2.5 mt-1 select-none\">\n                          <span className={`text-[10px] font-mono ${isViewing ? \"text-emerald-400 font-bold\" : \"text-slate-400\"}`}>\n                            {isViewing ? \"\342\227\217 Active Inspection\" : \"Inactive Inspect\"}\n                          </span>\n                          \n                          <button\n                            type=\"button\"\n                            onClick={() => handleAdminInspectClient(tenant)}\n                            className={`px-2.5 py-1 rounded text-[10px] font-bold cursor-pointer transition ${\n                              isViewing\n                                ? \"bg-orange-600 hover:bg-orange-500 text-white\"\n                                : \"bg-slate-100 hover:bg-slate-200 text-slate-700\"\n                            }`}\n                          >\n                            Inspect Workspace\n                          </button>\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n\n                <div className=\"p-3.5 bg-orange-50/50 border border-orange-100 rounded-2xl flex gap-2.5 text-xs text-orange-900 leading-relaxed\">\n                  <ShieldCheck className=\"h-5 w-5 text-orange-600 mt-0.5 shrink-0\" />\n                  <div>\n                    <strong>Dual-Stitch Security Policy Enforcement:</strong> SofaStyle and Velvet Lounge users remain perfectly compartmentalized. When a user with the corporate credentials of SofaStyle logs in, they are locked to Project ID list filters. They cannot access, browse, or perform uploads to alternate pipelines.\n                  </div>\n                </div>\n              </div>\n\n            </div>\n          </div>\n        )}\n\n        {/* Dynamic active View Renderer Router logic */}\n        <div className=\"space-y-6\">\n\n          {/* SOURCING FLOW (SECTION A) TAB VIEW */}\n          {currentTab === \"sourcing\" && (\n            <div className=\"space-y-6\">\n              \n              {/* If an active embedded minor sheet is opened / triggered, render it ontop of SOP list */}\n              {activeMinorSheetKey ? (\n                <div>\n                  <div className=\"flex items-center gap-2 mb-2\">\n                    <button\n                      id=\"btn-back-to-sop\"\n                      onClick={() => setActiveMinorSheetKey(null)}\n                      className=\"cursor-pointer text-xs font-bold text-slate-500 hover:text-slate-900 flex items-center gap-1 bg-white border px-3 py-1.5 rounded-lg hover:border-slate-300 transition\"\n                    >\n                      \342\206\220 Return to Sourcing SOP List\n                    </button>\n                    <span className=\"text-xs text-slate-300 font-mono\">/</span>\n                    <span className=\"text-xs text-slate-400 font-semibold uppercase\">ACTIVE Minor Worksheet Solver</span>\n                  </div>\n\n                  <MinorSheets\n                    sheetKey={activeMinorSheetKey}\n                    targetSpecs={targetSpecs}\n                    setTargetSpecs={setTargetSpecs}\n                    rfqs={rfqs}\n                    setRfqs={setRfqs}\n                    valueChain={valueChain}\n                    setValueChain={setValueChain}\n                    rfqMatrix={rfqMatrix}\n                    setRfqMatrix={setRfqMatrix}\n                    recipes={recipes}\n                    setRecipes={setRecipes}\n                    onClose={() => setActiveMinorSheetKey(null)}\n                  />\n                </div>\n              ) : (\n                /* Dynamic instructions guidance */\n                <div className=\"bg-amber-50/50 border border-amber-200/50 p-4 rounded-2xl flex items-start gap-3.5 text-xs text-amber-900\">\n                  <Compass className=\"h-5 w-5 text-amber-600 shrink-0 mt-0.5\" />\n                  <div>\n                    <h4 className=\"font-bold\">Embedded Sop Redirections Active</h4>\n                    <p className=\"text-amber-800 leading-relaxed mt-1 font-medium\">\n                      The core Turkish sourcing pipeline (from Discovery to Contract agreements) contains 6 interactive activities. Clicking those step rows with the <Eye className=\"h-3.5 w-3.5 inline text-amber-700 font-bold\" /> badge or the <strong>\"Open Solver\"</strong> button launches the embedded granular calculators!\n                    </p>\n                  </div>\n                </div>\n              )}\n\n              {/* Standard active Sourcing Pipeline List representation */}\n              <SourcingSOP \n                steps={sopSteps} \n                setSteps={setSopSteps}\n                currentProjectId={activeProjectId}\n                onChangeProjectId={(pid) => setActiveProjectId(pid)}\n                canSwitchProject={currentUser?.role === \"owner\"}\n                onOpenMinorSheet={(key) => {\n                  setActiveMinorSheetKey(key);\n                  window.scrollTo({ top: 320, behavior: \"smooth\" });\n                }} \n              />\n            </div>\n          )}\n\n          {/* STRATEGIC COORDINATION & LOGISTICS (SECTION B) */}\n          {currentTab === \"logistics\" && (\n            <LogisticsSOP\n              steps={sopSteps}\n              setSteps={setSopSteps}\n              shipments={shipments}\n              setShipments={setShipments}\n              inventory={inventory}\n              setInventory={setInventory}\n              orders={fulfillmentOrders}\n              setOrders={setFulfillmentOrders}\n              currentProjectId={activeProjectId}\n              onChangeProjectId={(pid) => setActiveProjectId(pid)}\n              canSwitchProject={currentUser?.role === \"owner\"}\n            />\n          )}\n\n          {/* SUPPLIER RATING SCORER */}\n          {currentTab === \"suppliers\" && (\n            <SupplierScoring \n              suppliers={suppliers} \n              setSuppliers={setSuppliers} \n            />\n          )}\n\n          {/* CLIENT VERIFICATION PORTAL (CLIENT ACCESS MODE) */}\n          {currentTab === \"client-portal\" && (\n            <ClientPortal\n              shipments={shipments}\n              suppliers={suppliers}\n              recipes={recipes}\n              currentProjectId={activeProjectId}\n              onChangeProjectId={(pid) => setActiveProjectId(pid)}\n              canSwitchProject={currentUser?.role === \"owner\"}\n            />\n          )}\n\n          {/* EXECUTIVE SOURCE REPORT CENTER */}\n          {currentTab === \"report\" && (\n            <ReportGenerator\n              steps={sopSteps}\n              suppliers={suppliers}\n              recipes={recipes}\n              shipments={shipments}\n            />\n          )}\n\n        </div>\n\n      </main>\n\n      {/* Solid humanized minimal branding footer */}\n      <footer className=\"border-t border-slate-200 bg-white py-6 select-none mt-12\">\n        <div className=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500 font-medium font-mono\">\n          <div className=\"flex items-center gap-3\">\n            <span className=\"font-bold text-slate-800\">Trade2Turkey Co-op Ltd.</span>\n            <span>|</span>\n            <span>Export Logistics & Sourcing Audit Hub</span>\n          </div>\n          <div className=\"text-slate-400 text-[10px]\">\n            System Operational \342\200\242 Active Port: 3000 \342\200\242 Security compliance rule ATR.v3 active\n          </div>\n        </div>\n      </footer>\n\n    </div>\n  );\n}\n"
    }
