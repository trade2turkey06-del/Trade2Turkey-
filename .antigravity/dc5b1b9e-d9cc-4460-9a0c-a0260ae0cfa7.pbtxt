  file_change {
    absolute_path_uri: "file:///src/components/ReportGenerator.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { \n  FileText, Mail, Download, CheckSquare, Print, Send, CheckCircle2, Sliders \n} from \"lucide-react\";\nimport { SopStep, TargetSpecification, Supplier, ShipmentMilestone, ProductRecipe } from \"../types\";\n\ninterface ReportGeneratorProps {\n  steps: SopStep[];\n  suppliers: Supplier[];\n  recipes: ProductRecipe[];\n  shipments: ShipmentMilestone[];\n}\n\nexport default function ReportGenerator({ steps, suppliers, recipes, shipments }: ReportGeneratorProps) {\n  \n  const [reportTitle, setReportTitle] = useState(\"Trade2Turkey Sourcing & Verification Summary\");\n  const [recipient, setRecipient] = useState(\"trade-client-germany@luxe-living.de\");\n  const [reportNotes, setReportNotes] = useState(\"This transparent digest compiles our Bursa audited textile quality control certifications, granular material cost recipes, and Port of Ambarli ocean freight milestones.\");\n  \n  // Custom checklist criteria\n  const [includeSop, setIncludeSop] = useState(true);\n  const [includeScores, setIncludeScores] = useState(true);\n  const [includeRecipe, setIncludeRecipe] = useState(true);\n  const [includeShipStatus, setIncludeShipStatus] = useState(true);\n\n  const [mailSent, setMailSent] = useState(false);\n  const handleSendReport = (e: React.FormEvent) => {\n    e.preventDefault();\n    setMailSent(true);\n    setTimeout(() => setMailSent(false), 5000);\n  };\n\n  // Triggering document print directly\n  const handlePrint = () => {\n    window.print();\n  };\n\n  const completedSopCount = steps.filter(s => s.status === \"Completed\").length;\n  const activeSopCount = steps.filter(s => s.status === \"In Progress\").length;\n\n  return (\n    <div className=\"space-y-6\">\n      \n      {/* Configuration Header Panel */}\n      <div className=\"bg-white p-6 rounded-2xl border border-slate-200\">\n        <h4 className=\"text-base font-bold font-display text-slate-900\">Real-Time Sourcing Report Generator</h4>\n        <p className=\"text-xs text-slate-500 mt-1 leading-relaxed\">\n          Select customized blocks to compile an elegant, client-ready summary of Turkish supplier audits, recipes and container milestone coordinates.\n        </p>\n\n        {/* Inputs */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 mt-4 text-xs font-medium\">\n          <div>\n            <label className=\"block text-slate-600 mb-1\">Generated Report Title</label>\n            <input \n              type=\"text\" \n              value={reportTitle} \n              onChange={(e) => setReportTitle(e.target.value)}\n              className=\"w-full p-2 border rounded-lg bg-white\"\n            />\n          </div>\n          <div>\n            <label className=\"block text-slate-600 mb-1\">Target Client Email</label>\n            <input \n              type=\"email\" \n              value={recipient} \n              onChange={(e) => setRecipient(e.target.value)}\n              className=\"w-full p-2 border rounded-lg bg-white font-mono\"\n            />\n          </div>\n          <div>\n            <label className=\"block text-slate-600 mb-1\">Add Stakeholder Notes</label>\n            <input \n              type=\"text\" \n              value={reportNotes} \n              onChange={(e) => setReportNotes(e.target.value)}\n              className=\"w-full p-2 border rounded-lg bg-white\"\n            />\n          </div>\n        </div>\n\n        {/* Toggle options */}\n        <div className=\"flex flex-wrap gap-4 items-center mt-5 text-xs font-semibold text-slate-600 bg-slate-50 p-3 rounded-lg border\">\n          <span className=\"text-[10px] text-slate-400 font-mono font-bold uppercase mr-2\">Report Content:</span>\n          \n          <label className=\"flex items-center gap-1.5 cursor-pointer\">\n            <input type=\"checkbox\" checked={includeSop} onChange={() => setIncludeSop(!includeSop)} className=\"accent-orange-500\" />\n            <span>Sourcing SOP Milestones</span>\n          </label>\n\n          <label className=\"flex items-center gap-1.5 cursor-pointer\">\n            <input type=\"checkbox\" checked={includeScores} onChange={() => setIncludeScores(!includeScores)} className=\"accent-orange-500\" />\n            <span>Supplier Integrity Scores</span>\n          </label>\n\n          <label className=\"flex items-center gap-1.5 cursor-pointer\">\n            <input type=\"checkbox\" checked={includeRecipe} onChange={() => setIncludeRecipe(!includeRecipe)} className=\"accent-orange-500\" />\n            <span>Recipe Component Costing</span>\n          </label>\n\n          <label className=\"flex items-center gap-1.5 cursor-pointer\">\n            <input type=\"checkbox\" checked={includeShipStatus} onChange={() => setIncludeShipStatus(!includeShipStatus)} className=\"accent-orange-500\" />\n            <span>Logistics Milestone Tracker</span>\n          </label>\n        </div>\n\n        {/* Quick buttons */}\n        <div className=\"flex gap-2 justify-end mt-4\">\n          <button \n            onClick={handlePrint}\n            className=\"bg-slate-900 hover:bg-black text-white text-xs font-bold py-2 px-4 rounded-lg flex items-center gap-1.5 cursor-pointer\"\n          >\n            <Print className=\"h-4 w-4\" /> Export/Print HTML Report\n          </button>\n          \n          <button \n            onClick={handleSendReport}\n            className=\"bg-orange-600 hover:bg-orange-700 text-white text-xs font-bold py-2 px-4 rounded-lg flex items-center gap-1.5 cursor-pointer\"\n          >\n            <Send className=\"h-4 w-4\" /> Send directly to Client Email\n          </button>\n        </div>\n\n        {mailSent && (\n          <div className=\"mt-3 p-3 bg-green-50 border border-green-200 text-green-700 rounded-lg text-xs font-medium flex items-center gap-1.5\">\n            <CheckCircle2 className=\"h-4 w-4 text-green-600\" /> Sent! Direct securely digested Trade2Turkey report emailed to <strong>{recipient}</strong>.\n          </div>\n        )}\n      </div>\n\n      {/* STYLED PRINTABLE REPORT CONTAINER */}\n      <div id=\"printable-area\" className=\"bg-white border rounded-2xl p-8 relative shadow-sm max-w-4xl mx-auto space-y-8 print:border-none print:shadow-none print:p-0\">\n        \n        {/* Report Brand Header */}\n        <div className=\"flex justify-between items-start border-b-2 border-slate-900 pb-6\">\n          <div>\n            <span className=\"text-[10px] bg-slate-900 text-white font-mono font-extrabold px-2.5 py-0.5 rounded\">\n              TRADE2TURKEY\n            </span>\n            <h2 className=\"text-2xl font-black text-slate-900 mt-2 font-display\">{reportTitle}</h2>\n            <p className=\"text-xs text-slate-500 mt-1\">Generated: 2026-06-03 19:26 UTC | Registered ID: T2T-REP-893019</p>\n          </div>\n          <div className=\"text-right text-xs\">\n            <strong className=\"text-slate-950 block\">Trade2Turkey Sourcing Team</strong>\n            <span className=\"text-slate-500\">Bursa & Istanbul Hub Offices</span>\n            <span className=\"text-slate-400 block mt-1\">trade2turkey06@gmail.com</span>\n          </div>\n        </div>\n\n        {/* Notes block */}\n        <div className=\"p-4 bg-slate-50 border-l-4 border-slate-800 rounded text-xs select-none leading-relaxed text-slate-700\">\n          <strong>Digest Summary:</strong> {reportNotes}\n        </div>\n\n        {/* Section B: Sourcing SOP pipeline Milestones */}\n        {includeSop && (\n          <div className=\"space-y-3\">\n            <h3 className=\"text-sm font-black uppercase tracking-wider text-slate-900 border-b pb-1 font-mono\">1. Turkish Sourcing SOP Status Matrix</h3>\n            \n            <div className=\"grid grid-cols-2 gap-4 text-xs\">\n              <div className=\"bg-slate-50 p-2 border rounded\">\n                <span className=\"text-slate-500 font-mono\">Completed milestones:</span> <strong className=\"text-slate-800 font-mono\">{completedSopCount} steps</strong>\n              </div>\n              <div className=\"bg-slate-50 p-2 border rounded\">\n                <span className=\"text-slate-500 font-mono\">Pending/In-transit steps:</span> <strong className=\"text-slate-800 font-mono\">{activeSopCount} steps</strong>\n              </div>\n            </div>\n\n            <div className=\"overflow-x-auto\">\n              <table className=\"w-full text-left text-[11px] border\">\n                <thead>\n                  <tr className=\"bg-slate-100 border-b font-mono font-semibold text-slate-700\">\n                    <th className=\"p-2\">Step ID</th>\n                    <th className=\"p-2\">Task Activity description</th>\n                    <th className=\"p-2\">SLA KPI Target</th>\n                    <th className=\"p-2\">Owner Assignee</th>\n                    <th className=\"p-2 text-right\">Approval Status</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y text-slate-600\">\n                  {steps.filter(s => s.section === \"A\").slice(0, 10).map(s => (\n                    <tr key={s.id} className=\"hover:bg-slate-50/50\">\n                      <td className=\"p-2 font-mono font-bold text-slate-900\">{s.id}</td>\n                      <td className=\"p-2 font-medium\">{s.task}</td>\n                      <td className=\"p-2\">{s.kpiMetric}</td>\n                      <td className=\"p-2\">{s.taskOwner}</td>\n                      <td className=\"p-2 text-right text-green-700 font-bold\">{s.status}</td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n            </div>\n          </div>\n        )}\n\n        {/* Section C: Supplier Quality Scores */}\n        {includeScores && (\n          <div className=\"space-y-3\">\n            <h3 className=\"text-sm font-black uppercase tracking-wider text-slate-900 border-b pb-1 font-mono\">2. Audited Manufacturer Compliance Scores</h3>\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n              {suppliers.map(sup => (\n                <div key={sup.id} className=\"border p-4 rounded-xl bg-slate-50/30 text-xs\">\n                  <div className=\"flex justify-between items-start font-bold\">\n                    <div>\n                      <strong className=\"text-slate-900 block\">{sup.name}</strong>\n                      <span className=\"text-[10px] text-slate-400\">{sup.city}, Turkey</span>\n                    </div>\n                    <span className=\"bg-slate-200 px-1.5 py-0.5 rounded text-[10px] font-mono\">{sup.verifiedStatus}</span>\n                  </div>\n\n                  <div className=\"space-y-1.5 mt-3\">\n                    <div className=\"flex justify-between\">\n                      <span className=\"text-slate-500\">Quality score:</span>\n                      <strong className=\"text-slate-800 font-mono\">{sup.scores.quality}/100</strong>\n                    </div>\n                    <div className=\"flex justify-between\">\n                      <span className=\"text-slate-500\">Factory Audit Passed:</span>\n                      <strong className={sup.siteAuditCompleted ? \"text-green-600\" : \"text-amber-600\"}>\n                        {sup.siteAuditCompleted ? `Passed (${sup.auditScorePercent}%)` : \"No Audit\"}\n                      </strong>\n                    </div>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        )}\n\n        {/* Section D: Product Recipe Details */}\n        {includeRecipe && recipes[0] && (\n          <div className=\"space-y-3\">\n            <h3 className=\"text-sm font-black uppercase tracking-wider text-slate-900 border-b pb-1 font-mono\">3. Grand Bill of Material Recipes Costing</h3>\n            <div className=\"text-xs\">\n              <span className=\"text-slate-500\">Product Line:</span> <strong>{recipes[0].productName} {recipes[0].version}</strong>\n            </div>\n\n            <table className=\"w-full text-left text-[11px] border\">\n              <thead>\n                <tr className=\"bg-slate-100 font-mono font-bold border-b text-slate-700 p-2\">\n                  <th className=\"p-2\">Component item description</th>\n                  <th className=\"p-2\">Ratio consumption</th>\n                  <th className=\"p-2 text-right\">Standard Rate ($)</th>\n                  <th className=\"p-2 text-center\">Wastage / Scrap</th>\n                  <th className=\"p-2 text-teal-800\">Source Factory</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y text-slate-600\">\n                {recipes[0].materials.map(mat => (\n                  <tr key={mat.id}>\n                    <td className=\"p-2 font-medium\">{mat.name}</td>\n                    <td className=\"p-2 font-mono\">{mat.qtyRequired} {mat.unit}</td>\n                    <td className=\"p-2 font-mono text-right\">${mat.unitCostUsd.toFixed(3)}</td>\n                    <td className=\"p-2 text-center text-red-500\">+{mat.scrapRatePercent}%</td>\n                    <td className=\"p-2 text-teal-700\">{mat.source}</td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        )}\n\n        {/* Section E: ACTIVE SEA FREIGHT POSITION TRACK */}\n        {includeShipStatus && shipments[0] && (\n          <div className=\"space-y-3\">\n            <h3 className=\"text-sm font-black uppercase tracking-wider text-slate-900 border-b pb-1 font-mono\">4. Sea Shipment & Container Logistics Checkpoint</h3>\n            <div className=\"bg-slate-50 p-4 rounded-xl border grid grid-cols-1 md:grid-cols-3 gap-3 text-xs\">\n              <div>\n                <span className=\"text-slate-400 block font-mono text-[9px] uppercase\">CONTAINER VESSEL</span>\n                <strong className=\"text-slate-850 block mt-0.5\">{shipments[0].vesselName}</strong>\n              </div>\n              <div>\n                <span className=\"text-slate-400 block font-mono text-[9px] uppercase\">CURRENT LOGISTICS POSITION</span>\n                <strong className=\"text-slate-850 block mt-0.5\">{shipments[0].milestones[shipments[0].currentMilestoneIndex]?.title}</strong>\n              </div>\n              <div>\n                <span className=\"text-slate-400 block font-mono text-[9px] uppercase\">ESTIMATED WAREHOUSE INTAKE</span>\n                <strong className=\"text-orange-600 block mt-0.5\">{shipments[0].estimatedArrival}</strong>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* Footer print disclaimer */}\n        <div className=\"border-t pt-6 text-[10px] text-slate-400 font-medium leading-relaxed flex flex-col sm:flex-row justify-between gap-3 font-mono\">\n          <span>Official Trade2Turkey Co-op verification program logs securely signed.</span>\n          <span>\302\251 2026 Trade2Turkey. All rights reserved.</span>\n        </div>\n\n      </div>\n    </div>\n  );\n}\n"
