  file_change {
    absolute_path_uri: "file:///src/components/MinorSheets.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { \n  FileText, Coins, Plus, Trash2, ArrowRight, CheckCircle, Scale, \n  ChevronRight, RefreshCw, Layers, ShieldCheck, Mail, Info, Download\n} from \"lucide-react\";\nimport { \n  TargetSpecification, RfqSubmission, ValueChainCosting, \n  RfqComparativeMatrix, ProductRecipe, RecipeMaterial \n} from \"../types\";\n\ninterface MinorSheetsProps {\n  sheetKey: string;\n  targetSpecs: TargetSpecification[];\n  setTargetSpecs: React.Dispatch<React.SetStateAction<TargetSpecification[]>>;\n  rfqs: RfqSubmission[];\n  setRfqs: React.Dispatch<React.SetStateAction<RfqSubmission[]>>;\n  valueChain: ValueChainCosting[];\n  setValueChain: React.Dispatch<React.SetStateAction<ValueChainCosting[]>>;\n  rfqMatrix: RfqComparativeMatrix[];\n  setRfqMatrix: React.Dispatch<React.SetStateAction<RfqComparativeMatrix[]>>;\n  recipes: ProductRecipe[];\n  setRecipes: React.Dispatch<React.SetStateAction<ProductRecipe[]>>;\n  onClose?: () => void;\n}\n\nexport default function MinorSheets({\n  sheetKey,\n  targetSpecs,\n  setTargetSpecs,\n  rfqs,\n  setRfqs,\n  valueChain,\n  setValueChain,\n  rfqMatrix,\n  setRfqMatrix,\n  recipes,\n  setRecipes,\n  onClose\n}: MinorSheetsProps) {\n  \n  // Internal selection trackers\n  const [selectedSpecId, setSelectedSpecId] = useState<string>(targetSpecs[0]?.id || \"\");\n  const [selectedRfqId, setSelectedRfqId] = useState<string>(rfqs[0]?.id || \"\");\n  const [selectedCostIndex, setSelectedCostIndex] = useState<number>(0);\n  const [selectedMatrixId, setSelectedMatrixId] = useState<string>(rfqMatrix[0]?.id || \"\");\n  const [selectedRecipeId, setSelectedRecipeId] = useState<string>(recipes[0]?.id || \"\");\n\n  // Notification Banner Helper\n  const [bannerMsg, setBannerMsg] = useState<string | null>(null);\n  const showBanner = (msg: string) => {\n    setBannerMsg(msg);\n    setTimeout(() => setBannerMsg(null), 3000);\n  };\n\n  const currentSpec = targetSpecs.find(s => s.id === selectedSpecId) || targetSpecs[0];\n  const currentRfq = rfqs.find(r => r.id === selectedRfqId) || rfqs[0];\n  const currentCost = valueChain[selectedCostIndex] || valueChain[0];\n  const currentMatrix = rfqMatrix.find(m => m.id === selectedMatrixId) || rfqMatrix[0];\n  const currentRecipe = recipes.find(r => r.id === selectedRecipeId) || recipes[0];\n\n  // --- 1. TARGET SPECIFICATION CONTROLLER ---\n  const handleUpdateSpecField = (field: keyof TargetSpecification, value: any) => {\n    setTargetSpecs(prev => prev.map(spec => {\n      if (spec.id === selectedSpecId) {\n        return { ...spec, [field]: value, lastUpdated: new Date().toISOString().split(\'T\')[0] };\n      }\n      return spec;\n    }));\n    showBanner(`Target spec: ${field} updated successfully`);\n  };\n\n  const handleAddSpec = () => {\n    const newSpec: TargetSpecification = {\n      id: `spec-${Date.now()}`,\n      productName: \"New Customized Trade Product\",\n      category: \"Uncategorized\",\n      dimensionsWidth: 50,\n      dimensionsLength: 50,\n      dimensionsHeight: 50,\n      materialCover: \"Turkish Cotton Blend\",\n      materialFilling: \"Ecowool Filler\",\n      colorOptions: [\"Natural Beige\"],\n      weightKg: 2.0,\n      certifiedStandards: [\"REACH Certified\"],\n      targetExwPrice: 10.00,\n      targetFobPrice: 12.00,\n      packagingDetails: \"Standard export polybag\",\n      notes: \"Verify fabric durability during sample stage.\",\n      lastUpdated: new Date().toISOString().split(\'T\')[0]\n    };\n    setTargetSpecs(prev => [...prev, newSpec]);\n    setSelectedSpecId(newSpec.id);\n    showBanner(\"Created new custom product spec template!\");\n  };\n\n  // --- 2. RFQ SUBMISSION CONTROLLER ---\n  const [newSupplierName, setNewSupplierName] = useState(\"\");\n  const [newSupplierLocation, setNewSupplierLocation] = useState(\"\");\n  const [newSupplierQuote, setNewSupplierQuote] = useState<number>(15.00);\n\n  const handleAddSupplierToRfq = () => {\n    if (!newSupplierName.trim()) return;\n    const newSup = {\n      id: `rfq-s-${Date.now()}`,\n      supplierName: newSupplierName,\n      location: newSupplierLocation || \"Turkey\",\n      sampleCost: 50,\n      leadTimeDays: 25,\n      paymentTerms: \"30% Advance, 70% LC\",\n      initialQuoteExw: Number(newSupplierQuote),\n      hasNda: true,\n      notes: \"Newly identified custom manufacturer\"\n    };\n    \n    setRfqs(prev => prev.map(r => {\n      if (r.id === selectedRfqId) {\n        return { ...r, suppliers: [...r.suppliers, newSup] };\n      }\n      return r;\n    }));\n    setNewSupplierName(\"\");\n    setNewSupplierLocation(\"\");\n    showBanner(`Added ${newSupplierName} quotes to RFQ Campaign!`);\n  };\n\n  // --- 3. VALUE CHAIN PORTAL COST CALCULATOR ---\n  const calculateLandedCost = (cost: ValueChainCosting) => {\n    if (!cost) return { landed: 0, items: [] };\n    const exwTotal = cost.exwUnitPrice * cost.quantity;\n    const domesticLog = cost.domesticFreightTurkey;\n    const exportCust = cost.exportCustomsTurkey;\n    const freight = cost.oceanFreight;\n    const dutyVal = (exwTotal + domesticLog + exportCust) * (cost.importCustomsDuty / 100);\n    const broker = cost.importerBrokerageAndClerance;\n    const ware = cost.localWarehousingAndHandling;\n    const inland = cost.inlandDelivery;\n    const buffer = cost.unexpectedBuffer;\n\n    const totalLandedCost = exwTotal + domesticLog + exportCust + freight + dutyVal + broker + ware + inland + buffer;\n    const perUnitLanded = totalLandedCost / cost.quantity;\n\n    return {\n      landed: totalLandedCost,\n      perUnit: perUnitLanded,\n      breakdown: {\n        rawExw: cost.exwUnitPrice,\n        turkeyLogistics: (domesticLog + exportCust) / cost.quantity,\n        oceanFreightPrice: freight / cost.quantity,\n        importDuty: dutyVal / cost.quantity,\n        destinationHandling: (broker + ware + inland) / cost.quantity,\n        safetyBuffer: buffer / cost.quantity\n      }\n    };\n  };\n\n  const landedResult = calculateLandedCost(currentCost);\n\n  // --- 4. RFQ COMPARATIVE WEIGHTED MATRIX ---\n  // Calculates real-time composite score based on customizable weightings\n  const getMatrixScores = (matrix: RfqComparativeMatrix) => {\n    const w = matrix.criteriaWeights;\n    const totalW = w.unitPrice + w.leadTime + w.quality + w.financialStability;\n    \n    return matrix.suppliers.map(s => {\n      // Price scoring: lower is better. Normalize pricing score against $15 base (lower price = higher score)\n      const idealPrice = 14.5;\n      const priceFactor = s.unitPriceExw <= idealPrice ? 10 : Math.max(4, 10 - ((s.unitPriceExw - idealPrice) / 1.5));\n      const normalizedPrice = Math.min(10, priceFactor);\n\n      // Lead time scorer: shorter is better.\n      const idealLead = 21;\n      const leadFactor = s.leadTimeDays <= idealLead ? 10 : Math.max(5, 10 - ((s.leadTimeDays - idealLead) / 2));\n      const normalizedLead = Math.min(10, leadFactor);\n\n      // Other are 10-based scores\n      const unitValue = (normalizedPrice * w.unitPrice) / 100;\n      const leadValue = (normalizedLead * w.leadTime) / 100;\n      const qualValue = (s.qualityScore * w.quality) / 100;\n      const stabValue = (s.complianceScore * w.financialStability) / 100;\n\n      const totalScore = parseFloat(\n        ((unitValue + leadValue + qualValue + stabValue) * 10).toFixed(1)\n      );\n\n      return {\n        ...s,\n        totalScore,\n        normalizedPrice: parseFloat(normalizedPrice.toFixed(1)),\n        normalizedLead: parseFloat(normalizedLead.toFixed(1))\n      };\n    }).sort((a,b) => (b.totalScore || 0) - (a.totalScore || 0));\n  };\n\n  const matrixComputedSuppliers = currentMatrix ? getMatrixScores(currentMatrix) : [];\n\n  // --- 5. CREATION OF PRODUCT RECIPE & COSTINGS ---\n  const [newMatName, setNewMatName] = useState(\"\");\n  const [newMatQty, setNewMatQty] = useState<number>(1.0);\n  const [newMatUnit, setNewMatUnit] = useState(\"kg\");\n  const [newMatCost, setNewMatCost] = useState<number>(0.50);\n  const [newMatScrap, setNewMatScrap] = useState<number>(5);\n  const [newMatSource, setNewMatSource] = useState(\"\");\n\n  const handleAddMaterialToRecipe = () => {\n    if (!newMatName.trim()) return;\n    const newMaterial: RecipeMaterial = {\n      id: `rc-mat-${Date.now()}`,\n      name: newMatName,\n      qtyRequired: Number(newMatQty),\n      unit: newMatUnit,\n      unitCostUsd: Number(newMatCost),\n      scrapRatePercent: Number(newMatScrap),\n      source: newMatSource || \"Turkish Supplier\"\n    };\n\n    setRecipes(prev => prev.map(rec => {\n      if (rec.id === selectedRecipeId) {\n        return {\n          ...rec,\n          materials: [...rec.materials, newMaterial],\n          lastUpdated: new Date().toISOString().split(\'T\')[0]\n        };\n      }\n      return rec;\n    }));\n\n    setNewMatName(\"\");\n    setNewMatSource(\"\");\n    showBanner(`Added ingredients ${newMatName} to recipe!`);\n  };\n\n  const handleRemoveMaterial = (matId: string) => {\n    setRecipes(prev => prev.map(rec => {\n      if (rec.id === selectedRecipeId) {\n        return {\n          ...rec,\n          materials: rec.materials.filter(m => m.id !== matId),\n          lastUpdated: new Date().toISOString().split(\'T\')[0]\n        };\n      }\n      return rec;\n    }));\n    showBanner(\"Ingredients removed.\");\n  };\n\n  // Recipe Costing Math\n  const getRecipeCostMetrics = (recipe: ProductRecipe) => {\n    if (!recipe) return { materialSubtotal: 0, wastageCost: 0, grandTotal: 0 };\n    \n    let materialSubtotal = 0;\n    let wastageCost = 0;\n\n    recipe.materials.forEach(mat => {\n      const rawCost = mat.qtyRequired * mat.unitCostUsd;\n      const effectiveCost = rawCost * (1 + (mat.scrapRatePercent / 100));\n      materialSubtotal += rawCost;\n      wastageCost += (effectiveCost - rawCost);\n    });\n\n    const grandTotal = materialSubtotal + wastageCost + recipe.laborCostUsd + recipe.packagingCostUsd + recipe.overheadCostUsd;\n\n    return {\n      materialSubtotal: parseFloat(materialSubtotal.toFixed(3)),\n      wastageCost: parseFloat(wastageCost.toFixed(3)),\n      grandTotal: parseFloat(grandTotal.toFixed(2))\n    };\n  };\n\n  const recipeMetrics = getRecipeCostMetrics(currentRecipe);\n\n  return (\n    <div className=\"bg-white rounded-xl border border-slate-200 mt-4 overflow-hidden shadow-sm\">\n      \n      {/* Banner message */}\n      {bannerMsg && (\n        <div className=\"bg-orange-500 text-white text-xs py-2 px-4 flex items-center justify-between font-medium\">\n          <span>\360\237\224\224 {bannerMsg}</span>\n          <button onClick={() => setBannerMsg(null)} className=\"text-white hover:text-orange-200\">\342\234\225</button>\n        </div>\n      )}\n\n      {/* Header of Sourcing Minor Sheet */}\n      <div className=\"bg-slate-900 text-white p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"p-2.5 rounded-lg bg-orange-500 text-white\">\n            <Coins className=\"h-5 w-5\" />\n          </div>\n          <div>\n            <span className=\"text-[10px] uppercase tracking-wider font-semibold text-orange-400 font-mono\">\n              SOP Embedded Tool\n            </span>\n            <h3 className=\"text-lg font-bold font-display leading-tight\">\n              {sheetKey === \"target-specs\" && \"Sourcing Spec Sheet: Target Specifications\"}\n              {sheetKey === \"rfq-submission\" && \"Inbound Sourcing & RFQ Submissions Cabinet\"}\n              {sheetKey === \"costing-value-chain\" && \"Interactive Value Chain & Landed Costing\"}\n              {sheetKey === \"rfq-comparative-matrix\" && \"Weighted RFQ Comparative Decision Matrix\"}\n              {sheetKey === \"creation-product-recipe\" && \"Product Recipe Creator (Material Levels)\"}\n              {sheetKey === \"costing-materials-recipe\" && \"Detailed Material Costing Breakdown in Recipe\"}\n            </h3>\n          </div>\n        </div>\n        {onClose && (\n          <button \n            id=\"close-minor-sheet\"\n            onClick={onClose}\n            className=\"cursor-pointer text-xs font-semibold px-4 py-1.5 rounded-lg bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition\"\n          >\n            \342\206\220 Close & Save Sheet\n          </button>\n        )}\n      </div>\n\n      {/* RENDER DYNAMIC WORKSHEETS */}\n      <div className=\"p-6\">\n        \n        {/* =======================================================\n            1. CREATION TARGET SPECIFICATIONS \n           ======================================================= */}\n        {sheetKey === \"target-specs\" && (\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8\">\n            <div className=\"lg:col-span-4 border-r border-slate-100 pr-0 lg:pr-6 flex flex-col gap-3\">\n              <span className=\"text-xs font-semibold text-slate-400 uppercase tracking-widest font-mono\">\n                Existing Specifications\n              </span>\n              <div className=\"space-y-2\">\n                {targetSpecs.map(spec => (\n                  <button\n                    key={spec.id}\n                    id={`select-spec-${spec.id}`}\n                    onClick={() => setSelectedSpecId(spec.id)}\n                    className={`w-full text-left p-3 rounded-lg border transition ${\n                      selectedSpecId === spec.id \n                        ? \"border-orange-500 bg-orange-50/50\" \n                        : \"border-slate-200 hover:bg-slate-50\"\n                    }`}\n                  >\n                    <div className=\"font-semibold text-slate-800 text-sm\">{spec.productName}</div>\n                    <div className=\"text-xs text-slate-500 mt-0.5\">{spec.category} \342\200\242 {spec.lastUpdated}</div>\n                  </button>\n                ))}\n              </div>\n\n              <button\n                id=\"btn-add-spec\"\n                onClick={handleAddSpec}\n                className=\"mt-2 w-full flex items-center justify-center gap-2 py-2 px-4 rounded-lg border border-dashed border-slate-300 text-slate-600 hover:text-slate-900 hover:border-slate-400 text-xs font-semibold\"\n              >\n                <Plus className=\"h-4 w-4\" /> Add Custom Product Spec\n              </button>\n            </div>\n\n            <div className=\"lg:col-span-8 space-y-6\">\n              {currentSpec ? (\n                <div>\n                  <div className=\"flex justify-between items-start border-b border-slate-100 pb-4 mb-4\">\n                    <div>\n                      <h4 className=\"text-base font-bold text-slate-800\">{currentSpec.productName}</h4>\n                      <p className=\"text-xs text-slate-500 font-mono\">ID: {currentSpec.id} | Last Sync: {currentSpec.lastUpdated}</p>\n                    </div>\n                    <span className=\"bg-slate-100 border text-slate-700 text-[10px] px-2.5 py-1 rounded font-semibold uppercase font-mono\">\n                      Specs Draft\n                    </span>\n                  </div>\n\n                  <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                    <div>\n                      <label className=\"block text-xs font-bold text-slate-600 mb-1\">Product Title</label>\n                      <input\n                        type=\"text\"\n                        value={currentSpec.productName}\n                        onChange={(e) => handleUpdateSpecField(\"productName\", e.target.value)}\n                        className=\"w-full text-sm p-2 rounded-lg border border-slate-200 focus:border-orange-500 focus:outline-none\"\n                      />\n                    </div>\n                    <div>\n                      <label className=\"block text-xs font-bold text-slate-600 mb-1\">Product Category</label>\n                      <input\n                        type=\"text\"\n                        value={currentSpec.category}\n                        onChange={(e) => handleUpdateSpecField(\"category\", e.target.value)}\n                        className=\"w-full text-sm p-2 rounded-lg border border-slate-200 focus:border-orange-500\"\n                      />\n                    </div>\n\n                    <div className=\"md:col-span-2 grid grid-cols-3 gap-2 bg-slate-50 p-3 rounded-lg border border-slate-200\">\n                      <div>\n                        <label className=\"block text-[11px] font-bold text-slate-500 mb-0.5\">Width (cm)</label>\n                        <input\n                          type=\"number\"\n                          value={currentSpec.dimensionsWidth}\n                          onChange={(e) => handleUpdateSpecField(\"dimensionsWidth\", Number(e.target.value))}\n                          className=\"w-full text-xs p-1.5 rounded border border-slate-200 bg-white\"\n                        />\n                      </div>\n                      <div>\n                        <label className=\"block text-[11px] font-bold text-slate-500 mb-0.5\">Length (cm)</label>\n                        <input\n                          type=\"number\"\n                          value={currentSpec.dimensionsLength}\n                          onChange={(e) => handleUpdateSpecField(\"dimensionsLength\", Number(e.target.value))}\n                          className=\"w-full text-xs p-1.5 rounded border border-slate-200 bg-white\"\n                        />\n                      </div>\n                      <div>\n                        <label className=\"block text-[11px] font-bold text-slate-500 mb-0.5\">Height (cm)</label>\n                        <input\n                          type=\"number\"\n                          value={currentSpec.dimensionsHeight}\n                          onChange={(e) => handleUpdateSpecField(\"dimensionsHeight\", Number(e.target.value))}\n                          className=\"w-full text-xs p-1.5 rounded border border-slate-200 bg-white\"\n                        />\n                      </div>\n                    </div>\n\n                    <div>\n                      <label className=\"block text-xs font-bold text-slate-600 mb-1\">Cover Fabric / Primary Material</label>\n                      <input\n                        type=\"text\"\n                        value={currentSpec.materialCover}\n                        onChange={(e) => handleUpdateSpecField(\"materialCover\", e.target.value)}\n                        className=\"w-full text-sm p-2 rounded-lg border border-slate-200 focus:border-orange-500\"\n                      />\n                    </div>\n\n                    <div>\n                      <label className=\"block text-xs font-bold text-slate-600 mb-1\">Filling / Core Padding</label>\n                      <input\n                        type=\"text\"\n                        value={currentSpec.materialFilling}\n                        onChange={(e) => handleUpdateSpecField(\"materialFilling\", e.target.value)}\n                        className=\"w-full text-sm p-2 rounded-lg border border-slate-200 focus:border-orange-500\"\n                      />\n                    </div>\n\n                    <div>\n                      <label className=\"block text-xs font-bold text-slate-600 mb-1\">Target EXW Price (USD)</label>\n                      <div className=\"relative\">\n                        <span className=\"absolute left-3 top-2 text-sm text-slate-400 font-mono\">$</span>\n                        <input\n                          type=\"number\"\n                          step=\"0.1\"\n                          value={currentSpec.targetExwPrice}\n                          onChange={(e) => handleUpdateSpecField(\"targetExwPrice\", Number(e.target.value))}\n                          className=\"w-full text-sm p-2 pl-6 rounded-lg border border-slate-200 focus:border-orange-500 font-mono\"\n                        />\n                      </div>\n                    </div>\n\n                    <div>\n                      <label className=\"block text-xs font-bold text-slate-600 mb-1\">Target FOB Price (USD)</label>\n                      <div className=\"relative\">\n                        <span className=\"absolute left-3 top-2 text-sm text-slate-400 font-mono\">$</span>\n                        <input\n                          type=\"number\"\n                          step=\"0.1\"\n                          value={currentSpec.targetFobPrice}\n                          onChange={(e) => handleUpdateSpecField(\"targetFobPrice\", Number(e.target.value))}\n                          className=\"w-full text-sm p-2 pl-6 rounded-lg border border-slate-200 focus:border-orange-500 font-mono\"\n                        />\n                      </div>\n                    </div>\n\n                    <div className=\"md:col-span-2\">\n                      <label className=\"block text-xs font-bold text-slate-600 mb-1\">Packaging specifications & Vacuum Density</label>\n                      <textarea\n                        rows={2}\n                        value={currentSpec.packagingDetails}\n                        onChange={(e) => handleUpdateSpecField(\"packagingDetails\", e.target.value)}\n                        className=\"w-full text-sm p-2 rounded-lg border border-slate-200 focus:border-orange-500\"\n                      />\n                    </div>\n\n                    <div className=\"md:col-span-2\">\n                      <label className=\"block text-xs font-bold text-slate-600 mb-1\">Core Safety Guidelines & Notes</label>\n                      <textarea\n                        rows={2}\n                        value={currentSpec.notes}\n                        onChange={(e) => handleUpdateSpecField(\"notes\", e.target.value)}\n                        className=\"w-full text-sm p-2 rounded-lg border border-slate-200 focus:border-orange-500\"\n                      />\n                    </div>\n                  </div>\n\n                  <div className=\"mt-6 flex gap-4 p-4 rounded-xl bg-orange-50 border border-orange-100 items-start\">\n                    <Info className=\"h-5 w-5 text-orange-600 mt-0.5 shrink-0\" />\n                    <div>\n                      <h5 className=\"font-semibold text-orange-800 text-sm\">Transparent Quality Control Matrix</h5>\n                      <p className=\"text-xs text-orange-700 leading-relaxed mt-1\">\n                        Defining target specs early prevents suppliers from substituting cheap components in Bursa or Izmir. Turkish customs check synthetic fillings with high inspection priority.\n                      </p>\n                    </div>\n                  </div>\n                </div>\n              ) : (\n                <div className=\"p-8 text-center text-slate-400\">Loading specs details...</div>\n              )}\n            </div>\n          </div>\n        )}\n\n        {/* =======================================================\n            2. Request for Quote (RFQ) Submission\n           ======================================================= */}\n        {sheetKey === \"rfq-submission\" && (\n          <div className=\"space-y-6\">\n            <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b pb-4\">\n              <div>\n                <h4 className=\"text-base font-bold text-slate-800\">RFQ Sourcing Campaign: {currentRfq.rfcCode}</h4>\n                <p className=\"text-xs text-slate-500\">Active product focus: <strong>{currentRfq.productName}</strong> | Target Qty: {currentRfq.targetQty} Units</p>\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-xs text-slate-600 font-medium\">Status:</span>\n                <select\n                  value={currentRfq.status}\n                  onChange={(e) => {\n                    setRfqs(prev => prev.map(r => r.id === selectedRfqId ? { ...r, status: e.target.value as any } : r));\n                    showBanner(`RFQ Campaign status updated to ${e.target.value}`);\n                  }}\n                  className=\"text-xs font-semibold p-1.5 rounded-lg border border-slate-200 bg-white text-slate-700\"\n                >\n                  <option value=\"Sent\">Sent</option>\n                  <option value=\"Quote Received\">Quote Received</option>\n                  <option value=\"Reviewing\">Reviewing</option>\n                  <option value=\"Approved\">Approved</option>\n                </select>\n              </div>\n            </div>\n\n            {/* Quote list for selected campaign */}\n            <div className=\"space-y-4\">\n              <h5 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider font-mono\">Quotations Returned from Manufacturers</h5>\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                {currentRfq.suppliers.map((sup, idx) => (\n                  <div key={sup.id} className=\"bg-slate-50 p-4 rounded-xl border border-slate-200 relative overflow-hidden\">\n                    <div className=\"absolute top-0 right-0 p-1.5 bg-orange-500 text-white text-[9px] font-mono font-bold tracking-tight px-2 rounded-bl-lg\">\n                      QUOTE #{idx+1}\n                    </div>\n                    <div className=\"font-bold text-slate-800 text-sm mt-1\">{sup.supplierName}</div>\n                    <div className=\"text-[11px] text-slate-500 font-medium mb-3\">{sup.location}</div>\n                    \n                    <div className=\"space-y-2 border-t pt-3 text-xs\">\n                      <div className=\"flex justify-between\">\n                        <span className=\"text-slate-500\">EXW Quote:</span>\n                        <strong className=\"text-slate-800 font-mono\">${sup.initialQuoteExw.toFixed(2)}</strong>\n                      </div>\n                      <div className=\"flex justify-between\">\n                        <span className=\"text-slate-500\">Lead Time:</span>\n                        <strong className=\"text-slate-800\">{sup.leadTimeDays} Days</strong>\n                      </div>\n                      <div className=\"flex justify-between\">\n                        <span className=\"text-slate-500 font-mono\">NDA Signed:</span>\n                        <strong className={sup.hasNda ? \"text-green-600 text-[10px]\" : \"text-amber-600 text-[10px]\"}>\n                          {sup.hasNda ? \"\342\234\223 SECURE\" : \"\342\234\225 PENDING\"}\n                        </strong>\n                      </div>\n                      <div className=\"text-[11px] text-slate-600 italic bg-white p-2 rounded border mt-2 leading-tight\">\n                        \"{sup.notes}\"\n                      </div>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            {/* Quick Quote Adder Form */}\n            <div className=\"bg-slate-50 p-4 rounded-xl border border-slate-200\">\n              <h5 className=\"text-xs font-bold text-slate-800 mb-3 flex items-center gap-2\">\n                <Plus className=\"h-4 w-4 text-orange-500\" /> Enter New Bid/Quotation from Sourcing Manager\n              </h5>\n              <div className=\"grid grid-cols-1 sm:grid-cols-4 gap-3\">\n                <input\n                  type=\"text\"\n                  placeholder=\"Supplier Company Name\"\n                  value={newSupplierName}\n                  onChange={(e) => setNewSupplierName(e.target.value)}\n                  className=\"p-2 border rounded-lg bg-white text-sm\"\n                />\n                <input\n                  type=\"text\"\n                  placeholder=\"City, Turkey\"\n                  value={newSupplierLocation}\n                  onChange={(e) => setNewSupplierLocation(e.target.value)}\n                  className=\"p-2 border rounded-lg bg-white text-sm\"\n                />\n                <div className=\"relative\">\n                  <span className=\"absolute left-2.5 top-2.5 text-xs text-slate-400 font-mono\">$</span>\n                  <input\n                    type=\"number\"\n                    step=\"0.05\"\n                    placeholder=\"EXW Price\"\n                    value={newSupplierQuote}\n                    onChange={(e) => setNewSupplierQuote(Number(e.target.value))}\n                    className=\"p-2 pl-6 border rounded-lg bg-white text-sm w-full font-mono\"\n                  />\n                </div>\n                <button\n                  id=\"btn-add-val-supplier\"\n                  onClick={handleAddSupplierToRfq}\n                  className=\"bg-orange-600 hover:bg-orange-700 text-white font-semibold text-xs py-2 px-3 rounded-lg flex items-center justify-center gap-1.5 transition whitespace-nowrap cursor-pointer\"\n                >\n                  Save Quote\n                </button>\n              </div>\n            </div>\n\n            {/* Generated copyable RFQ Email Template */}\n            <div className=\"bg-slate-900 text-slate-300 p-4 rounded-xl font-mono text-xs space-y-3\">\n              <div className=\"flex justify-between items-center text-slate-400 border-b border-slate-800 pb-2\">\n                <span className=\"font-semibold text-[10px] text-orange-400\">AUTOMATED OUTGOING RFQ MAIL (COPYABLE)</span>\n                <button\n                  onClick={() => {\n                    navigator.clipboard.writeText(`Subject: Request For Quotation - ${currentRfq.productName} - Trade2Turkey\\n\\nDear Sir/Madam,\\nWe are officially requesting a comprehensive export quote for ${currentRfq.productName} for an initial order size of ${currentRfq.targetQty} units...`);\n                    showBanner(\"RFQ email template copied to clipboard!\");\n                  }}\n                  className=\"text-orange-400 hover:text-orange-300 font-bold\"\n                >\n                  Copy Template\n                </button>\n              </div>\n              <p className=\"text-[11px] leading-relaxed\">\n                <strong>Subject:</strong> RFQ: Trade2Turkey - {currentRfq.productName} Co-op <br/>\n                <strong>Body:</strong> <br/>\n                Dear Ottoman / Anatolian Sourcing Partner,<br/>\n                Hope this message finds you well.<br/><br/>\n                Trade2Turkey is sourcing high-quality products for an overseas client. We demand direct EXW Turkish Lira or Euro pricing with strict compliance matching <strong>REACH and fire safety certification</strong> rules.<br/><br/>\n                - Target Product: {currentRfq.productName}<br/>\n                - Direct Qty: {currentRfq.targetQty} units<br/>\n                - Desired Lead Time: Under 25 Days<br/><br/>\n                Please fill in your raw material specification breakdowns, packaging weight metrics and earliest shipping date quotes.\n              </p>\n            </div>\n          </div>\n        )}\n\n        {/* =======================================================\n            3. COSTING - VALUE CHAIN CALCULATOR (A.A.6)\n           ======================================================= */}\n        {sheetKey === \"costing-value-chain\" && (\n          <div className=\"space-y-6\">\n            <div className=\"bg-slate-50 p-4 rounded-xl border border-slate-200\">\n              <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-4\">\n                <div>\n                  <h4 className=\"text-sm font-bold text-slate-800 font-display\">Value Chain Target: {currentCost?.productName}</h4>\n                  <p className=\"text-xs text-slate-500 font-mono\">Consolidation size estimation: 1 Sea Container ({currentCost?.quantity} units)</p>\n                </div>\n                <div className=\"flex gap-2\">\n                  <div className=\"text-right\">\n                    <div className=\"text-slate-400 text-[10px] uppercase font-mono font-bold\">Total Landed Costs</div>\n                    <div className=\"text-lg font-extrabold text-orange-600 font-mono\">${landedResult.landed.toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2})}</div>\n                  </div>\n                  <div className=\"border-l border-slate-300 pl-3 text-right\">\n                    <div className=\"text-slate-400 text-[10px] uppercase font-mono font-bold\">Per Unit Landed</div>\n                    <div className=\"text-lg font-extrabold text-blue-600 font-mono\">${landedResult.perUnit.toFixed(2)}</div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Slider / Numbers inputs */}\n              <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4 mt-2\">\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-600 mb-1\">EXW Unit price ($)</label>\n                  <input\n                    type=\"number\"\n                    step=\"0.05\"\n                    value={currentCost.exwUnitPrice}\n                    onChange={(e) => {\n                      setValueChain(prev => prev.map((c, i) => i === selectedCostIndex ? { ...c, exwUnitPrice: Number(e.target.value) } : c));\n                    }}\n                    className=\"w-full p-2 text-sm border bg-white rounded-lg font-mono\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-600 mb-1\">Istanbul Domestic Trucking ($)</label>\n                  <input\n                    type=\"number\"\n                    value={currentCost.domesticFreightTurkey}\n                    onChange={(e) => {\n                      setValueChain(prev => prev.map((c, i) => i === selectedCostIndex ? { ...c, domesticFreightTurkey: Number(e.target.value) } : c));\n                    }}\n                    className=\"w-full p-2 text-sm border bg-white rounded-lg font-mono\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-600 mb-1\">Turkey Export Customs ($)</label>\n                  <input\n                    type=\"number\"\n                    value={currentCost.exportCustomsTurkey}\n                    onChange={(e) => {\n                      setValueChain(prev => prev.map((c, i) => i === selectedCostIndex ? { ...c, exportCustomsTurkey: Number(e.target.value) } : c));\n                    }}\n                    className=\"w-full p-2 text-sm border bg-white rounded-lg font-mono\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-600 mb-1\">Ocean Freight (Rotterdam) ($)</label>\n                  <input\n                    type=\"number\"\n                    value={currentCost.oceanFreight}\n                    onChange={(e) => {\n                      setValueChain(prev => prev.map((c, i) => i === selectedCostIndex ? { ...c, oceanFreight: Number(e.target.value) } : c));\n                    }}\n                    className=\"w-full p-2 text-sm border bg-white rounded-lg font-mono\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-600 mb-1\">EU Customs Duty (%)</label>\n                  <input\n                    type=\"number\"\n                    value={currentCost.importCustomsDuty}\n                    onChange={(e) => {\n                      setValueChain(prev => prev.map((c, i) => i === selectedCostIndex ? { ...c, importCustomsDuty: Number(e.target.value) } : c));\n                    }}\n                    className=\"w-full p-2 text-sm border bg-white rounded-lg font-mono\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-600 mb-1\">Local Delivery Inland ($)</label>\n                  <input\n                    type=\"number\"\n                    value={currentCost.inlandDelivery}\n                    onChange={(e) => {\n                      setValueChain(prev => prev.map((c, i) => i === selectedCostIndex ? { ...c, inlandDelivery: Number(e.target.value) } : c));\n                    }}\n                    className=\"w-full p-2 text-sm border bg-white rounded-lg font-mono\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-600 mb-1\">Warehousing Handling ($)</label>\n                  <input\n                    type=\"number\"\n                    value={currentCost.localWarehousingAndHandling}\n                    onChange={(e) => {\n                      setValueChain(prev => prev.map((c, i) => i === selectedCostIndex ? { ...c, localWarehousingAndHandling: Number(e.target.value) } : c));\n                    }}\n                    className=\"w-full p-2 text-sm border bg-white rounded-lg font-mono\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-600 mb-1\">Inflation Safety Buffer ($)</label>\n                  <input\n                    type=\"number\"\n                    value={currentCost.unexpectedBuffer}\n                    onChange={(e) => {\n                      setValueChain(prev => prev.map((c, i) => i === selectedCostIndex ? { ...c, unexpectedBuffer: Number(e.target.value) } : c));\n                    }}\n                    className=\"w-full p-2 text-sm border bg-white rounded-lg font-mono\"\n                  />\n                </div>\n              </div>\n            </div>\n\n            {/* Landed Cost Breakdown component visualization */}\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 bg-slate-900 p-6 rounded-xl text-white\">\n              <div>\n                <h4 className=\"text-sm font-bold uppercase tracking-wider text-orange-400 font-mono mb-4\">Landed Component Cost Breakdown</h4>\n                \n                <div className=\"space-y-3 font-medium\">\n                  {/* EXW Raw Fabric Portion */}\n                  <div>\n                    <div className=\"flex justify-between text-xs mb-1\">\n                      <span className=\"text-slate-300\">1. Raw EXW Cost (Bursa Mill)</span>\n                      <strong className=\"font-mono\">${landedResult.breakdown.rawExw.toFixed(2)} / unit</strong>\n                    </div>\n                    <div className=\"w-full bg-slate-800 h-2 rounded overflow-hidden\">\n                      <div className=\"bg-orange-500 h-2\" style={{width: `${(landedResult.breakdown.rawExw / landedResult.perUnit) * 100}%`}}></div>\n                    </div>\n                  </div>\n\n                  {/* Turkey Customs & Domestic Transport */}\n                  <div>\n                    <div className=\"flex justify-between text-xs mb-1\">\n                      <span className=\"text-slate-300\">2. Turkey Local Transport & Customs</span>\n                      <strong className=\"font-mono\">${landedResult.breakdown.turkeyLogistics.toFixed(2)} / unit</strong>\n                    </div>\n                    <div className=\"w-full bg-slate-800 h-2 rounded overflow-hidden\">\n                      <div className=\"bg-teal-500 h-2\" style={{width: `${(landedResult.breakdown.turkeyLogistics / landedResult.perUnit) * 100}%`}}></div>\n                    </div>\n                  </div>\n\n                  {/* Ocean container shipping cost */}\n                  <div>\n                    <div className=\"flex justify-between text-xs mb-1\">\n                      <span className=\"text-slate-300\">3. Vessel Sea Freight (Istanbul to Rotterdam)</span>\n                      <strong className=\"font-mono\">${landedResult.breakdown.oceanFreightPrice.toFixed(2)} / unit</strong>\n                    </div>\n                    <div className=\"w-full bg-slate-800 h-2 rounded overflow-hidden\">\n                      <div className=\"bg-blue-500 h-2\" style={{width: `${(landedResult.breakdown.oceanFreightPrice / landedResult.perUnit) * 100}%`}}></div>\n                    </div>\n                  </div>\n\n                  {/* EU Import duty charges */}\n                  <div>\n                    <div className=\"flex justify-between text-xs mb-1\">\n                      <span className=\"text-slate-300\">4. European Port Duties ({currentCost.importCustomsDuty}%)</span>\n                      <strong className=\"font-mono\">${landedResult.breakdown.importDuty.toFixed(2)} / unit</strong>\n                    </div>\n                    <div className=\"w-full bg-slate-800 h-2 rounded overflow-hidden\">\n                      <div className=\"bg-purple-500 h-2\" style={{width: `${(landedResult.breakdown.importDuty / landedResult.perUnit) * 100}%`}}></div>\n                    </div>\n                  </div>\n\n                  {/* Local warehousing and delivery */}\n                  <div>\n                    <div className=\"flex justify-between text-xs mb-1\">\n                      <span className=\"text-slate-300\">5. Destination Port Handling & Inland Delivery</span>\n                      <strong className=\"font-mono\">${landedResult.breakdown.destinationHandling.toFixed(2)} / unit</strong>\n                    </div>\n                    <div className=\"w-full bg-slate-800 h-2 rounded overflow-hidden\">\n                      <div className=\"bg-yellow-500 h-2\" style={{width: `${(landedResult.breakdown.destinationHandling / landedResult.perUnit) * 100}%`}}></div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"flex flex-col justify-between border-l border-slate-800 pl-6\">\n                <div>\n                  <h4 className=\"text-sm font-bold uppercase tracking-wider text-orange-400 font-mono mb-2\">Value-Added Advice</h4>\n                  <p className=\"text-xs text-slate-300 leading-relaxed\">\n                    Sourcing directly from Turkey avoids the steep 12%-25% EU import tariff levied on Chinese textiles. The shipping time from Turkey\'s Port of Ambarli to Rotterdam is only <strong>12-14 days</strong> compared to 35-40 days from Shanghai, drastically lowering inventory holding costs!\n                  </p>\n                </div>\n                <div className=\"mt-4 p-4 rounded-lg bg-slate-800 text-xs border border-slate-700\">\n                  <div className=\"font-bold text-slate-200\">Custom Broker Checklist:</div>\n                  <ul className=\"list-disc ml-4 mt-1.5 space-y-1 text-slate-400 font-mono text-[10px]\">\n                    <li>ATR Certification: Checked (0% import tariff)</li>\n                    <li>Somatic Test Filling report: OK</li>\n                    <li>EUR.1 Document generated & packed</li>\n                  </ul>\n                </div>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* =======================================================\n            4. RFQ COMPARATIVE MATRIX (A.B.6)\n           ======================================================= */}\n        {sheetKey === \"rfq-comparative-matrix\" && (\n          <div className=\"space-y-6\">\n            <div className=\"bg-slate-50 p-4 rounded-xl border border-slate-200\">\n              <h4 className=\"text-sm font-bold text-slate-800 font-display mb-3\">Decision Matrix: Weight Sourcing Priorities</h4>\n              <p className=\"text-xs text-slate-500 mb-4\">Adjust sliders to fit the project priority weight (Total must count to 100%). Score is calculated live!</p>\n              \n              <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-600 mb-1\">Price Weight: {currentMatrix.criteriaWeights.unitPrice}%</label>\n                  <input\n                    type=\"range\"\n                    min=\"10\"\n                    max=\"60\"\n                    value={currentMatrix.criteriaWeights.unitPrice}\n                    onChange={(e) => {\n                      const val = Number(e.target.value);\n                      const rem = 100 - val;\n                      setRfqMatrix(prev => prev.map(m => m.id === selectedMatrixId ? {\n                        ...m,\n                        criteriaWeights: {\n                          ...m.criteriaWeights,\n                          unitPrice: val,\n                          leadTime: Math.round(rem * 0.4),\n                          quality: Math.round(rem * 0.45),\n                          financialStability: Math.round(rem * 0.15),\n                        }\n                      } : m));\n                    }}\n                    className=\"w-full accent-orange-500 cursor-pointer\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-600 mb-1\">Lead Time: {currentMatrix.criteriaWeights.leadTime}%</label>\n                  <input\n                    type=\"range\"\n                    min=\"10\"\n                    max=\"50\"\n                    value={currentMatrix.criteriaWeights.leadTime}\n                    onChange={(e) => {\n                      const val = Number(e.target.value);\n                      const rem = 100 - val;\n                      setRfqMatrix(prev => prev.map(m => m.id === selectedMatrixId ? {\n                        ...m,\n                        criteriaWeights: {\n                          ...m.criteriaWeights,\n                          leadTime: val,\n                          unitPrice: Math.round(rem * 0.45),\n                          quality: Math.round(rem * 0.4),\n                          financialStability: Math.round(rem * 0.15),\n                        }\n                      } : m));\n                    }}\n                    className=\"w-full accent-orange-500\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-600 mb-1\">Quality standards: {currentMatrix.criteriaWeights.quality}%</label>\n                  <input\n                    type=\"range\"\n                    min=\"10\"\n                    max=\"55\"\n                    value={currentMatrix.criteriaWeights.quality}\n                    onChange={(e) => {\n                      const val = Number(e.target.value);\n                      const rem = 100 - val;\n                      setRfqMatrix(prev => prev.map(m => m.id === selectedMatrixId ? {\n                        ...m,\n                        criteriaWeights: {\n                          ...m.criteriaWeights,\n                          quality: val,\n                          unitPrice: Math.round(rem * 0.5),\n                          leadTime: Math.round(rem * 0.35),\n                          financialStability: Math.round(rem * 0.15),\n                        }\n                      } : m));\n                    }}\n                    className=\"w-full accent-orange-500\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-600 mb-1\">Compliance Weight: {currentMatrix.criteriaWeights.financialStability}%</label>\n                  <input\n                    type=\"range\"\n                    min=\"5\"\n                    value={currentMatrix.criteriaWeights.financialStability}\n                    disabled\n                    className=\"w-full accent-slate-300 opacity-60\"\n                  />\n                </div>\n              </div>\n            </div>\n\n            {/* Matrix Result Board */}\n            <div className=\"overflow-x-auto border rounded-xl\">\n              <table className=\"w-full text-left text-sm border-collapse bg-white\">\n                <thead>\n                  <tr className=\"bg-slate-900 text-slate-200 uppercase text-[10px] tracking-wider font-mono\">\n                    <th className=\"p-4\">Supplier Candidate</th>\n                    <th className=\"p-4\">EXW Quote</th>\n                    <th className=\"p-4\">Lead Time</th>\n                    <th className=\"p-4\">Quality Score (1-10)</th>\n                    <th className=\"p-4\">Compliance Status</th>\n                    <th className=\"p-4 bg-orange-950 text-orange-400 font-bold\">Weighted T2T Score</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-slate-100\">\n                  {matrixComputedSuppliers.map((sup, idx) => (\n                    <tr key={sup.name} className={`${idx === 0 ? \"bg-orange-50/20 font-medium\" : \"hover:bg-slate-50\"}`}>\n                      <td className=\"p-4 font-bold text-slate-800 flex items-center gap-2\">\n                        {sup.name}\n                        {idx === 0 && <span className=\"bg-emerald-100 text-emerald-800 text-[9px] px-1.5 py-0.5 rounded font-bold font-mono\">\360\237\217\206 Best Choice</span>}\n                      </td>\n                      <td className=\"p-4 font-mono\">${sup.unitPriceExw.toFixed(2)}</td>\n                      <td className=\"p-4 font-mono\">{sup.leadTimeDays} Days</td>\n                      <td className=\"p-4\">\n                        <div className=\"flex items-center gap-1.5\">\n                          <span className=\"font-semibold text-slate-700\">{sup.qualityScore}/10</span>\n                          <span className=\"text-xs text-slate-400\">({sup.qualityScore >= 9 ? \"Excellent\" : \"Sufficient\"})</span>\n                        </div>\n                      </td>\n                      <td className=\"p-4\">\n                        <span className={`text-[11px] font-semibold px-2 py-0.5 rounded ${sup.complianceScore >= 9 ? \"bg-green-100 text-green-800\" : \"bg-amber-100 text-amber-800\"}`}>\n                          {sup.complianceScore >= 9 ? \"Gold Compliant\" : \"Verified Safe\"}\n                        </span>\n                      </td>\n                      <td className=\"p-4 font-mono font-black text-slate-900 bg-orange-50/40 text-lg\">\n                        {sup.totalScore}\n                      </td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n            </div>\n          </div>\n        )}\n\n        {/* =======================================================\n            5. PRODUCT RECIPE CREATOR & COMPONENT COSTS (A.B.8)\n           ======================================================= */}\n        {sheetKey === \"creation-product-recipe\" && (\n          <div className=\"space-y-6\">\n            <div className=\"flex justify-between items-center border-b pb-4\">\n              <div>\n                <h4 className=\"text-base font-bold text-slate-800\">Ingredients Recipe: {currentRecipe?.productName}</h4>\n                <p className=\"text-xs text-slate-500\">Structured raw level specifications bill-of-materials (BOM) creator</p>\n              </div>\n              <span className=\"font-mono text-xs text-slate-400\">Ver: {currentRecipe?.version}</span>\n            </div>\n\n            {/* List of Recipe Materials in Recipe */}\n            <div className=\"border rounded-xl bg-white overflow-hidden\">\n              <table className=\"w-full text-left text-xs border-collapse\">\n                <thead>\n                  <tr className=\"bg-slate-50 text-slate-500 font-mono font-bold uppercase border-b p-3\">\n                    <th className=\"p-3\">Raw Component Material</th>\n                    <th className=\"p-3\">Qty Used</th>\n                    <th className=\"p-3\">Unit Cost (USD)</th>\n                    <th className=\"p-3\">Scrap %</th>\n                    <th className=\"p-3\">Source Bursa/Izmir/etc.</th>\n                    <th className=\"p-3 text-right\">Raw Cost</th>\n                    <th className=\"p-3\"></th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-slate-100\">\n                  {currentRecipe?.materials.map(mat => {\n                    const cost = mat.qtyRequired * mat.unitCostUsd;\n                    return (\n                      <tr key={mat.id} className=\"hover:bg-slate-50 text-slate-700\">\n                        <td className=\"p-3 font-semibold text-slate-800\">{mat.name}</td>\n                        <td className=\"p-3 font-mono\">{mat.qtyRequired} {mat.unit}</td>\n                        <td className=\"p-3 font-mono\">${mat.unitCostUsd.toFixed(3)}</td>\n                        <td className=\"p-3 font-mono\">{mat.scrapRatePercent}%</td>\n                        <td className=\"p-3 font-semibold text-teal-700\">{mat.source}</td>\n                        <td className=\"p-3 font-mono text-right font-semibold text-slate-950\">${cost.toFixed(2)}</td>\n                        <td className=\"p-3 text-center\">\n                          <button\n                            id={`btn-del-mat-${mat.id}`}\n                            onClick={() => handleRemoveMaterial(mat.id)}\n                            className=\"cursor-pointer text-slate-400 hover:text-red-500 p-1\"\n                          >\n                            <Trash2 className=\"h-4 w-4\" />\n                          </button>\n                        </td>\n                      </tr>\n                    );\n                  })}\n                </tbody>\n              </table>\n            </div>\n\n            {/* Data Entry Form to Add Material inside recipe */}\n            <div className=\"bg-slate-50 p-4 rounded-xl border border-slate-200\">\n              <h5 className=\"text-xs font-bold text-slate-800 mb-3\">Add Bill of Material (BOM) Component</h5>\n              <div className=\"grid grid-cols-2 md:grid-cols-6 gap-2\">\n                <input\n                  type=\"text\"\n                  placeholder=\"Material description\"\n                  value={newMatName}\n                  onChange={(e) => setNewMatName(e.target.value)}\n                  className=\"p-2 border rounded-lg bg-white text-xs col-span-2 md:col-span-2\"\n                />\n                <input\n                  type=\"number\"\n                  placeholder=\"Quantity\"\n                  value={newMatQty}\n                  onChange={(e) => setNewMatQty(Number(e.target.value))}\n                  className=\"p-2 border rounded-lg bg-white text-xs font-mono\"\n                />\n                <select\n                  value={newMatUnit}\n                  onChange={(e) => setNewMatUnit(e.target.value)}\n                  className=\"p-2 border rounded-lg bg-white text-xs font-mono\"\n                >\n                  <option value=\"meters\">meters</option>\n                  <option value=\"liters\">liters</option>\n                  <option value=\"pcs\">pcs</option>\n                  <option value=\"kg\">kg</option>\n                  <option value=\"coils\">coils</option>\n                </select>\n                <input\n                  type=\"number\"\n                  step=\"0.001\"\n                  placeholder=\"Unit Cost ($)\"\n                  value={newMatCost}\n                  onChange={(e) => setNewMatCost(Number(e.target.value))}\n                  className=\"p-2 border rounded-lg bg-white text-xs font-mono\"\n                />\n                <input\n                  type=\"number\"\n                  placeholder=\"Scrap Margin %\"\n                  value={newMatScrap}\n                  onChange={(e) => setNewMatScrap(Number(e.target.value))}\n                  className=\"p-2 border rounded-lg bg-white text-xs font-mono\"\n                />\n              </div>\n              <div className=\"flex md:flex-row flex-col justify-between items-start md:items-center mt-3 gap-2\">\n                <input\n                  type=\"text\"\n                  placeholder=\"Direct Manufacturer Source\"\n                  value={newMatSource}\n                  onChange={(e) => setNewMatSource(e.target.value)}\n                  className=\"p-2 border rounded-lg bg-white text-xs w-full md:w-3/5\"\n                />\n                <button\n                  id=\"btn-add-mat\"\n                  onClick={handleAddMaterialToRecipe}\n                  className=\"w-full md:w-auto bg-slate-900 hover:bg-black text-white text-xs font-semibold px-4 py-2 rounded-lg flex items-center justify-center gap-2 cursor-pointer whitespace-nowrap\"\n                >\n                  <Plus className=\"h-3.5 w-3.5\" /> Save Ingredient\n                </button>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* =======================================================\n            6. COSTING OF MATERIALS IN RECIPE & WASTAGES (A.B.9)\n           ======================================================= */}\n        {sheetKey === \"costing-materials-recipe\" && (\n          <div className=\"space-y-6\">\n            <div className=\"bg-slate-900 p-6 rounded-xl text-white divide-y divide-slate-800\">\n              <div className=\"pb-4 flex justify-between items-center\">\n                <div>\n                  <h4 className=\"text-base font-bold text-orange-400 font-display\">Granular Sourcing Recipes Costing</h4>\n                  <p className=\"text-xs text-slate-400\">Ingredient breakdown showing waste-adjusted effective EXW cost</p>\n                </div>\n                <div className=\"text-right\">\n                  <div className=\"text-[10px] text-slate-400 font-mono\">CALCULATED RECIPE TOTAL EXW</div>\n                  <div className=\"text-2xl font-black text-white font-mono\">${recipeMetrics.grandTotal.toFixed(2)}</div>\n                </div>\n              </div>\n\n              {/* Dynamic Table displaying raw vs waste costs */}\n              <div className=\"py-4 overflow-x-auto\">\n                <table className=\"w-full text-left text-xs font-mono\">\n                  <thead>\n                    <tr className=\"text-slate-400 border-b border-slate-800 text-[10px] font-bold\">\n                      <th className=\"pb-2\">Ingredient Material</th>\n                      <th className=\"pb-2 text-right\">Base Raw Cost</th>\n                      <th className=\"pb-2 text-right\">Scrap Factor</th>\n                      <th className=\"pb-2 text-right\">Wastage Cost</th>\n                      <th className=\"pb-2 text-right text-orange-400\">Effective Cost (Adjusted)</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-slate-850\">\n                    {currentRecipe?.materials.map(mat => {\n                      const baseRaw = mat.qtyRequired * mat.unitCostUsd;\n                      const waste = baseRaw * (mat.scrapRatePercent / 100);\n                      const adjusted = baseRaw + waste;\n                      return (\n                        <tr key={mat.id} className=\"text-slate-200\">\n                          <td className=\"py-2.5 font-sans font-medium\">{mat.name}</td>\n                          <td className=\"py-2.5 text-right\">${baseRaw.toFixed(2)}</td>\n                          <td className=\"py-2.5 text-right text-red-400\">+{mat.scrapRatePercent}%</td>\n                          <td className=\"py-2.5 text-right text-slate-500\">${waste.toFixed(3)}</td>\n                          <td className=\"py-2.5 text-right text-orange-300 font-bold\">${adjusted.toFixed(2)}</td>\n                        </tr>\n                      );\n                    })}\n                  </tbody>\n                </table>\n              </div>\n\n              {/* Factory Processing Cost Add-ons */}\n              <div className=\"pt-4 grid grid-cols-1 md:grid-cols-4 gap-4 text-xs font-sans\">\n                <div className=\"bg-slate-800/40 p-3 rounded-lg border border-slate-800\">\n                  <span className=\"block text-slate-400 text-[10px] uppercase font-mono font-bold\">Bursa Materials Subtotal</span>\n                  <strong className=\"text-sm font-mono text-slate-200 block mt-1\">\n                    ${recipeMetrics.materialSubtotal.toFixed(2)}\n                  </strong>\n                </div>\n                <div className=\"bg-slate-800/40 p-3 rounded-lg border border-slate-800\">\n                  <span className=\"block text-slate-400 text-[10px] uppercase font-mono font-bold\">Wastage Buffer Allowance</span>\n                  <strong className=\"text-sm font-mono text-red-400 block mt-1\">\n                    +${recipeMetrics.wastageCost.toFixed(2)}\n                  </strong>\n                </div>\n                <div className=\"bg-slate-800/40 p-3 rounded-lg border border-slate-800\">\n                  <span className=\"block text-slate-400 text-[10px] uppercase font-mono font-bold\">Turkey High-skilled Labor</span>\n                  <div className=\"flex items-center gap-1.5 mt-1\">\n                    <span className=\"text-xs font-mono text-slate-400\">$</span>\n                    <input\n                      type=\"number\"\n                      value={currentRecipe.laborCostUsd}\n                      onChange={(e) => {\n                        const val = Number(e.target.value);\n                        setRecipes(prev => prev.map(r => r.id === selectedRecipeId ? { ...r, laborCostUsd: val } : r));\n                      }}\n                      className=\"text-sm font-mono font-bold bg-transparent text-slate-200 focus:outline-none w-16\"\n                    />\n                  </div>\n                </div>\n                <div className=\"bg-slate-800/40 p-3 rounded-lg border border-slate-800\">\n                  <span className=\"block text-slate-400 text-[10px] uppercase font-mono font-bold\">Factory Packaging & Overhead</span>\n                  <div className=\"flex items-center gap-1 mt-1\">\n                    <span className=\"text-[10px] text-slate-500\">Carton:</span>\n                    <input\n                      type=\"number\"\n                      step=\"0.05\"\n                      value={currentRecipe.packagingCostUsd}\n                      onChange={(e) => {\n                        const val = Number(e.target.value);\n                        setRecipes(prev => prev.map(r => r.id === selectedRecipeId ? { ...r, packagingCostUsd: val } : r));\n                      }}\n                      className=\"text-xs font-mono font-bold bg-transparent text-slate-200 focus:outline-none w-12 mr-1\"\n                    />\n                    <span className=\"text-[10px] text-slate-500\">Over:</span>\n                    <input\n                      type=\"number\"\n                      step=\"0.05\"\n                      value={currentRecipe.overheadCostUsd}\n                      onChange={(e) => {\n                        const val = Number(e.target.value);\n                        setRecipes(prev => prev.map(r => r.id === selectedRecipeId ? { ...r, overheadCostUsd: val } : r));\n                      }}\n                      className=\"text-xs font-mono font-bold bg-transparent text-slate-200 focus:outline-none w-12\"\n                    />\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            {/* Price Guard Warning Bar */}\n            {recipeMetrics.grandTotal > currentRecipe.targetExwCost ? (\n              <div className=\"p-4 bg-red-50 border border-red-200 text-red-800 rounded-xl flex items-start gap-3\">\n                <ShieldCheck className=\"h-5 w-5 text-red-600 mt-0.5 shrink-0\" />\n                <div>\n                  <h5 className=\"font-bold text-sm\">Budget Guard Breached!</h5>\n                  <p className=\"text-xs text-red-700 leading-relaxed mt-0.5\">\n                    Your ingredient recipes totaling <strong>${recipeMetrics.grandTotal.toFixed(2)}</strong> exceeds the target EXW Sourcing contract cap of <strong>${currentRecipe.targetExwCost.toFixed(2)}</strong>! Try to optimize fabric consumption scrap rates down or switch fillings supplier.\n                  </p>\n                </div>\n              </div>\n            ) : (\n              <div className=\"p-4 bg-green-50 border border-green-200 text-green-800 rounded-xl flex items-start gap-3\">\n                <ShieldCheck className=\"h-5 w-5 text-green-600 mt-0.5 shrink-0\" />\n                <div>\n                  <h5 className=\"font-bold text-sm\">Safe Budget Margin: Approved</h5>\n                  <p className=\"text-xs text-green-700 leading-relaxed mt-0.5\">\n                    Excellent margin! EXW material formula costing total is currently <strong>${recipeMetrics.grandTotal.toFixed(2)}</strong>, saving <strong>${(currentRecipe.targetExwCost - recipeMetrics.grandTotal).toFixed(2)}</strong> from Trade2Turkey target limits.\n                  </p>\n                </div>\n              </div>\n            )}\n          </div>\n        )}\n\n      </div>\n    </div>\n  );\n}\n"
    }
