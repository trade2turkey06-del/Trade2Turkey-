          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  statusCritical ? \"border-red-200 ring-2 ring-red-100\" : \"border-slate-200\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                }`}>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  {statusCritical && ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    <div className=\"absolute top-0 right-0 p-1.5 bg-red-600 text-white text-[9px] font-bold tracking-wider font-mono uppercase px-2 rounded-bl-lg flex items-center gap-1 animate-pulse\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
