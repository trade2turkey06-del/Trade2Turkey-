          text: "        qty: `${mat.qtyRequired} ${mat.unit}`,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        rate: mat.unitCostUsd,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        scrap: mat.scrapRatePercent,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        effective: parseFloat(effectiveCost.toFixed(2))"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      });"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
