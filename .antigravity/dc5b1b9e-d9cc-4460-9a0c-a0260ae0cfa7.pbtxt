          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const reorderPoint = (dailyUsage * leadTimeDays) + (dailyUsage * safetyStockDays);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const statusCritical = available <= reorderPoint;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
