rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && !(profile().get('status', 'active') in ['suspended', 'Askıya Alındı']); }
    function admin() { return active() && profile().role in ['admin', 'owner'] && (request.auth.token.get('admin',false) == true || request.auth.uid in ['3nJNAflYMQNmBynY7y1608lLNSG2','Ckw0U3jPOqewRO8AqrtDe8OWo6q2']); }
    function assigned(projectId) { return active() && (profile().get('projectId', '') == projectId || projectId in profile().get('assignedProjects', [])); }
    function projectReader(projectId) { return admin() || (assigned(projectId) && profile().role == 'client'); }
    function own(data) { return signedIn() && (data.get('assignedTo', '') == request.auth.uid || data.get('userId', '') == request.auth.uid); }
    function str(value, max) { return value is string && value.size() <= max; }
    function text(value, max) { return str(value, max) && value.size() > 0; }
    function integer(value) { return value is int && value >= 0 && value <= 100000000; }
    function https(value) { return text(value, 2000) && value.matches('https://[^\\s]+'); }
    function sameProject() { return request.resource.data.projectId == resource.data.projectId; }
    function base(projectId) { return request.resource.data.projectId == projectId && request.resource.data.size() <= 60; }
    function audited(projectId) {
      let event = getAfter(/databases/$(database)/documents/projects/$(projectId)/events/$(request.resource.data.lastEventId)).data;
      return event.projectId == projectId && event.actorUid == request.auth.uid && event.at == request.time;
    }
    function validUser(data, id) {
      return data.size() <= 45 && data.id == id && text(data.email, 254) && data.role in ['admin', 'owner', 'client', 'freelancer'] && str(data.get('projectId',''), 100) && str(data.get('companyName',''),200) && data.get('assignedProjects',[]) is list && data.get('assignedProjects',[]).size() <= 30 && str(data.get('name',''),200) && str(data.get('displayName',''),200) && str(data.get('contactPerson',''),200) && str(data.get('title',''),200) && str(data.get('secondaryEmail',''),254) && str(data.get('workPhone',''),50) && str(data.get('cellPhone',''),50) && str(data.get('website',''),2000) && data.get('onboardingCompleted',false) is bool;
    }
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create: if admin() && validUser(request.resource.data, uid);
      allow update: if validUser(request.resource.data, uid) && (admin() || (active() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyName','name','displayName','contactPerson','title','secondaryEmail','workPhone','cellPhone','website','onboardingCompleted'])));
      allow delete: if false;
    }

    function prerequisite(projectId, id) {
      let task = getAfter(/databases/$(database)/documents/sopSteps/$(projectId + '_sourcing-' + id)).data;
      return task.workflowStatus == 'completed' && task.approval == 'approved';
    }
    function prerequisites(projectId, id) {
      return id == 'A.A.1' ||
        (id == 'A.A.2' && prerequisite(projectId,'A.A.1')) ||
        (id == 'A.A.3' && prerequisite(projectId,'A.A.2')) ||
        (id == 'A.A.4' && prerequisite(projectId,'A.A.3')) ||
        (id == 'A.A.5' && prerequisite(projectId,'A.A.4')) ||
        (id == 'A.A.6' && prerequisite(projectId,'A.A.5')) ||
        (id == 'A.A.7' && prerequisite(projectId,'A.A.6')) ||
        (id == 'A.B.1' && prerequisite(projectId,'A.A.7')) ||
        (id == 'A.B.2' && prerequisite(projectId,'A.B.1')) ||
        (id == 'A.B.3' && prerequisite(projectId,'A.B.2')) ||
        (id == 'A.B.4' && prerequisite(projectId,'A.B.3')) ||
        (id == 'A.B.5' && prerequisite(projectId,'A.B.4')) ||
        (id == 'A.B.6' && prerequisite(projectId,'A.B.5')) ||
        (id == 'A.B.7' && prerequisite(projectId,'A.B.6')) ||
        (id == 'A.B.8' && prerequisite(projectId,'A.B.7')) ||
        (id == 'A.B.9' && prerequisite(projectId,'A.B.8')) ||
        (id == 'A.B.10' && prerequisite(projectId,'A.B.9')) ||
        (id == 'A.B.11' && prerequisite(projectId,'A.B.7')) ||
        (id == 'A.B.12' && prerequisite(projectId,'A.B.10') && prerequisite(projectId,'A.B.11')) ||
        (id == 'A.B.13' && prerequisite(projectId,'A.B.12')) ||
        (id == 'A.B.14' && prerequisite(projectId,'A.B.13'));
    }
    function validTask(data) {
      return data.size() <= 40 && text(data.projectId,100) && text(data.stepId,20) && data.workflow == 'sourcing' && data.workflowStatus in ['not_started','in_progress','incomplete','completed'] &&
        data.approval in ['none','pending','approved','rejected'] && (!(data.approval in ['pending','approved']) || data.workflowStatus == 'completed') &&
        str(data.get('notes',''),3000) && str(data.get('rejectionReason',''),1500) && str(data.get('evidenceUrl',''),2000) && str(data.get('evidenceName',''),250) &&
        (!(data.workflowStatus in ['in_progress','completed']) || prerequisites(data.projectId,data.stepId)) &&
        (data.workflowStatus != 'completed' || (text(data.assigneeUid,128) && text(data.approverUid,128) && data.assigneeUid != data.approverUid && get(/databases/$(database)/documents/users/$(data.approverUid)).data.role in ['admin','owner'] && data.dueDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && https(data.evidenceUrl) && text(data.evidenceName,250)));
    }
    function submission(data) { return data.approval != 'pending' || data.completedBy == request.auth.uid; }
    function legacyTask(data) { return data.get('workflow','legacy') != 'sourcing' && text(data.projectId,100) && data.size() <= 60 && text(data.get('task',''),300) && data.get('section','') in ['A','B']; }
    function approverDecision() {
      return resource.data.get('approverUid','') == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approval','workflowStatus','status','rejectionReason','decidedBy','updatedAt','lastEventId']) &&
        ((resource.data.get('approval','none') == 'pending' && request.resource.data.approval == 'approved' && resource.data.completedBy != request.auth.uid) ||
         (request.resource.data.approval == 'rejected' && text(request.resource.data.rejectionReason,1500)));
    }
    function returnedTask() {
      let source = getAfter(/databases/$(database)/documents/sopSteps/$(resource.data.projectId + '_sourcing-' + request.resource.data.returnedFrom)).data;
      return source.approverUid == request.auth.uid && source.approval == 'rejected' && request.resource.data.workflowStatus == 'incomplete' && request.resource.data.approval == 'none' && text(request.resource.data.rejectionReason,1500);
    }
    match /sopSteps/{id} {
      allow read: if projectReader(resource.data.projectId) || (active() && assigned(resource.data.projectId) && profile().role == 'freelancer');
      allow create: if admin() && (legacyTask(request.resource.data) || (id == request.resource.data.projectId + '_sourcing-' + request.resource.data.stepId && validTask(request.resource.data) && submission(request.resource.data) && request.resource.data.approval in ['none','pending'] && audited(request.resource.data.projectId)));
      allow update: if sameProject() && request.resource.data.stepId == resource.data.stepId && validTask(request.resource.data) && audited(resource.data.projectId) && (
        (admin() && ((resource.data.get('approval','none') != 'approved' && request.resource.data.approval in ['none','pending'] && submission(request.resource.data)) || approverDecision() || returnedTask())) ||
        (active() && resource.data.get('assigneeUid','') == request.auth.uid && assigned(resource.data.projectId) && resource.data.get('approval','none') != 'approved' && submission(request.resource.data) && request.resource.data.approval in ['none','pending'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes','dueDate','evidenceName','evidenceUrl','workflowStatus','status','approval','completedBy','rejectionReason','updatedAt','lastEventId']))
      );
      allow delete: if false;
    }

    match /projects/{projectId} {
      allow read: if admin() || assigned(projectId);
      allow create: if admin() && request.resource.data.id == projectId && text(request.resource.data.name,200);
      allow update: if admin() && request.resource.data.id == resource.data.id && request.resource.data.size() <= 80;
      allow delete: if false;

      match /events/{id} {
        allow read: if projectReader(projectId) || (assigned(projectId) && profile().role == 'freelancer' && resource.data.action in ['workflow_save','workflow_approve','workflow_reject']);
        allow create: if base(projectId) && text(request.resource.data.action,80) && text(request.resource.data.entityId,200) && str(request.resource.data.detail,1500) && request.resource.data.actorUid == request.auth.uid && request.resource.data.at == request.time && (admin() || (active() && assigned(projectId) && request.resource.data.action == 'workflow_save' && getAfter(/databases/$(database)/documents/sopSteps/$(projectId + '_sourcing-' + request.resource.data.entityId)).data.lastEventId == id && getAfter(/databases/$(database)/documents/sopSteps/$(projectId + '_sourcing-' + request.resource.data.entityId)).data.assigneeUid == request.auth.uid));
        allow update, delete: if false;
      }
      match /products/{id} {
        allow read: if projectReader(projectId);
        allow create: if admin() && base(projectId) && request.resource.data.id == id && text(request.resource.data.name,200) && text(request.resource.data.sku,80) && integer(request.resource.data.safetyStock) && text(request.resource.data.unit,30);
        allow update: if admin() && base(projectId) && request.resource.data.id == resource.data.id && request.resource.data.sku == resource.data.sku && text(request.resource.data.name,200) && integer(request.resource.data.safetyStock);
        allow delete: if false;
      }
      match /vendors/{id} {
        allow read: if projectReader(projectId);
        allow create, update: if admin() && base(projectId) && request.resource.data.id == id && text(request.resource.data.name,200) && str(request.resource.data.email,254) && str(request.resource.data.location,200);
        allow delete: if false;
      }
      function validQuote(data) {
        return base(projectId) && data.unitPrice is number && data.unitPrice > 0 && data.unitPrice <= 100000000 && integer(data.quantity) && data.quantity > 0 && data.currency in ['USD','EUR','TRY','GBP'] && integer(data.leadTimeDays) && text(data.incoterm,200) && text(data.paymentTerms,200) && existsAfter(/databases/$(database)/documents/projects/$(projectId)/products/$(data.productId)) && existsAfter(/databases/$(database)/documents/projects/$(projectId)/vendors/$(data.supplierId));
      }
      function recovery() { return admin() && request.resource.data.get('recoveredBy','') == request.auth.uid && request.resource.data.get('recoveredAt',null) == request.time; }
      function matchesQuote(data, id) {
        let quote = getAfter(/databases/$(database)/documents/projects/$(projectId)/quotes/$(id)).data;
        return data.quoteId == id && data.quantity == quote.quantity && data.unitPrice == quote.unitPrice && data.productId == quote.productId && data.supplierId == quote.supplierId && data.currency == quote.currency && data.incoterm == quote.incoterm && data.paymentTerms == quote.paymentTerms && data.leadTimeDays == quote.leadTimeDays;
      }
      match /quotes/{id} {
        allow read: if projectReader(projectId);
        allow create: if admin() && validQuote(request.resource.data) && (request.resource.data.selected == false || recovery());
        allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selected']) && request.resource.data.selected == true && existsAfter(/databases/$(database)/documents/projects/$(projectId)/purchaseOrders/$(id));
        allow delete: if false;
      }
      match /purchaseOrders/{id} {
        allow read: if projectReader(projectId);
        allow create: if admin() && base(projectId) && matchesQuote(request.resource.data,id) && ((request.resource.data.receivedQty == 0 && request.resource.data.status == 'draft') || (recovery() && integer(request.resource.data.receivedQty) && request.resource.data.receivedQty <= request.resource.data.quantity));
        allow update: if admin() && (
          (resource.data.status == 'draft' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','poDocumentUrl','confirmedBy','confirmedAt']) && request.resource.data.status == 'ordered' && https(request.resource.data.poDocumentUrl) && request.resource.data.confirmedBy == request.auth.uid && prerequisite(projectId,'A.B.14')) ||
          (resource.data.status in ['ordered','partial'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receivedQty','status']) && integer(request.resource.data.receivedQty) && request.resource.data.receivedQty > resource.data.receivedQty && request.resource.data.receivedQty <= resource.data.quantity && request.resource.data.status in ['partial','received'])
        );
        allow delete: if false;
      }
      function validSales(data) {
        return base(projectId) && integer(data.quantity) && data.quantity > 0 && integer(data.reservedQty) && integer(data.shippedQty) && integer(data.cancelledQty) && data.reservedQty + data.shippedQty + data.cancelledQty <= data.quantity && data.status in ['draft','reserved','partial','shipped','cancelled'] && text(data.customer,200) && text(data.platform,100);
      }
      match /salesOrders/{id} {
        allow read: if projectReader(projectId);
        allow create: if admin() && validSales(request.resource.data) && ((request.resource.data.status == 'draft' && request.resource.data.reservedQty == 0 && request.resource.data.shippedQty == 0 && request.resource.data.cancelledQty == 0) || recovery()) && existsAfter(/databases/$(database)/documents/projects/$(projectId)/products/$(request.resource.data.productId));
        allow update: if admin() && validSales(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reservedQty','shippedQty','cancelledQty','updatedAt']) && request.resource.data.shippedQty >= resource.data.shippedQty && request.resource.data.cancelledQty >= resource.data.cancelledQty;
        allow delete: if false;
      }
      match /stock/{id} {
        allow read: if projectReader(projectId);
        allow create, update: if admin() && base(projectId) && request.resource.data.productId == id && integer(request.resource.data.physical) && integer(request.resource.data.reserved) && integer(request.resource.data.safetyStock) && request.resource.data.reserved <= request.resource.data.physical && existsAfter(/databases/$(database)/documents/projects/$(projectId)/products/$(id));
        allow delete: if false;
      }
      match /shipmentRecords/{id} {
        allow read: if projectReader(projectId);
        allow create: if admin() && base(projectId) && text(request.resource.data.tracking,200) && text(request.resource.data.carrier,200) && https(request.resource.data.labelUrl) && https(request.resource.data.proofUrl) && integer(request.resource.data.quantity) && request.resource.data.quantity > 0 && ((request.resource.data.status == 'in_transit' && request.resource.data.platformSync == 'manual_pending') || recovery()) && existsAfter(/databases/$(database)/documents/projects/$(projectId)/salesOrders/$(request.resource.data.orderId));
        allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','deliveredAt','platformSync','syncConfirmedBy','syncConfirmedAt']) && request.resource.data.status in ['in_transit','delivered'] && request.resource.data.platformSync in ['manual_pending','manual_confirmed'];
        allow delete: if false;
      }
      match /{name}/{id} {
        allow read: if name in ['manufacturers','market_insights'] && (projectReader(projectId) || (assigned(projectId) && profile().role == 'freelancer'));
        allow create, update: if name in ['manufacturers','market_insights'] && admin() && request.resource.data.size() <= 80;
        allow delete: if name in ['manufacturers','market_insights'] && admin();
      }
    }
    match /leads/{id} {
      allow read: if admin() || (active() && own(resource.data) && assigned(resource.data.projectId));
      allow create: if request.resource.data.size() <= 80 && text(request.resource.data.projectId,100) && text(request.resource.data.companyName,200) && (admin() || (active() && profile().role == 'freelancer' && assigned(request.resource.data.projectId) && request.resource.data.assignedTo == request.auth.uid && request.resource.data.userId == request.auth.uid));
      allow update: if sameProject() && request.resource.data.size() <= 80 && (admin() || (active() && own(resource.data) && assigned(resource.data.projectId) && request.resource.data.get('assignedTo','') == resource.data.get('assignedTo','') && request.resource.data.get('userId','') == resource.data.get('userId','')));
      allow delete: if admin() || (active() && own(resource.data) && assigned(resource.data.projectId));
    }
    // Admin-only supplier directory grouped by sector; sectors are archived, never deleted.
    match /sectors/{id} {
      allow read: if admin();
      allow create, update: if admin() && request.resource.data.size() <= 10 && text(request.resource.data.name,100) && request.resource.data.get('archived',false) is bool;
      allow delete: if false;
    }
    match /directoryCompanies/{id} {
      allow read, delete: if admin();
      allow create, update: if admin() && request.resource.data.size() <= 30 && text(request.resource.data.name,250) && text(request.resource.data.sectorId,100) && request.resource.data.get('contacts',[]) is list && request.resource.data.get('contacts',[]).size() <= 50;
    }
    match /driveFiles/{id} {
      allow read: if projectReader(resource.data.projectId) || (active() && own(resource.data) && assigned(resource.data.projectId));
      allow create: if request.resource.data.size() <= 20 && text(request.resource.data.projectId,100) && text(request.resource.data.fileName,250) && https(request.resource.data.downloadUrl) && (admin() || (active() && own(request.resource.data) && assigned(request.resource.data.projectId)));
      allow update: if admin() && sameProject() && request.resource.data.size() <= 20 && https(request.resource.data.downloadUrl);
      allow delete: if admin() || (active() && own(resource.data) && assigned(resource.data.projectId));
    }
    match /{name}/{id} {
      allow read: if name in ['targetSpecs','rfqs','valueChain','rfqMatrix','recipes','suppliers','shipments','inventory','fulfillmentOrders'] && projectReader(resource.data.projectId);
      allow create: if name in ['targetSpecs','rfqs','valueChain','rfqMatrix','recipes','suppliers','shipments','inventory','fulfillmentOrders'] && admin() && text(request.resource.data.projectId,100) && request.resource.data.size() <= 80;
      allow update: if name in ['targetSpecs','rfqs','valueChain','rfqMatrix','recipes','suppliers','shipments','inventory','fulfillmentOrders'] && admin() && sameProject() && request.resource.data.size() <= 80;
      allow delete: if false;
    }
  }
}
